# ─── Banco de dados ───────────────────────────────────────────────────────────
# A aplicação conecta como `app_user`: papel SEM BYPASSRLS, para que as políticas
# RLS valham também para o backend (MOD-IDENT-07).
DATABASE_URL="postgresql://app_user:app_user@localhost:5432/petshop?schema=public"
# Migrations rodam como owner — só o owner pode criar papéis, políticas e triggers.
DATABASE_MIGRATION_URL="postgresql://postgres:postgres@localhost:5432/petshop?schema=public"
# Jobs cross-tenant usam `app_maintenance` (BYPASSRLS). Jamais usar na API.
DATABASE_MAINTENANCE_URL="postgresql://app_maintenance:app_maintenance@localhost:5432/petshop?schema=public"

# ─── Infraestrutura ───────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://petshop:petshop@localhost:5672"

# ─── Criptografia de PII (PRD §4) ─────────────────────────────────────────────
# KEK mestra em base64 (32 bytes). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Em produção vem do secret manager, nunca do arquivo.
ENCRYPTION_KEK="CHANGE_ME_base64_32_bytes"
# Pepper global do HMAC-SHA256 usado nas colunas `*_hash` de busca.
EMAIL_HASH_PEPPER="CHANGE_ME_random_string"

# ─── Clerk (ver docs/setup-clerk.md) ──────────────────────────────────────────
CLERK_SECRET_KEY="sk_test_..."
# Placeholder com formato válido, só para o build rodar sem credenciais.
# SUBSTITUA pela chave real da sua instância antes de usar o login.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_ZXhhbXBsZS5jbGVyay5hY2NvdW50cy5kZXYk"
# Origens autorizadas a apresentar tokens desta instância.
CLERK_AUTHORIZED_PARTIES="http://localhost:3002"
# Assinatura do webhook de sincronização (MOD-IDENT-03): mantém nome, foto e e-mail do
# espelho local em dia com o Clerk. Sai do painel, ao criar o endpoint, no formato
# `whsec_…` — não é a CLERK_SECRET_KEY. **Sem ele a rota recusa tudo com 401.** O
# endpoint é `POST /internal/v1/clerk/webhook` no domínio da aplicação.
CLERK_WEBHOOK_SECRET="whsec_CHANGE_ME"
# O app serve as próprias telas de login em /sign-in e /sign-up; sem estas
# variáveis o Clerk redireciona para o domínio hospedado dele.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ─── Comunicação interna entre serviços ───────────────────────────────────────
# HMAC com que um serviço assinava o contexto já resolvido ao chamar outro.
#
# **Sem leitor desde a fatia 11 da consolidação**, quando o último serviço virou módulo:
# não há mais quem assine nem quem verifique. Continua exigida na subida porque é o
# contrato de quem voltar a ser processo separado um dia — e porque um segredo que some
# do `.env` some também do cofre, e volta como incidente.
INTERNAL_SERVICE_SECRET="CHANGE_ME_random_string"

# ─── Portas (SPEC §2) ─────────────────────────────────────────────────────────
# Uma só: o backend inteiro é um processo, e o Next é o outro.
GATEWAY_PORT=3000


# MOD-TUTOR — consulta de CEP (questão 2 do PRD §11: ViaCEP gratuito).
VIACEP_BASE_URL="https://viacep.com.br/ws"
CEP_LOOKUP_TIMEOUT_MS=3000
# Questão 1 do PRD §11: dias sem atendimento para a tag automática INATIVO.
INACTIVITY_THRESHOLD_DAYS=90
FRONTEND_PORT=3002
NEXT_PUBLIC_API_URL="http://localhost:3000"

# NODE_ENV fica de fora de propósito: o Next define o seu no build, e os
# serviços já assumem "development" por padrão. Fixá-lo aqui quebraria o build.
LOG_LEVEL="info"

# ─── MOD-PET-04 — storage de mídia (Cloudflare R2, API S3) ────────────────────
# Questão 2 do PRD pets_03 §11 decidida em favor do R2: object storage puro, com as
# variantes geradas por nós no upload e URL de leitura assinada por 15 minutos.
# As chaves são de conta e NUNCA vão para o repositório — copie para o seu .env.
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="petshop-media"
# R2 ignora região, mas o assinador SigV4 do SDK exige uma.
R2_REGION="auto"

# ─── MOD-IDENT-06 — convite de equipe por e-mail (Resend) ─────────────────────
# Sem a chave, o convite continua sendo criado e o link volta na resposta da API,
# para o admin entregar à mão. É o modo de desenvolvimento.
RESEND_API_KEY="re_CHANGE_ME"
# O retorno do provedor (MOD-NOTIF-10): bounce e reclamação de spam. Sai do painel do
# Resend, no formato `whsec_…`. **Sem ele a rota do webhook recusa tudo com 401** — e é
# deliberado: um webhook aberto é uma porta para suprimir o endereço de qualquer
# concorrente. O endpoint é `POST /internal/v1/email/webhook` no domínio da aplicação.
RESEND_WEBHOOK_SECRET="whsec_CHANGE_ME"
# Precisa ser de um domínio verificado no Resend, senão a API recusa o envio.
MAIL_FROM="PetShop AI <convites@SEU-DOMINIO-VERIFICADO>"
# Base pública do frontend: é com ela que se monta o link `/convite/<token>`.
APP_URL="http://localhost:3002"
INVITATION_TTL_DAYS=7

# ── Assinatura (Asaas) ────────────────────────────────────────────────────────
# Camada comercial, fatia 4. Sem ASAAS_API_KEY a tela de assinatura abre, mas não cobra
# (o POST responde 503). ASAAS_API_URL começa no SANDBOX de propósito: produção é
# https://api.asaas.com/v3, trocada junto com a chave de produção.
# ASAAS_WEBHOOK_TOKEN é o token cadastrado no painel do Asaas para o webhook
# `POST /internal/v1/asaas/webhook`; sem ele a rota recusa tudo com 401.
#
# ATENÇÃO: a chave do Asaas começa com `$` (`$aact_...`). Escreva com barra antes do
# cifrão — ASAAS_API_KEY="\$aact_..." —, senão o `$aact_...` é lido como referência a
# uma variável que não existe e a chave chega VAZIA (a tela diz "cobrança não
# configurada"). A forma com barra vale para o dotenv do `pnpm dev`, para o
# `docker compose` e para o `conferir-ambiente.sh`.
ASAAS_API_KEY=""
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
ASAAS_WEBHOOK_TOKEN=""
BILLING_GRACE_DAYS=7

# ─── MOD-SEC — segurança e compliance (Fase 7) ────────────────────────────────
# Dias que o administrador tem para ligar o segundo fator antes de perder a escrita.
# Só afeta prazo **novo**: o valor é gravado em `memberships.mfa_grace_until` quando o
# papel é atribuído, então mudá-lo não move o prazo de quem já o recebeu.
MFA_GRACE_DAYS=7
# Retenção da trilha de auditoria e dos eventos de segurança. O expurgo apaga a linha.
AUDIT_RETENTION_MONTHS=24
AUDIT_RETENTION_BATCH=5000
AUDIT_RETENTION_MAX_MS=300000
# Teto do balde de `/internal/`. Mais folgado que o do Admin: provedor legítimo entrega
# em rajada, e a Evolution empurra um QR novo a cada ~45s durante o pareamento.
WEBHOOK_RATE_LIMIT_MAX=600

# ─── Banco de testes (SPEC §10) ───────────────────────────────────────────────
TEST_DATABASE_URL="postgresql://app_user:app_user@localhost:5432/petshop_test?schema=public"
TEST_DATABASE_MIGRATION_URL="postgresql://postgres:postgres@localhost:5432/petshop_test?schema=public"
TEST_DATABASE_MAINTENANCE_URL="postgresql://app_maintenance:app_maintenance@localhost:5432/petshop_test?schema=public"

# MOD-LEDGER — conta corrente do tutor. Estavam só nos defaults do código; ficam
# aqui porque a composição de produção precisa nomeá-las explicitamente.

# ─── MOD-LEDGER-08 — geração de PDF (Gotenberg) ───
# Opcional: sem ela o pagamento é registrado normalmente e o recibo fica pendente,
# esperando o job `ledger.retry-receipts`.
GOTENBERG_URL="http://localhost:3030"

# ─── Agendador de jobs ───
# `true` desliga a grade (o padrão da suíte de testes).
DISABLE_JOBS=false

# MOD-CRM — relacionamento (módulo do backend; decidir e entregar no mesmo processo)

# Domínio da instalação. As telas exibem `{slug}.{APP_DOMAIN}` como endereço do
# tenant: o site do petshop na raiz, e o Portal do Tutor em /portal.
APP_DOMAIN="localhost:3002"

# ─── MOD-SITE — o site do estabelecimento ───

# Como o serviço alcança o Next para invalidar a página de um tenant quando o horário
# ou o catálogo mudam. Em produção é o nome do container na rede interna.
FRONTEND_INTERNAL_URL="http://localhost:3002"
# Não protege dado — a página é pública. Protege custo: sem ele, qualquer um na rede
# força re-render de todos os sites em laço. Troque em produção.
SITE_REVALIDATE_SECRET="dev-site-revalidate-secret"

# ─── MOD-ADMIN — administração da plataforma ───
# O primeiro administrador de plataforma, e **só** enquanto não houver nenhum. Sem esta
# variável a tabela nasce vazia e `/platform/v1` fica inalcançável — que é o estado
# correto em produção: semear por psql deixa rastro no acesso ao banco.
PLATFORM_ADMIN_BOOTSTRAP_EMAIL="moraes.mario@gmail.com"
# Teto do prazo que o estabelecimento pode conceder ao suporte. Ele escolhe quantas horas
# dar; o servidor recusa acima disto. 72h cobre o chamado que atravessa um fim de semana.
SUPPORT_GRANT_MAX_HOURS=72

# MOD-ADMIN-06 — destino do alarme operacional, separado por vírgula.
# Vazio: os administradores de plataforma ativos recebem.
PLATFORM_ALERT_EMAILS=""

# ─── MOD-PORTAL — o Portal do Tutor ───

# Em desenvolvimento não há subdomínio — `localhost:3002` é sempre Admin —, então o
# Portal não teria de que petshop falar. Esta variável diz qual tenant abrir em
# `/portal` na máquina de quem desenvolve; em produção o slug sai do host e ela não
# existe. Vazia, `/portal` responde "estabelecimento não encontrado".
PORTAL_DEV_SLUG=""

# MOD-PORTAL-07 — o leva-e-traz pedido junto do agendamento. O BFF cota e pede a corrida
# no módulo do Taxi Dog, dentro do backend; sem ele no ar, a oferta some da tela e o
# agendamento segue normal.

# ─── MOD-CRM-01 — o canal WhatsApp (Evolution API) ───
# A Evolution sobe com o `pnpm infra:up`, ao lado do Gotenberg, e NÃO é publicada em
# produção: quem fala com ela é só o backend, pela rede interna.
#
# Sem `EVOLUTION_API_URL` o canal fica indisponível e a cascata `AUTO` cai para o
# e-mail — que é exatamente o comportamento de antes desta fatia, e o que permite
# rodar a suíte e o app sem a Evolution no ar.
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="dev-evolution-api-key"

# Para onde a Evolution devolve o pareamento e as quedas de conexão. Em
# desenvolvimento ela é container e o backend roda no host, daí o
# `host.docker.internal`; em produção os dois são containers na mesma rede e o
# endereço é `http://api-gateway:3000/...`.
EVOLUTION_WEBHOOK_URL="http://host.docker.internal:3000/internal/v1/whatsapp/webhook"

# ─── MOD-AI — o agente de atendimento no WhatsApp ─────────────────────────────
# A chave do provedor do modelo (Anthropic). **Opcional, e a ausência é um estado
# legítimo**: sem ela o agente se comporta como desligado e toda mensagem recebida vai
# para a fila da recepção — que é o AC-02 de MOD-AI-07, e não um modo degradado.
#
# O modelo é o `claude-opus-5`, e o custo por turno é dominado pelo prefixo em cache.
# O teto de gasto mensal é por estabelecimento, na tela de Atendimentos.
ANTHROPIC_API_KEY=""

# Qual provedor atende o agente: `anthropic` (padrão, alvo de produção) ou `gemini`.
# O Gemini existe para DESENVOLVIMENTO — o free tier do Google AI Studio deixa exercitar
# o agente ponta a ponta (tools, proposta em duas etapas, confirmação, handoff) sem conta
# paga. Os dois implementam a mesma porta; nada acima dela sabe qual está atendendo.
#
# Duas coisas que a troca custa, e que não aparecem como erro:
#  - não há prefixo em cache a pedido, então cada turno reenvia o prompt inteiro;
#  - a saída estruturada vira instrução no prompt, porque o Gemini não a combina com
#    chamada de função.
AI_PROVIDER=anthropic

# A chave do Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# O free tier tem cota por minuto, e é ela que decide este padrão — não a qualidade.
# Um modelo maior faz o segundo cliente do dia levar 429, que o runner lê como provedor
# fora do ar e manda a conversa para a recepção.
GEMINI_MODEL="gemini-3.5-flash-lite"

# A retenção do §9: 24 meses de conversa, e o que sai é o dado pessoal — o corpo do
# turno, o argumento da tool e o vínculo com o tutor. A linha FICA, porque ela também é
# a estatística do painel de qualidade. O job é `agent.retention`, às 03h50.
#
# A mesma varredura atende o art. 18: a conversa de um titular anonimizado é esvaziada no
# dia seguinte, sem esperar os 24 meses.
AGENT_RETENTION_MONTHS=24
AGENT_RETENTION_BATCH=200
AGENT_RETENTION_MAX_MS=300000
