{
  "name": "@petshop/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "start": "node --conditions=petshop-dist dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@clerk/backend": "^2.17.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.3.0",
    "@google/genai": "^2.22.0",
    "@petshop/db": "workspace:*",
    "@petshop/documents": "workspace:*",
    "@petshop/job-scheduler": "workspace:*",
    "@petshop/pdf": "workspace:*",
    "@petshop/service-auth": "workspace:*",
    "@petshop/service-kit": "workspace:*",
    "@petshop/shared-types": "workspace:*",
    "amqplib": "^0.10.9",
    "fastify": "^5.4.0",
    "ioredis": "^5.7.0",
    "pino": "^9.7.0",
    "sharp": "^0.35.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@petshop/config": "workspace:*",
    "@types/amqplib": "^0.10.7",
    "dotenv": "^17.2.1",
    "dotenv-cli": "^8.0.0",
    "pino-pretty": "^13.0.0"
  }
