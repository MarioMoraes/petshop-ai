{
  "name": "@petshop/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "petshop-dist": "./dist/src/index.js",
      "default": "./src/index.ts"
    },
    "./tenant-middleware": {
      "petshop-dist": "./dist/src/tenant-middleware.js",
      "default": "./src/tenant-middleware.ts"
    },
    "./crypto": {
      "petshop-dist": "./dist/src/crypto.js",
      "default": "./src/crypto.ts"
    },
    "./testing": {
      "petshop-dist": "./dist/src/testing.js",
      "default": "./src/testing.ts"
    },
    "./seed-rbac": {
      "petshop-dist": "./dist/src/seed-rbac.js",
      "default": "./src/seed-rbac.ts"
    },
    "./seed-catalog": {
      "petshop-dist": "./dist/src/seed-catalog.js",
      "default": "./src/seed-catalog.ts"
    }
  },
  "imports": {
    "#prisma-client": "./generated/client/index.js"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@petshop/shared-types": "workspace:*",
    "@prisma/client": "^6.14.0"
  },
  "devDependencies": {
    "@petshop/config": "workspace:*",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.14.0",
    "dotenv": "^17.2.1"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
