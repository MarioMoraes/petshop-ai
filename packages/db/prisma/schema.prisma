// PetShop AI — Núcleo de Identidade e Tenancy (MOD-IDENT).
//
// A aplicação conecta como `app_user`, papel SEM BYPASSRLS: as políticas RLS de
// `migrations/*_rls_policies` valem também para o backend (MOD-IDENT-07).
// Migrations rodam pelo `directUrl`, como owner.
//
// Objetos que o Prisma não sabe declarar — políticas RLS, triggers, papéis do
// Postgres e índices únicos parciais — vivem em SQL escrito à mão nas migrations.
// Ver `prisma/migrations/README.md` antes de rodar `prisma migrate dev`.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_MIGRATION_URL")
}

enum TenantStatus {
  PROVISIONING
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  TERMINATED
  PROVISIONING_FAILED
}

enum Plan {
  STARTER
  PRO
  ENTERPRISE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AuditOutcome {
  ALLOWED
  DENIED
}

enum WhatsappProvisioning {
  OWN_NUMBER
}

enum SecurityEventType {
  CROSS_TENANT_ATTEMPT
  PERMISSION_DENIED
  TENANT_CONTEXT_MISSING
  WEBHOOK_SIGNATURE_INVALID
  LOGIN_FAILED
}

/// Um petshop. Raiz do isolamento multi-tenant.
model Tenant {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug String @unique @db.VarChar(50)
  name String @db.VarChar(120)

  legalName     String? @map("legal_name") @db.VarChar(160)
  /// CNPJ cifrado em AES-256-GCM, formato `v1:<iv>:<tag>:<ct>` (PRD §4).
  cnpjEncrypted String? @map("cnpj_encrypted")

  /// Organization correspondente no Clerk. Nulo apenas enquanto `status = PROVISIONING`:
  /// o tenant é criado localmente antes da chamada ao Clerk, para que a falha dessa
  /// chamada seja recuperável pelo job de retry (AC-03 de MOD-IDENT-01).
  clerkOrgId String? @unique @map("clerk_org_id")

  status TenantStatus @default(PROVISIONING)
  plan   Plan         @default(STARTER)

  trialEndsAt DateTime? @map("trial_ends_at") @db.Timestamptz(6)

  onboardingStep         Int       @default(1) @map("onboarding_step") @db.SmallInt
  onboardingCompletedAt  DateTime? @map("onboarding_completed_at") @db.Timestamptz(6)
  onboardingStartedAt    DateTime  @default(now()) @map("onboarding_started_at") @db.Timestamptz(6)
  /// Etapas puladas pelo admin (AC-03 de MOD-IDENT-02); vai no payload de
  /// `tenant.onboarding.concluido`.
  onboardingStepsSkipped Int[]     @default([]) @map("onboarding_steps_skipped")

  /// Chave de idempotência do provisionamento (AC-03 de MOD-IDENT-01).
  provisioningKey       String  @unique @map("provisioning_key")
  provisioningAttempts  Int     @default(0) @map("provisioning_attempts") @db.SmallInt
  provisioningLastError String? @map("provisioning_last_error")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  settings      TenantSettings?
  memberships   Membership[]
  invitations   Invitation[]
  roleOverrides TenantRoleOverride[]
  dataKey       DataKey?

  @@index([status])
  @@map("tenants")
}

/// Configurações operacionais e identidade visual (MOD-IDENT-08).
model TenantSettings {
  tenantId String @id @map("tenant_id") @db.Uuid

  timezone String @default("America/Sao_Paulo")

  /// Decisão de negócio: 24 horas de antecedência para cancelamento sem no-show.
  cancellationWindowHours Int @default(24) @map("cancellation_window_hours") @db.SmallInt
  noShowFeePercent        Int @default(0) @map("no_show_fee_percent") @db.SmallInt
  minBookingNoticeHours   Int @default(2) @map("min_booking_notice_hours") @db.SmallInt

  allowOverbooking     Boolean @default(false) @map("allow_overbooking")
  onlineBookingEnabled Boolean @default(true) @map("online_booking_enabled")

  /// `{ logoUrl, primaryColor, secondaryColor }`
  branding      Json
  /// Grade semanal: `{ monday: { closed, opensAt, closesAt }, ... }`
  businessHours Json @map("business_hours")

  /// Decisão de negócio: cada tenant conecta o próprio número via BSP oficial.
  whatsappProvisioning WhatsappProvisioning @default(OWN_NUMBER) @map("whatsapp_provisioning")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

/// Espelho local do usuário do Clerk. Tabela GLOBAL: um usuário pode pertencer a
/// N tenants (RN-01), então não tem `tenant_id` e não tem RLS.
model User {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId String @unique @map("clerk_user_id")

  /// PII cifrada. A busca usa `emailHash`, nunca LIKE sobre o texto cifrado.
  emailEncrypted String  @map("email_encrypted")
  emailHash      String  @unique @map("email_hash")
  fullName       String  @map("full_name") @db.VarChar(120)
  phoneEncrypted String? @map("phone_encrypted")
  avatarUrl      String? @map("avatar_url")

  mfaEnabled Boolean    @default(false) @map("mfa_enabled")
  status     UserStatus @default(ACTIVE)

  /// RN-09: só aplica webhook do Clerk cujo `updated_at` seja posterior a este valor.
  clerkSyncedAt DateTime? @map("clerk_synced_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships Membership[]

  @@map("users")
}

/// Vínculo usuário ↔ tenant com papel (MOD-IDENT-05).
model Membership {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  roleKey  String @map("role_key")

  status         MembershipStatus @default(ACTIVE)
  /// RN-06: papéis operacionais têm espelho em `professionals` (MOD-AGENDA).
  isProfessional Boolean          @default(false) @map("is_professional")

  /// RN-03: incrementa a cada troca de papel. O gateway compara com o claim
  /// `permVersion` do token e força refresh na divergência.
  permVersion Int @default(1) @map("perm_version")

  invitedBy String?  @map("invited_by") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleKey], references: [key])

  @@index([userId])
  @@index([tenantId, roleKey])
  @@map("memberships")
}

/// Papéis de sistema. Global, sem `tenant_id` — o tenant ajusta permissões via
/// `TenantRoleOverride`, não criando papéis próprios (questão 2 do PRD §11).
model Role {
  key      String  @id
  label    String
  isSystem Boolean @default(true) @map("is_system")

  permissions RolePermission[]
  memberships Membership[]

  @@map("roles")
}

/// Permissão granular no formato `recurso:acao`.
model Permission {
  key         String @id
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleKey       String @map("role_key")
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleKey], references: [key], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleKey, permissionKey])
  @@map("role_permissions")
}

/// Ajuste da matriz padrão por tenant: `granted = false` revoga, `true` concede.
model TenantRoleOverride {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  roleKey       String  @map("role_key")
  permissionKey String  @map("permission_key")
  granted       Boolean

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleKey, permissionKey])
  @@map("tenant_role_overrides")
}

/// MOD-IDENT-06 — tabela criada nesta fase para fixar o modelo e a política RLS.
/// Os endpoints de convite ainda não existem.
model Invitation {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  emailEncrypted String @map("email_encrypted")
  emailHash      String @map("email_hash")
  roleKey        String @map("role_key")

  /// SHA-256 do token; o token cru nunca é persistido.
  tokenHash String           @map("token_hash")
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)

  invitedBy  String?   @map("invited_by") @db.Uuid
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

/// MOD-IDENT-09 — append-only. `UPDATE` e `DELETE` são bloqueados por trigger
/// e por REVOKE na migration de RLS.
model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Nulo em ações de plataforma — visíveis apenas pela role `app_maintenance`.
  tenantId    String? @map("tenant_id") @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid

  action   String
  entity   String
  entityId String?      @map("entity_id")
  before   Json?
  after    Json?
  outcome  AuditOutcome @default(ALLOWED)

  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([entity, entityId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Eventos de segurança (MOD-SEC). Criado aqui porque MOD-IDENT-07 AC-02 exige
/// registrar `CROSS_TENANT_ATTEMPT`.
model SecurityEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId    String?           @map("tenant_id") @db.Uuid
  type        SecurityEventType
  actorUserId String?           @map("actor_user_id") @db.Uuid

  targetEntity String? @map("target_entity")
  targetId     String? @map("target_id")

  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")
  metadata  Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@map("security_events")
}

/// DEK por tenant, cifrada pela KEK mestra (envelope encryption, PRD §4).
/// A chave de plataforma — usada por `users`, que é tabela global — não fica aqui:
/// é derivada da KEK por HKDF, ver `src/crypto.ts`.
model DataKey {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  /// DEK cifrada pela KEK, no mesmo formato `v1:<iv>:<tag>:<ct>`.
  encryptedDek String @map("encrypted_dek")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("data_keys")
}

// ═══════════════════════════════════════════════════════════════════════════
// MOD-TUTOR — Cadastro e gestão de tutores (PRD tutores_02 §4)
// ═══════════════════════════════════════════════════════════════════════════

enum PersonType {
  PF
  PJ
}

enum TutorStatus {
  ACTIVE
  INACTIVE
  /// Terminal: origem de um merge, aponta `merged_into_id`.
  MERGED
  /// Terminal e irreversível: pedido do titular (LGPD art. 18).
  ANONYMIZED
}

enum DataCompleteness {
  COMPLETE
  PARTIAL
}

enum ConsentChannel {
  WHATSAPP
  EMAIL
  SMS
  TERMS
  IMAGE_USE
}

enum ConsentPurpose {
  TRANSACTIONAL
  MARKETING
  BOTH
}

enum ConsentSource {
  STAFF_FORM
  PORTAL
  SITE
  WHATSAPP
  IMPORT
}

/// O cliente pagante e titular dos dados pessoais.
///
/// CPF, CNPJ, telefones e e-mail ficam cifrados com a DEK do tenant; as colunas
/// `*_hash` (HMAC-SHA256 com pepper) é que sustentam unicidade e busca exata —
/// `LIKE` sobre texto cifrado não existe. `full_name` fica em claro, decisão
/// consciente do PRD §4 para viabilizar a busca por similaridade no balcão.
model Tutor {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  personType PersonType @default(PF) @map("person_type")

  fullName   String  @map("full_name") @db.VarChar(160)
  /// Razão social (PJ).
  legalName  String? @map("legal_name") @db.VarChar(160)
  /// RN-14: quando preenchido, é o nome exibido em telas e comunicações.
  socialName String? @map("social_name") @db.VarChar(120)

  cpfEncrypted  String? @map("cpf_encrypted")
  cpfHash       String? @map("cpf_hash")
  cnpjEncrypted String? @map("cnpj_encrypted")
  cnpjHash      String? @map("cnpj_hash")

  /// E.164. Obrigatório: é o canal primário e a chave do agente de IA (RN-03).
  phoneEncrypted    String  @map("phone_encrypted")
  phoneHash         String  @map("phone_hash")
  phoneAltEncrypted String? @map("phone_alt_encrypted")
  phoneAltHash      String? @map("phone_alt_hash")

  emailEncrypted String? @map("email_encrypted")
  emailHash      String? @map("email_hash")

  birthDate DateTime? @map("birth_date") @db.Date
  notes     String?

  status           TutorStatus      @default(ACTIVE)
  dataCompleteness DataCompleteness @default(PARTIAL) @map("data_completeness")

  /// RN-13 — vínculo com o login do Portal (MOD-PORTAL).
  portalUserId String? @map("portal_user_id") @db.Uuid
  /// Destino do merge, quando `status = MERGED`.
  mergedIntoId String? @map("merged_into_id") @db.Uuid

  /// Mantido pelo trigger `tutors_search_trigger`; a aplicação nunca escreve aqui.
  searchVector Unsupported("tsvector")? @map("search_vector")

  /// RN-10: escrito pelo consumo de `atendimento.concluido`, nunca calculado na
  /// listagem. Alimenta a tag automática INATIVO.
  lastAttendanceAt DateTime? @map("last_attendance_at") @db.Timestamptz(6)

  /// Denormalizados pelo mesmo motivo do RN-10: a listagem de balcão tem SLO de
  /// 300ms e não pode agregar outros serviços por linha.
  /// TODO(MOD-LEDGER): alimentar por `lancamento.criado`.
  balanceCents Int @default(0) @map("balance_cents")
  /// TODO(MOD-PET): alimentar por `pet.criado` / `pet.vinculado`.
  petsCount    Int @default(0) @map("pets_count")

  anonymizedAt DateTime? @map("anonymized_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  addresses      TutorAddress[]
  consents       TutorConsent[]
  tagAssignments TutorTagAssignment[]

  petTutors  PetTutor[]

  mergedInto Tutor?  @relation("TutorMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom Tutor[] @relation("TutorMerge")

  @@map("tutors")
}

/// Um principal + N adicionais. Logradouro cifrado: endereço residencial é dado
/// sensível à segurança física do titular (PRD §4).
model TutorAddress {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tutorId  String @map("tutor_id") @db.Uuid

  label   String @default("Casa") @db.VarChar(40)
  zipCode String @map("zip_code") @db.VarChar(8)

  streetEncrypted     String  @map("street_encrypted")
  numberEncrypted     String  @map("number_encrypted")
  complementEncrypted String? @map("complement_encrypted")

  district String @db.VarChar(80)
  city     String @db.VarChar(80)
  state    String @db.VarChar(2)

  /// Geocodificação para a roteirização do Taxi Dog (MOD-TAXI).
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  /// "Portão azul, chamar no interfone 12".
  accessNotes String? @map("access_notes")

  /// RN-15: exatamente um por tutor, garantido por índice único parcial.
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@map("tutor_addresses")
}

/// Tag de segmentação. `is_system = true` são mantidas por evento, nunca à mão.
model TutorTag {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  key      String  @db.VarChar(40)
  label    String  @db.VarChar(60)
  color    String  @default("#E34A32") @db.VarChar(9)
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignments TutorTagAssignment[]

  @@map("tutor_tags")
}

model TutorTagAssignment {
  tenantId String @map("tenant_id") @db.Uuid
  tutorId  String @map("tutor_id") @db.Uuid
  tagId    String @map("tag_id") @db.Uuid

  /// Nulo quando a atribuição foi automática.
  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  tutor Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  tag   TutorTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tutorId, tagId])
  @@index([tagId])
  @@map("tutor_tag_assignments")
}

/// RN-05 — append-only. Revogar nunca apaga o opt-in anterior: o histórico é a
/// prova do tenant perante a ANPD. `UPDATE`/`DELETE` barrados por trigger.
model TutorConsent {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tutorId  String @map("tutor_id") @db.Uuid

  channel ConsentChannel
  granted Boolean
  purpose ConsentPurpose @default(MARKETING)
  /// Versão do termo aceito nesta transição.
  version String         @db.VarChar(20)
  source  ConsentSource  @default(STAFF_FORM)

  /// Prova do consentimento (PRD §4).
  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@map("tutor_consents")
}

/// Snapshot pré-merge dos dois cadastros. Guardado porque o merge não é reversível
/// automaticamente (questão 5 do PRD §11) — é o que permite reverter à mão.
model TutorMergeLog {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  sourceId String @map("source_id") @db.Uuid
  targetId String @map("target_id") @db.Uuid

  snapshot      Json
  /// `{ pets: [...], ledgerEntries: [...], appointments: [...] }`
  movedEntities Json @map("moved_entities")

  performedBy String?  @map("performed_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("tutor_merge_log")
}

// ═══════════════════════════════════════════════════════════════════════════
// MOD-PET — Cadastro de pets e tabelas de domínio (PRD pets_03 §4)
// ═══════════════════════════════════════════════════════════════════════════

enum PetSex {
  MALE
  FEMALE
  UNKNOWN
}

enum PetStatus {
  ACTIVE
  INACTIVE
  DECEASED
  /// Terminal no tenant de origem.
  TRANSFERRED_OUT
}

/// AC-03 de MOD-PET-01: o pet resgatado entra com idade estimada, e a tela precisa
/// saber a diferença — "2 anos" e "≈ 2 anos" mudam a conduta clínica.
enum BirthDatePrecision {
  EXACT
  ESTIMATED
  UNKNOWN
}

/// Motivo da transferência de titularidade (MOD-PET-05). Não é campo livre: é o que
/// separa "adotado" de "erro de cadastro" no relatório e na conversa com o tutor.
enum TransferReason {
  ADOPTION
  SALE
  TUTOR_DEATH
  CORRECTION
  OTHER
}

/// De onde a foto veio. `GROOMING_RESULT` é a foto pós-tosa que o MOD-CRM manda ao
/// tutor; separá-la de uma foto qualquer do álbum é o que impede mandar a foto errada.
enum PhotoSource {
  STAFF
  TUTOR
  GROOMING_RESULT
}

enum PetTutorRole {
  PRIMARY
  SECONDARY
}

/// Espécie. `tenant_id` nulo é catálogo global, somente leitura para o tenant (RN-02).
model Species {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid

  key   String @db.VarChar(40)
  label String @db.VarChar(60)
  /// Não está no PRD: sem ele "Outros" apareceria no meio da lista, em ordem
  /// alfabética. A ordenação do seletor é decisão de produto, não do acaso.
  sortOrder Int     @default(0) @map("sort_order") @db.SmallInt
  active    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  breeds Breed[]
  pets   Pet[]

  @@map("species")
}

/// Raça. O catálogo global cobre o comum; o tenant acrescenta o que faltar.
model Breed {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String? @map("tenant_id") @db.Uuid
  speciesId String  @map("species_id") @db.Uuid

  label String @db.VarChar(80)
  /// Minúsculo e sem acento, para o dedupe do AC-03 de MOD-PET-03.
  normalizedLabel String @map("normalized_label") @db.VarChar(80)

  /// Sugestão de porte ao selecionar a raça; a recepção pode trocar.
  defaultSizeId String? @map("default_size_id") @db.Uuid
  groomingNotes String? @map("grooming_notes")
  active        Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  species     Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  defaultSize Size?   @relation(fields: [defaultSizeId], references: [id], onDelete: SetNull)
  pets        Pet[]
  visibility  BreedVisibility[]

  @@index([speciesId])
  @@map("breeds")
}

/// Porte. RN-03: insumo direto do preço e da duração do serviço.
model Size {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid

  key   String @db.VarChar(40)
  label String @db.VarChar(60)

  /// Faixa de referência do AC-04: fora dela o cadastro avisa, nunca bloqueia.
  weightMinKg Decimal @map("weight_min_kg") @db.Decimal(5, 2)
  weightMaxKg Decimal @map("weight_max_kg") @db.Decimal(5, 2)

  sortOrder Int     @default(0) @map("sort_order") @db.SmallInt
  active    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  pets   Pet[]
  breeds Breed[]

  @@map("sizes")
}

/// Pelagem. RN-03: `grooming_time_factor` multiplica a duração base do serviço.
model Coat {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid

  key   String @db.VarChar(40)
  label String @db.VarChar(60)

  groomingTimeFactor Decimal @default(1.00) @map("grooming_time_factor") @db.Decimal(3, 2)

  sortOrder Int     @default(0) @map("sort_order") @db.SmallInt
  active    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  pets Pet[]

  @@map("coats")
}

/// O paciente. A agenda é dele, o prontuário é dele, e o preço do banho depende do
/// porte e da pelagem dele.
///
/// `microchip` e `notes` ficam cifrados com a DEK do tenant (PRD §4). Como o
/// AES-GCM é não determinístico, a unicidade do microchip por tenant se apoia em
/// `microchip_hash` — mesmo par cifra/hash que o MOD-TUTOR usa para CPF e telefone.
model Pet {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name String @db.VarChar(60)

  speciesId String  @map("species_id") @db.Uuid
  /// Nulo é legítimo: "SRD" é raça do catálogo, mas nem todo cadastro sabe a raça.
  breedId   String? @map("breed_id") @db.Uuid
  sizeId    String  @map("size_id") @db.Uuid
  coatId    String? @map("coat_id") @db.Uuid

  sex PetSex @default(UNKNOWN)

  birthDate          DateTime?          @map("birth_date") @db.Date
  birthDatePrecision BirthDatePrecision @default(UNKNOWN) @map("birth_date_precision")

  /// RN-10: reflete sempre a pesagem mais recente; a série vive em `pet_weights`.
  weightKg Decimal? @map("weight_kg") @db.Decimal(5, 2)
  neutered Boolean?

  microchipEncrypted String? @map("microchip_encrypted")
  microchipHash      String? @map("microchip_hash")

  color String? @db.VarChar(40)

  /// FK "solta" de propósito: a capa é uma das linhas de `pet_photos`, e uma FK real
  /// criaria um ciclo (foto → pet → foto) que complica exclusão e seed. A consistência
  /// é garantida no serviço, que só grava id de foto viva do próprio pet.
  coverPhotoId String? @map("cover_photo_id") @db.Uuid

  status     PetStatus @default(ACTIVE)
  deceasedAt DateTime? @map("deceased_at") @db.Date
  /// AC-03 de MOD-PET-08 conta 30 dias a partir do **registro**, não da data do
  /// óbito: o tutor comunica dias depois, e a janela de correção é do lançamento.
  deceasedRecordedAt DateTime? @map("deceased_recorded_at") @db.Timestamptz(6)

  notesEncrypted String? @map("notes_encrypted")

  /// Mantido pelo trigger `pets_search_trigger`; a aplicação nunca escreve aqui.
  searchVector Unsupported("tsvector")? @map("search_vector")

  /// TODO(MOD-AGENDA): escrito pelo consumo de `atendimento.concluido`.
  lastAttendanceAt DateTime? @map("last_attendance_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  species Species @relation(fields: [speciesId], references: [id])
  breed   Breed?  @relation(fields: [breedId], references: [id])
  size    Size    @relation(fields: [sizeId], references: [id])
  coat    Coat?   @relation(fields: [coatId], references: [id])

  petTutors PetTutor[]
  weights   PetWeight[]
  transfers PetTransferLog[]
  photos    PetPhoto[]

  allergies     Allergy[]
  temperaments  Temperament[]
  medicalAlerts MedicalAlert[]

  @@map("pets")
}

/// Vínculo N:N com papel (MOD-PET-02). RN-04: exatamente um PRIMARY ativo por pet,
/// garantido por índice único parcial.
///
/// O vínculo é encerrado com `unlinked_at`, não apagado: quem autorizou um
/// procedimento ano passado precisa continuar rastreável depois da transferência.
model PetTutor {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  petId    String @map("pet_id") @db.Uuid
  tutorId  String @map("tutor_id") @db.Uuid

  role         PetTutorRole @default(SECONDARY)
  relationship String?      @db.VarChar(40)

  canAuthorizeProcedures Boolean @default(true) @map("can_authorize_procedures")

  linkedAt   DateTime  @default(now()) @map("linked_at") @db.Timestamptz(6)
  unlinkedAt DateTime? @map("unlinked_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  pet   Pet   @relation(fields: [petId], references: [id], onDelete: Cascade)
  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@map("pet_tutors")
}

/// Série de pesagens (MOD-PET-07). Base da dosagem clínica e do alerta do RN-11.
model PetWeight {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  petId    String @map("pet_id") @db.Uuid

  weightKg   Decimal  @map("weight_kg") @db.Decimal(5, 2)
  measuredAt DateTime @default(now()) @map("measured_at") @db.Timestamptz(6)

  /// TODO(MOD-AGENDA): pesagem aferida no check-in do atendimento.
  attendanceId String? @map("attendance_id") @db.Uuid
  measuredBy   String? @map("measured_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("pet_weights")
}

/// Álbum do pet (MOD-PET-04). O arquivo mora no R2; aqui ficam a referência, a
/// procedência e o que a LGPD exige saber sobre ele.
///
/// Não há URL pública: `variants` guarda **chaves de objeto**, e a URL é assinada na
/// leitura com validade de 15 minutos (RN-13). Guardar URL assinada no banco seria
/// guardar um dado que nasce vencido.
model PetPhoto {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  petId    String @map("pet_id") @db.Uuid

  /// `{ thumb, medium, full }` — chave de cada variante no bucket.
  variants Json

  caption String? @db.VarChar(140)
  takenAt DateTime @default(now()) @map("taken_at") @db.Timestamptz(6)
  source  PhotoSource @default(STAFF)

  /// TODO(MOD-AGENDA): foto de antes e depois presa ao atendimento.
  attendanceId String? @map("attendance_id") @db.Uuid

  /// RN-14: só vira material de campanha com o consentimento IMAGE_USE do tutor,
  /// conferido no momento da marcação — não no do upload.
  marketingUse Boolean @default(false) @map("marketing_use")

  sizeBytes Int    @map("size_bytes")
  mimeType  String @map("mime_type") @db.VarChar(40)

  uploadedBy String? @map("uploaded_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// O arquivo no bucket só some no `media-purge`; o soft delete tira da tela na hora.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("pet_photos")
}

// ─── MOD-PRONT — Prontuário clínico e comportamental ─────────────────────────

/// Severidade clínica, compartilhada por alergia e alerta médico. `CRITICAL` é o
/// único nível que bloqueia operação (RN-03 de prontuario_04); os demais avisam.
enum ClinicalSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AllergyType {
  FOOD
  PRODUCT
  MEDICATION
  ENVIRONMENTAL
  OTHER
}

/// Classificação comportamental (MOD-PRONT-04). `UNKNOWN` é honesto: o pet que
/// nunca foi atendido não é dócil, é desconhecido — e a equipe precisa da diferença.
enum TemperamentClassification {
  DOCILE
  ANXIOUS
  FEARFUL
  REACTIVE
  AGGRESSIVE
  UNKNOWN
}

/// Alergia e restrição (MOD-PRONT-03).
///
/// Nunca é apagada: a desativação preserva a linha com quem desativou e por quê
/// (AC-04). Uma alergia que "some" do histórico é uma informação de segurança que
/// desapareceu sem rastro — e é justamente essa que faz falta depois.
model Allergy {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  petId    String @map("pet_id") @db.Uuid

  type     AllergyType
  label    String           @db.VarChar(120)
  severity ClinicalSeverity

  /// Cifrada: detalhe clínico da reação observada (§4).
  reactionEncrypted String? @map("reaction_encrypted")

  /// Serviços que esta alergia bloqueia (RN-03). FK lógica para `services`, que
  /// vive no MOD-AGENDA — array em vez de tabela de junção porque a lista é curta
  /// e sempre lida junto com a alergia.
  blocksServices String[] @map("blocks_services") @db.Uuid
  /// Palavras-chave de produto ("shampoo neutro X"), casadas no check-out.
  blocksProducts String[] @map("blocks_products")

  diagnosedAt DateTime? @map("diagnosed_at") @db.Date
  diagnosedBy String?   @map("diagnosed_by") @db.Uuid

  active          Boolean   @default(true)
  resolutionNotes String?   @map("resolution_notes")
  deactivatedBy   String?   @map("deactivated_by") @db.Uuid
  deactivatedAt   DateTime? @map("deactivated_at") @db.Timestamptz(6)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("allergies")
}

/// Observação de temperamento (MOD-PRONT-04).
///
/// É série histórica, não campo do pet: RN-16 exige que o histórico de risco
/// sobreviva à melhora. `is_current` marca o vigente, e o índice parcial garante
/// que só exista um por pet.
model Temperament {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  petId    String @map("pet_id") @db.Uuid

  classification TemperamentClassification

  /// NAIL_TRIMMING, DRYER, MUZZLE, BATH, STRANGERS, OTHER_DOGS — em que situação.
  contexts String[]

  requiresMuzzle      Boolean @default(false) @map("requires_muzzle")
  requiresTwoHandlers Boolean @default(false) @map("requires_two_handlers")

  /// Cifrada. Obrigatória para REACTIVE e AGGRESSIVE (AC-02): "morde" sem contexto
  /// não diz à equipe o que evitar.
  notesEncrypted String? @map("notes_encrypted")

  observedBy String?  @map("observed_by") @db.Uuid
  observedAt DateTime @default(now()) @map("observed_at") @db.Timestamptz(6)

  isCurrent Boolean @default(true) @map("is_current")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("temperaments")
}

/// Condição médica ativa (MOD-PRONT-05): cardiopatia, epilepsia, idade avançada.
/// Diferente da alergia, não bloqueia serviço — instrui a execução ("não usar
/// secador quente").
model MedicalAlert {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  petId    String @map("pet_id") @db.Uuid

  condition String           @db.VarChar(120)
  severity  ClinicalSeverity

  /// Cifrada: instrução operacional que pode descrever quadro clínico.
  instructionsEncrypted String? @map("instructions_encrypted")

  active          Boolean   @default(true)
  resolutionNotes String?   @map("resolution_notes")
  deactivatedBy   String?   @map("deactivated_by") @db.Uuid
  deactivatedAt   DateTime? @map("deactivated_at") @db.Timestamptz(6)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("medical_alerts")
}

/// AC-02 de MOD-PET-03: o tenant não edita nem apaga raça global — esconde da lista
/// dele. A linha existir **é** o "escondido"; mostrar de volta é apagá-la.
model BreedVisibility {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  breedId  String @map("breed_id") @db.Uuid

  hiddenAt DateTime @default(now()) @map("hidden_at") @db.Timestamptz(6)
  hiddenBy String?  @map("hidden_by") @db.Uuid

  breed Breed @relation(fields: [breedId], references: [id], onDelete: Cascade)

  @@map("breed_visibility")
}

/// Histórico de titularidade (MOD-PET-05). RN-06: o prontuário nunca se move; o que
/// muda de dono é o cadastro, e esta tabela é a prova de quando e por quê.
model PetTransferLog {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  petId    String @map("pet_id") @db.Uuid

  /// Nulo só no caso improvável de transferência de pet sem responsável ativo —
  /// possível se um `tutor.anonimizado` desvinculou o último antes.
  fromTutorId String? @map("from_tutor_id") @db.Uuid
  toTutorId   String  @map("to_tutor_id") @db.Uuid

  reason TransferReason
  notes  String?

  /// A data que o tenant declara para o efeito; os vínculos mudam no commit.
  effectiveDate DateTime? @map("effective_date") @db.Date

  performedBy String?  @map("performed_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("pet_transfer_log")
}
