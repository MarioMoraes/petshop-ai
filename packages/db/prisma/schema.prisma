// PetShop AI — Núcleo de Identidade e Tenancy (MOD-IDENT).
//
// A aplicação conecta como `app_user`, papel SEM BYPASSRLS: as políticas RLS de
// `migrations/*_rls_policies` valem também para o backend (MOD-IDENT-07).
// Migrations rodam pelo `directUrl`, como owner.
//
// Objetos que o Prisma não sabe declarar — políticas RLS, triggers, papéis do
// Postgres e índices únicos parciais — vivem em SQL escrito à mão nas migrations.
// Ver `prisma/migrations/README.md` antes de rodar `prisma migrate dev`.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_MIGRATION_URL")
}

enum TenantStatus {
  PROVISIONING
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  TERMINATED
  PROVISIONING_FAILED
}

enum Plan {
  STARTER
  PRO
  ENTERPRISE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AuditOutcome {
  ALLOWED
  DENIED
}

enum WhatsappProvisioning {
  OWN_NUMBER
}

enum SecurityEventType {
  CROSS_TENANT_ATTEMPT
  PERMISSION_DENIED
  TENANT_CONTEXT_MISSING
  WEBHOOK_SIGNATURE_INVALID
  LOGIN_FAILED
}

/// Um petshop. Raiz do isolamento multi-tenant.
model Tenant {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug String @unique @db.VarChar(50)
  name String @db.VarChar(120)

  legalName     String? @map("legal_name") @db.VarChar(160)
  /// CNPJ cifrado em AES-256-GCM, formato `v1:<iv>:<tag>:<ct>` (PRD §4).
  cnpjEncrypted String? @map("cnpj_encrypted")

  /// Organization correspondente no Clerk. Nulo apenas enquanto `status = PROVISIONING`:
  /// o tenant é criado localmente antes da chamada ao Clerk, para que a falha dessa
  /// chamada seja recuperável pelo job de retry (AC-03 de MOD-IDENT-01).
  clerkOrgId String? @unique @map("clerk_org_id")

  status TenantStatus @default(PROVISIONING)
  plan   Plan         @default(STARTER)

  trialEndsAt DateTime? @map("trial_ends_at") @db.Timestamptz(6)

  onboardingStep         Int       @default(1) @map("onboarding_step") @db.SmallInt
  onboardingCompletedAt  DateTime? @map("onboarding_completed_at") @db.Timestamptz(6)
  onboardingStartedAt    DateTime  @default(now()) @map("onboarding_started_at") @db.Timestamptz(6)
  /// Etapas puladas pelo admin (AC-03 de MOD-IDENT-02); vai no payload de
  /// `tenant.onboarding.concluido`.
  onboardingStepsSkipped Int[]     @default([]) @map("onboarding_steps_skipped")

  /// Chave de idempotência do provisionamento (AC-03 de MOD-IDENT-01).
  provisioningKey       String  @unique @map("provisioning_key")
  provisioningAttempts  Int     @default(0) @map("provisioning_attempts") @db.SmallInt
  provisioningLastError String? @map("provisioning_last_error")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  settings        TenantSettings?
  billingSettings BillingSettings?
  memberships     Membership[]
  invitations     Invitation[]
  roleOverrides   TenantRoleOverride[]
  dataKey         DataKey?

  @@index([status])
  @@map("tenants")
}

/// Configurações operacionais e identidade visual (MOD-IDENT-08).
model TenantSettings {
  tenantId String @id @map("tenant_id") @db.Uuid

  timezone String @default("America/Sao_Paulo")

  /// Decisão de negócio: 24 horas de antecedência para cancelamento sem no-show.
  cancellationWindowHours Int @default(24) @map("cancellation_window_hours") @db.SmallInt
  noShowFeePercent        Int @default(0) @map("no_show_fee_percent") @db.SmallInt
  minBookingNoticeHours   Int @default(2) @map("min_booking_notice_hours") @db.SmallInt

  allowOverbooking     Boolean @default(false) @map("allow_overbooking")
  onlineBookingEnabled Boolean @default(true) @map("online_booking_enabled")
  /// Decisão de negócio 8: agendamento online entra **CONFIRMED** por padrão. Quem
  /// quiser triar liga isto, e aí a solicitação do Portal vira PENDING com reserva
  /// de 24h (AC-03 de MOD-AGENDA-06).
  onlineBookingRequiresApproval Boolean @default(false) @map("online_booking_requires_approval")

  /// `{ logoUrl, primaryColor, secondaryColor }`
  branding      Json
  /// Grade semanal: `{ monday: { closed, opensAt, closesAt }, ... }`
  businessHours Json @map("business_hours")

  /// Decisão de negócio: cada tenant conecta o próprio número via BSP oficial.
  whatsappProvisioning WhatsappProvisioning @default(OWN_NUMBER) @map("whatsapp_provisioning")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

/// Espelho local do usuário do Clerk. Tabela GLOBAL: um usuário pode pertencer a
/// N tenants (RN-01), então não tem `tenant_id` e não tem RLS.
model User {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId String @unique @map("clerk_user_id")

  /// PII cifrada. A busca usa `emailHash`, nunca LIKE sobre o texto cifrado.
  emailEncrypted String  @map("email_encrypted")
  emailHash      String  @unique @map("email_hash")
  fullName       String  @map("full_name") @db.VarChar(120)
  phoneEncrypted String? @map("phone_encrypted")
  avatarUrl      String? @map("avatar_url")

  mfaEnabled Boolean    @default(false) @map("mfa_enabled")
  status     UserStatus @default(ACTIVE)

  /// RN-09: só aplica webhook do Clerk cujo `updated_at` seja posterior a este valor.
  clerkSyncedAt DateTime? @map("clerk_synced_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships Membership[]

  @@map("users")
}

/// Vínculo usuário ↔ tenant com papel (MOD-IDENT-05).
model Membership {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  roleKey  String @map("role_key")

  status         MembershipStatus @default(ACTIVE)
  /// RN-06: papéis operacionais têm espelho em `professionals` (MOD-AGENDA).
  isProfessional Boolean          @default(false) @map("is_professional")

  /// RN-03: incrementa a cada troca de papel. O gateway compara com o claim
  /// `permVersion` do token e força refresh na divergência.
  permVersion Int @default(1) @map("perm_version")

  invitedBy String?  @map("invited_by") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleKey], references: [key])

  @@index([userId])
  @@index([tenantId, roleKey])
  @@map("memberships")
}

/// Papéis de sistema. Global, sem `tenant_id` — o tenant ajusta permissões via
/// `TenantRoleOverride`, não criando papéis próprios (questão 2 do PRD §11).
model Role {
  key      String  @id
  label    String
  isSystem Boolean @default(true) @map("is_system")

  permissions RolePermission[]
  memberships Membership[]

  @@map("roles")
}

/// Permissão granular no formato `recurso:acao`.
model Permission {
  key         String @id
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleKey       String @map("role_key")
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleKey], references: [key], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleKey, permissionKey])
  @@map("role_permissions")
}

/// Ajuste da matriz padrão por tenant: `granted = false` revoga, `true` concede.
model TenantRoleOverride {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  roleKey       String  @map("role_key")
  permissionKey String  @map("permission_key")
  granted       Boolean

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleKey, permissionKey])
  @@map("tenant_role_overrides")
}

/// MOD-IDENT-06 — tabela criada nesta fase para fixar o modelo e a política RLS.
/// Os endpoints de convite ainda não existem.
model Invitation {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  emailEncrypted String @map("email_encrypted")
  emailHash      String @map("email_hash")
  roleKey        String @map("role_key")

  /// SHA-256 do token; o token cru nunca é persistido.
  tokenHash String           @map("token_hash")
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)

  invitedBy  String?   @map("invited_by") @db.Uuid
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

/// MOD-IDENT-09 — append-only. `UPDATE` e `DELETE` são bloqueados por trigger
/// e por REVOKE na migration de RLS.
model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Nulo em ações de plataforma — visíveis apenas pela role `app_maintenance`.
  tenantId    String? @map("tenant_id") @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid

  action   String
  entity   String
  entityId String?      @map("entity_id")
  before   Json?
  after    Json?
  outcome  AuditOutcome @default(ALLOWED)

  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([entity, entityId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Eventos de segurança (MOD-SEC). Criado aqui porque MOD-IDENT-07 AC-02 exige
/// registrar `CROSS_TENANT_ATTEMPT`.
model SecurityEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId    String?           @map("tenant_id") @db.Uuid
  type        SecurityEventType
  actorUserId String?           @map("actor_user_id") @db.Uuid

  targetEntity String? @map("target_entity")
  targetId     String? @map("target_id")

  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")
  metadata  Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@map("security_events")
}

/// DEK por tenant, cifrada pela KEK mestra (envelope encryption, PRD §4).
/// A chave de plataforma — usada por `users`, que é tabela global — não fica aqui:
/// é derivada da KEK por HKDF, ver `src/crypto.ts`.
model DataKey {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  /// DEK cifrada pela KEK, no mesmo formato `v1:<iv>:<tag>:<ct>`.
  encryptedDek String @map("encrypted_dek")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("data_keys")
}

// ═══════════════════════════════════════════════════════════════════════════
// MOD-TUTOR — Cadastro e gestão de tutores (PRD tutores_02 §4)
// ═══════════════════════════════════════════════════════════════════════════

enum PersonType {
  PF
  PJ
}

enum TutorStatus {
  ACTIVE
  INACTIVE
  /// Terminal: origem de um merge, aponta `merged_into_id`.
  MERGED
  /// Terminal e irreversível: pedido do titular (LGPD art. 18).
  ANONYMIZED
}

enum DataCompleteness {
  COMPLETE
  PARTIAL
}

enum ConsentChannel {
  WHATSAPP
  EMAIL
  SMS
  TERMS
  IMAGE_USE
}

enum ConsentPurpose {
  TRANSACTIONAL
  MARKETING
  BOTH
}

enum ConsentSource {
  STAFF_FORM
  PORTAL
  SITE
  WHATSAPP
  IMPORT
}

/// O cliente pagante e titular dos dados pessoais.
///
/// CPF, CNPJ, telefones e e-mail ficam cifrados com a DEK do tenant; as colunas
/// `*_hash` (HMAC-SHA256 com pepper) é que sustentam unicidade e busca exata —
/// `LIKE` sobre texto cifrado não existe. `full_name` fica em claro, decisão
/// consciente do PRD §4 para viabilizar a busca por similaridade no balcão.
model Tutor {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  personType PersonType @default(PF) @map("person_type")

  fullName   String  @map("full_name") @db.VarChar(160)
  /// Razão social (PJ).
  legalName  String? @map("legal_name") @db.VarChar(160)
  /// RN-14: quando preenchido, é o nome exibido em telas e comunicações.
  socialName String? @map("social_name") @db.VarChar(120)

  cpfEncrypted  String? @map("cpf_encrypted")
  cpfHash       String? @map("cpf_hash")
  cnpjEncrypted String? @map("cnpj_encrypted")
  cnpjHash      String? @map("cnpj_hash")

  /// E.164. Obrigatório: é o canal primário e a chave do agente de IA (RN-03).
  phoneEncrypted    String  @map("phone_encrypted")
  phoneHash         String  @map("phone_hash")
  phoneAltEncrypted String? @map("phone_alt_encrypted")
  phoneAltHash      String? @map("phone_alt_hash")

  emailEncrypted String? @map("email_encrypted")
  emailHash      String? @map("email_hash")

  birthDate DateTime? @map("birth_date") @db.Date
  notes     String?

  status           TutorStatus      @default(ACTIVE)
  dataCompleteness DataCompleteness @default(PARTIAL) @map("data_completeness")

  /// RN-13 — vínculo com o login do Portal (MOD-PORTAL).
  portalUserId String? @map("portal_user_id") @db.Uuid
  /// Destino do merge, quando `status = MERGED`.
  mergedIntoId String? @map("merged_into_id") @db.Uuid

  /// Mantido pelo trigger `tutors_search_trigger`; a aplicação nunca escreve aqui.
  searchVector Unsupported("tsvector")? @map("search_vector")

  /// RN-10: escrito pelo consumo de `atendimento.concluido`, nunca calculado na
  /// listagem. Alimenta a tag automática INATIVO.
  lastAttendanceAt DateTime? @map("last_attendance_at") @db.Timestamptz(6)

  /// Denormalizados pelo mesmo motivo do RN-10: a listagem de balcão tem SLO de
  /// 300ms e não pode agregar outros serviços por linha.
  /// TODO(MOD-LEDGER): alimentar por `lancamento.criado`.
  balanceCents Int @default(0) @map("balance_cents")
  /// TODO(MOD-PET): alimentar por `pet.criado` / `pet.vinculado`.
  petsCount    Int @default(0) @map("pets_count")

  anonymizedAt DateTime? @map("anonymized_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  addresses      TutorAddress[]
  consents       TutorConsent[]
  tagAssignments TutorTagAssignment[]

  petTutors  PetTutor[]

  appointments   Appointment[]
  ledgerAccounts LedgerAccount[]

  mergedInto Tutor?  @relation("TutorMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom Tutor[] @relation("TutorMerge")

  @@map("tutors")
}

/// Um principal + N adicionais. Logradouro cifrado: endereço residencial é dado
/// sensível à segurança física do titular (PRD §4).
model TutorAddress {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tutorId  String @map("tutor_id") @db.Uuid

  label   String @default("Casa") @db.VarChar(40)
  zipCode String @map("zip_code") @db.VarChar(8)

  streetEncrypted     String  @map("street_encrypted")
  numberEncrypted     String  @map("number_encrypted")
  complementEncrypted String? @map("complement_encrypted")

  district String @db.VarChar(80)
  city     String @db.VarChar(80)
  state    String @db.VarChar(2)

  /// Geocodificação para a roteirização do Taxi Dog (MOD-TAXI).
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  /// "Portão azul, chamar no interfone 12".
  accessNotes String? @map("access_notes")

  /// RN-15: exatamente um por tutor, garantido por índice único parcial.
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@map("tutor_addresses")
}

/// Tag de segmentação. `is_system = true` são mantidas por evento, nunca à mão.
model TutorTag {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  key      String  @db.VarChar(40)
  label    String  @db.VarChar(60)
  color    String  @default("#E34A32") @db.VarChar(9)
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignments TutorTagAssignment[]

  @@map("tutor_tags")
}

model TutorTagAssignment {
  tenantId String @map("tenant_id") @db.Uuid
  tutorId  String @map("tutor_id") @db.Uuid
  tagId    String @map("tag_id") @db.Uuid

  /// Nulo quando a atribuição foi automática.
  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  tutor Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  tag   TutorTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tutorId, tagId])
  @@index([tagId])
  @@map("tutor_tag_assignments")
}

/// RN-05 — append-only. Revogar nunca apaga o opt-in anterior: o histórico é a
/// prova do tenant perante a ANPD. `UPDATE`/`DELETE` barrados por trigger.
model TutorConsent {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tutorId  String @map("tutor_id") @db.Uuid

  channel ConsentChannel
  granted Boolean
  purpose ConsentPurpose @default(MARKETING)
  /// Versão do termo aceito nesta transição.
  version String         @db.VarChar(20)
  source  ConsentSource  @default(STAFF_FORM)

  /// Prova do consentimento (PRD §4).
  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@map("tutor_consents")
}

/// Snapshot pré-merge dos dois cadastros. Guardado porque o merge não é reversível
/// automaticamente (questão 5 do PRD §11) — é o que permite reverter à mão.
model TutorMergeLog {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  sourceId String @map("source_id") @db.Uuid
  targetId String @map("target_id") @db.Uuid

  snapshot      Json
  /// `{ pets: [...], ledgerEntries: [...], appointments: [...] }`
  movedEntities Json @map("moved_entities")

  performedBy String?  @map("performed_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("tutor_merge_log")
}

// ═══════════════════════════════════════════════════════════════════════════
// MOD-PET — Cadastro de pets e tabelas de domínio (PRD pets_03 §4)
// ═══════════════════════════════════════════════════════════════════════════

enum PetSex {
  MALE
  FEMALE
  UNKNOWN
}

enum PetStatus {
  ACTIVE
  INACTIVE
  DECEASED
  /// Terminal no tenant de origem.
  TRANSFERRED_OUT
}

/// AC-03 de MOD-PET-01: o pet resgatado entra com idade estimada, e a tela precisa
/// saber a diferença — "2 anos" e "≈ 2 anos" mudam a conduta clínica.
enum BirthDatePrecision {
  EXACT
  ESTIMATED
  UNKNOWN
}

/// Motivo da transferência de titularidade (MOD-PET-05). Não é campo livre: é o que
/// separa "adotado" de "erro de cadastro" no relatório e na conversa com o tutor.
enum TransferReason {
  ADOPTION
  SALE
  TUTOR_DEATH
  CORRECTION
  OTHER
}

/// De onde a foto veio. `GROOMING_RESULT` é a foto pós-tosa que o MOD-CRM manda ao
/// tutor; separá-la de uma foto qualquer do álbum é o que impede mandar a foto errada.
enum PhotoSource {
  STAFF
  TUTOR
  GROOMING_RESULT
}

enum PetTutorRole {
  PRIMARY
  SECONDARY
}

/// Espécie. `tenant_id` nulo é catálogo global, somente leitura para o tenant (RN-02).
model Species {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid

  key   String @db.VarChar(40)
  label String @db.VarChar(60)
  /// Não está no PRD: sem ele "Outros" apareceria no meio da lista, em ordem
  /// alfabética. A ordenação do seletor é decisão de produto, não do acaso.
  sortOrder Int     @default(0) @map("sort_order") @db.SmallInt
  active    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  breeds Breed[]
  pets   Pet[]

  @@map("species")
}

/// Raça. O catálogo global cobre o comum; o tenant acrescenta o que faltar.
model Breed {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String? @map("tenant_id") @db.Uuid
  speciesId String  @map("species_id") @db.Uuid

  label String @db.VarChar(80)
  /// Minúsculo e sem acento, para o dedupe do AC-03 de MOD-PET-03.
  normalizedLabel String @map("normalized_label") @db.VarChar(80)

  /// Sugestão de porte ao selecionar a raça; a recepção pode trocar.
  defaultSizeId String? @map("default_size_id") @db.Uuid
  groomingNotes String? @map("grooming_notes")
  active        Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  species     Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  defaultSize Size?   @relation(fields: [defaultSizeId], references: [id], onDelete: SetNull)
  pets        Pet[]
  visibility  BreedVisibility[]

  @@index([speciesId])
  @@map("breeds")
}

/// Porte. RN-03: insumo direto do preço e da duração do serviço.
model Size {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid

  key   String @db.VarChar(40)
  label String @db.VarChar(60)

  /// Faixa de referência do AC-04: fora dela o cadastro avisa, nunca bloqueia.
  weightMinKg Decimal @map("weight_min_kg") @db.Decimal(5, 2)
  weightMaxKg Decimal @map("weight_max_kg") @db.Decimal(5, 2)

  sortOrder Int     @default(0) @map("sort_order") @db.SmallInt
  active    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  pets           Pet[]
  breeds         Breed[]
  servicePricing ServicePricing[]

  @@map("sizes")
}

/// Pelagem. RN-03: `grooming_time_factor` multiplica a duração base do serviço.
model Coat {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid

  key   String @db.VarChar(40)
  label String @db.VarChar(60)

  groomingTimeFactor Decimal @default(1.00) @map("grooming_time_factor") @db.Decimal(3, 2)

  sortOrder Int     @default(0) @map("sort_order") @db.SmallInt
  active    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  pets Pet[]

  @@map("coats")
}

/// O paciente. A agenda é dele, o prontuário é dele, e o preço do banho depende do
/// porte e da pelagem dele.
///
/// `microchip` e `notes` ficam cifrados com a DEK do tenant (PRD §4). Como o
/// AES-GCM é não determinístico, a unicidade do microchip por tenant se apoia em
/// `microchip_hash` — mesmo par cifra/hash que o MOD-TUTOR usa para CPF e telefone.
model Pet {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name String @db.VarChar(60)

  speciesId String  @map("species_id") @db.Uuid
  /// Nulo é legítimo: "SRD" é raça do catálogo, mas nem todo cadastro sabe a raça.
  breedId   String? @map("breed_id") @db.Uuid
  sizeId    String  @map("size_id") @db.Uuid
  coatId    String? @map("coat_id") @db.Uuid

  sex PetSex @default(UNKNOWN)

  birthDate          DateTime?          @map("birth_date") @db.Date
  birthDatePrecision BirthDatePrecision @default(UNKNOWN) @map("birth_date_precision")

  /// RN-10: reflete sempre a pesagem mais recente; a série vive em `pet_weights`.
  weightKg Decimal? @map("weight_kg") @db.Decimal(5, 2)
  neutered Boolean?

  microchipEncrypted String? @map("microchip_encrypted")
  microchipHash      String? @map("microchip_hash")

  color String? @db.VarChar(40)

  /// FK "solta" de propósito: a capa é uma das linhas de `pet_photos`, e uma FK real
  /// criaria um ciclo (foto → pet → foto) que complica exclusão e seed. A consistência
  /// é garantida no serviço, que só grava id de foto viva do próprio pet.
  coverPhotoId String? @map("cover_photo_id") @db.Uuid

  status     PetStatus @default(ACTIVE)
  deceasedAt DateTime? @map("deceased_at") @db.Date
  /// AC-03 de MOD-PET-08 conta 30 dias a partir do **registro**, não da data do
  /// óbito: o tutor comunica dias depois, e a janela de correção é do lançamento.
  deceasedRecordedAt DateTime? @map("deceased_recorded_at") @db.Timestamptz(6)

  notesEncrypted String? @map("notes_encrypted")

  /// Mantido pelo trigger `pets_search_trigger`; a aplicação nunca escreve aqui.
  searchVector Unsupported("tsvector")? @map("search_vector")

  /// Escrito pelo consumo de `atendimento.concluido`. Denormalizado porque a
  /// listagem tem SLO de 300ms e o RN-10 proíbe calcular na hora.
  lastAttendanceAt DateTime? @map("last_attendance_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  species Species @relation(fields: [speciesId], references: [id])
  breed   Breed?  @relation(fields: [breedId], references: [id])
  size    Size    @relation(fields: [sizeId], references: [id])
  coat    Coat?   @relation(fields: [coatId], references: [id])

  petTutors PetTutor[]
  weights   PetWeight[]
  transfers PetTransferLog[]
  photos    PetPhoto[]

  appointments Appointment[]

  allergies     Allergy[]
  temperaments  Temperament[]
  medicalAlerts MedicalAlert[]

  @@map("pets")
}

/// Vínculo N:N com papel (MOD-PET-02). RN-04: exatamente um PRIMARY ativo por pet,
/// garantido por índice único parcial.
///
/// O vínculo é encerrado com `unlinked_at`, não apagado: quem autorizou um
/// procedimento ano passado precisa continuar rastreável depois da transferência.
model PetTutor {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  petId    String @map("pet_id") @db.Uuid
  tutorId  String @map("tutor_id") @db.Uuid

  role         PetTutorRole @default(SECONDARY)
  relationship String?      @db.VarChar(40)

  canAuthorizeProcedures Boolean @default(true) @map("can_authorize_procedures")

  linkedAt   DateTime  @default(now()) @map("linked_at") @db.Timestamptz(6)
  unlinkedAt DateTime? @map("unlinked_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  pet   Pet   @relation(fields: [petId], references: [id], onDelete: Cascade)
  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@map("pet_tutors")
}

/// Série de pesagens (MOD-PET-07). Base da dosagem clínica e do alerta do RN-11.
model PetWeight {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  petId    String @map("pet_id") @db.Uuid

  weightKg   Decimal  @map("weight_kg") @db.Decimal(5, 2)
  measuredAt DateTime @default(now()) @map("measured_at") @db.Timestamptz(6)

  /// Pesagem aferida no atendimento, preenchida pelo consumo de
  /// `atendimento.concluido`. Nulo é a pesagem avulsa, feita na balança do balcão.
  /// Serve também de chave de idempotência: o broker entrega ao menos uma vez.
  attendanceId String? @map("attendance_id") @db.Uuid
  measuredBy   String? @map("measured_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("pet_weights")
}

/// Álbum do pet (MOD-PET-04). O arquivo mora no R2; aqui ficam a referência, a
/// procedência e o que a LGPD exige saber sobre ele.
///
/// Não há URL pública: `variants` guarda **chaves de objeto**, e a URL é assinada na
/// leitura com validade de 15 minutos (RN-13). Guardar URL assinada no banco seria
/// guardar um dado que nasce vencido.
model PetPhoto {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  petId    String @map("pet_id") @db.Uuid

  /// `{ thumb, medium, full }` — chave de cada variante no bucket.
  variants Json

  caption String? @db.VarChar(140)
  takenAt DateTime @default(now()) @map("taken_at") @db.Timestamptz(6)
  source  PhotoSource @default(STAFF)

  /// TODO(MOD-AGENDA): foto de antes e depois presa ao atendimento.
  attendanceId String? @map("attendance_id") @db.Uuid

  /// RN-14: só vira material de campanha com o consentimento IMAGE_USE do tutor,
  /// conferido no momento da marcação — não no do upload.
  marketingUse Boolean @default(false) @map("marketing_use")

  sizeBytes Int    @map("size_bytes")
  mimeType  String @map("mime_type") @db.VarChar(40)

  uploadedBy String? @map("uploaded_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// O arquivo no bucket só some no `media-purge`; o soft delete tira da tela na hora.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("pet_photos")
}

// ─── MOD-PRONT — Prontuário clínico e comportamental ─────────────────────────

/// Severidade clínica, compartilhada por alergia e alerta médico. `CRITICAL` é o
/// único nível que bloqueia operação (RN-03 de prontuario_04); os demais avisam.
enum ClinicalSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AllergyType {
  FOOD
  PRODUCT
  MEDICATION
  ENVIRONMENTAL
  OTHER
}

/// Classificação comportamental (MOD-PRONT-04). `UNKNOWN` é honesto: o pet que
/// nunca foi atendido não é dócil, é desconhecido — e a equipe precisa da diferença.
enum TemperamentClassification {
  DOCILE
  ANXIOUS
  FEARFUL
  REACTIVE
  AGGRESSIVE
  UNKNOWN
}

/// Alergia e restrição (MOD-PRONT-03).
///
/// Nunca é apagada: a desativação preserva a linha com quem desativou e por quê
/// (AC-04). Uma alergia que "some" do histórico é uma informação de segurança que
/// desapareceu sem rastro — e é justamente essa que faz falta depois.
model Allergy {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  petId    String @map("pet_id") @db.Uuid

  type     AllergyType
  label    String           @db.VarChar(120)
  severity ClinicalSeverity

  /// Cifrada: detalhe clínico da reação observada (§4).
  reactionEncrypted String? @map("reaction_encrypted")

  /// Serviços que esta alergia bloqueia (RN-03). FK lógica para `services`, que
  /// vive no MOD-AGENDA — array em vez de tabela de junção porque a lista é curta
  /// e sempre lida junto com a alergia.
  blocksServices String[] @map("blocks_services") @db.Uuid
  /// Palavras-chave de produto ("shampoo neutro X"), casadas no check-out.
  blocksProducts String[] @map("blocks_products")

  diagnosedAt DateTime? @map("diagnosed_at") @db.Date
  diagnosedBy String?   @map("diagnosed_by") @db.Uuid

  active          Boolean   @default(true)
  resolutionNotes String?   @map("resolution_notes")
  deactivatedBy   String?   @map("deactivated_by") @db.Uuid
  deactivatedAt   DateTime? @map("deactivated_at") @db.Timestamptz(6)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("allergies")
}

/// Observação de temperamento (MOD-PRONT-04).
///
/// É série histórica, não campo do pet: RN-16 exige que o histórico de risco
/// sobreviva à melhora. `is_current` marca o vigente, e o índice parcial garante
/// que só exista um por pet.
model Temperament {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  petId    String @map("pet_id") @db.Uuid

  classification TemperamentClassification

  /// NAIL_TRIMMING, DRYER, MUZZLE, BATH, STRANGERS, OTHER_DOGS — em que situação.
  contexts String[]

  requiresMuzzle      Boolean @default(false) @map("requires_muzzle")
  requiresTwoHandlers Boolean @default(false) @map("requires_two_handlers")

  /// Cifrada. Obrigatória para REACTIVE e AGGRESSIVE (AC-02): "morde" sem contexto
  /// não diz à equipe o que evitar.
  notesEncrypted String? @map("notes_encrypted")

  observedBy String?  @map("observed_by") @db.Uuid
  observedAt DateTime @default(now()) @map("observed_at") @db.Timestamptz(6)

  isCurrent Boolean @default(true) @map("is_current")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("temperaments")
}

/// Condição médica ativa (MOD-PRONT-05): cardiopatia, epilepsia, idade avançada.
/// Diferente da alergia, não bloqueia serviço — instrui a execução ("não usar
/// secador quente").
model MedicalAlert {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  petId    String @map("pet_id") @db.Uuid

  condition String           @db.VarChar(120)
  severity  ClinicalSeverity

  /// Cifrada: instrução operacional que pode descrever quadro clínico.
  instructionsEncrypted String? @map("instructions_encrypted")

  active          Boolean   @default(true)
  resolutionNotes String?   @map("resolution_notes")
  deactivatedBy   String?   @map("deactivated_by") @db.Uuid
  deactivatedAt   DateTime? @map("deactivated_at") @db.Timestamptz(6)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("medical_alerts")
}

/// AC-02 de MOD-PET-03: o tenant não edita nem apaga raça global — esconde da lista
/// dele. A linha existir **é** o "escondido"; mostrar de volta é apagá-la.
model BreedVisibility {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  breedId  String @map("breed_id") @db.Uuid

  hiddenAt DateTime @default(now()) @map("hidden_at") @db.Timestamptz(6)
  hiddenBy String?  @map("hidden_by") @db.Uuid

  breed Breed @relation(fields: [breedId], references: [id], onDelete: Cascade)

  @@map("breed_visibility")
}

/// Histórico de titularidade (MOD-PET-05). RN-06: o prontuário nunca se move; o que
/// muda de dono é o cadastro, e esta tabela é a prova de quando e por quê.
model PetTransferLog {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  petId    String @map("pet_id") @db.Uuid

  /// Nulo só no caso improvável de transferência de pet sem responsável ativo —
  /// possível se um `tutor.anonimizado` desvinculou o último antes.
  fromTutorId String? @map("from_tutor_id") @db.Uuid
  toTutorId   String  @map("to_tutor_id") @db.Uuid

  reason TransferReason
  notes  String?

  /// A data que o tenant declara para o efeito; os vínculos mudam no commit.
  effectiveDate DateTime? @map("effective_date") @db.Date

  performedBy String?  @map("performed_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("pet_transfer_log")
}

// ─── MOD-AGENDA — catálogo de serviços, profissionais e bloqueios ────────────
// PRD agenda_operacao_06 §4, sub-features 01 a 03.

enum ServiceCategory {
  BATH
  GROOMING
  VET
  VACCINE
  OTHER
}

/// O que o petshop vende. O preço e a duração **não** ficam aqui: eles variam por
/// porte e moram em `service_pricing` (MOD-AGENDA-01).
model Service {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name        String          @db.VarChar(80)
  category    ServiceCategory
  description String?         @db.VarChar(300)

  /// Duração do porte de referência. É o valor que a UI **sugere** ao montar a
  /// tabela de preços; nunca a fonte do cálculo — ver a nota em `ServicePricing`.
  baseDurationMin Int @map("base_duration_min") @db.SmallInt

  /// Restringe a execução ao papel VET (AC-01 de MOD-AGENDA-01).
  requiresVet Boolean @default(false) @map("requires_vet")

  /// AC-03: serviço com agendamento futuro não é excluído, só desativado — some do
  /// seletor sem tocar no que já está marcado.
  active Boolean @default(true)

  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  pricing       ServicePricing[]
  professionals ProfessionalService[]

  appointmentItems AppointmentItem[]

  @@index([tenantId, active])
  @@map("services")
}

/// Preço **e** duração por porte.
///
/// Os dois são obrigatórios: a duração por porte é tabela, não multiplicador sobre a
/// base (decisão do §11 Q1 do PRD da agenda, que prevalece sobre o RN-03 de pets_03).
/// O petshop precisa poder dizer que banho em Golden leva 90 min sem que isso mexa em
/// nenhum outro serviço — e uma agenda que estima errado é uma agenda que mente.
///
/// A ausência de linha para um porte é significativa: o AC-02 manda devolver 422 em
/// vez de interpolar, porque preço inventado no fechamento vira briga no balcão.
model ServicePricing {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  sizeId    String @map("size_id") @db.Uuid

  /// Dinheiro é inteiro em centavos (convenção fixada a partir do PRD 05).
  priceCents  BigInt @map("price_cents")
  durationMin Int    @map("duration_min") @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  size    Size    @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  @@unique([serviceId, sizeId], map: "idx_service_pricing_unique")
  @@map("service_pricing")
}

/// Quem executa. Separado de `memberships` de propósito: existe profissional sem
/// login (o tosador que não usa o sistema) e existe membro que não atende (o
/// financeiro). O vínculo é opcional, nos dois sentidos.
model Professional {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  userId   String? @map("user_id") @db.Uuid

  displayName String @map("display_name") @db.VarChar(60)
  roleKey     String @map("role_key") @db.VarChar(30)

  /// Capacidade **simultânea**, não sequencial (decisão do §11 Q7): o banhista lava
  /// um pet, põe para secar e começa o próximo. O conflito do RN-13 é
  /// `count(sobreposições) >= este número`, e não "existe sobreposição" — é por isso
  /// que a garantia vem de transação SERIALIZABLE e não de `EXCLUDE USING GIST`.
  maxConcurrentPets Int @default(1) @map("max_concurrent_pets") @db.SmallInt

  /// Cor da coluna no painel do dia.
  color String? @db.VarChar(7)

  /// AC-04: desligar alguém com agendamento futuro exige reatribuição antes.
  active Boolean @default(true)

  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  services  ProfessionalService[]
  schedules ProfessionalSchedule[]
  blocks    CalendarBlock[]

  appointments Appointment[]

  @@index([tenantId, active])
  @@map("professionals")
}

/// Habilitação N:N. Sem linha aqui, o profissional não aparece no seletor daquele
/// serviço — é o que impede marcar tosa com quem só dá banho.
model ProfessionalService {
  professionalId String @map("professional_id") @db.Uuid
  serviceId      String @map("service_id") @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId], map: "idx_professional_service")
  @@map("professional_services")
}

/// Uma faixa contínua de trabalho. O almoço não é um campo: é o que **parte** o dia
/// em duas linhas do mesmo `weekday` — modelar como "início, fim e intervalo" quebra
/// no dia em que alguém tiver dois intervalos.
model ProfessionalSchedule {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid

  /// 0 = domingo, 6 = sábado.
  weekday Int @db.SmallInt

  /// Minutos desde a meia-noite, no fuso do tenant. Guardar minuto e não `time`
  /// evita a armadilha de um `time` sem fuso ser comparado com `timestamptz`.
  startsAtMin Int @map("starts_at_min") @db.SmallInt
  endsAtMin   Int @map("ends_at_min") @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, weekday])
  @@map("professional_schedules")
}

/// Folga, feriado e manutenção. `professional_id` nulo é o bloqueio do tenant
/// inteiro: o feriado some da oferta de todo mundo sem precisar de uma linha por
/// pessoa (AC-03 de MOD-AGENDA-03).
model CalendarBlock {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  professionalId String? @map("professional_id") @db.Uuid

  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)

  reason String? @db.VarChar(120)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId, startsAt, endsAt], map: "idx_blocks_window")
  @@map("calendar_blocks")
}

// ─── MOD-AGENDA — agendamentos (fatia 2) ─────────────────────────────────────
// PRD agenda_operacao_06 §4 e §6.

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum AppointmentSource {
  STAFF
  PORTAL
  RECURRENCE
  AI_AGENT
}

/// Um atendimento marcado.
///
/// `ends_at` é **calculado**, nunca digitado (RN-01): sai da soma das durações dos
/// itens, que por sua vez vêm da tabela de preço do porte corrigida pela pelagem. É
/// coluna e não expressão porque o índice GIST de conflito precisa dela materializada.
model Appointment {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  petId          String @map("pet_id") @db.Uuid
  tutorId        String @map("tutor_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid

  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)

  status AppointmentStatus @default(CONFIRMED)
  source AppointmentSource @default(STAFF)

  /// RN-04: fotografia do momento da criação. Reajuste de preço não retroage.
  totalCents BigInt @map("total_cents")

  /// RN-17: a hora **real**, que a métrica compara com `starts_at`. Check-in fora do
  /// horário é permitido — o pet está ali.
  checkinAt  DateTime? @map("checkin_at") @db.Timestamptz(6)
  checkoutAt DateTime? @map("checkout_at") @db.Timestamptz(6)

  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  /// Cifrado: o motivo pode citar doença do tutor ou do pet (§9).
  cancelReasonEncrypted String?  @map("cancel_reason_encrypted")
  /// RN-06: dentro da janela de 24h. É o que decide a taxa no MOD-LEDGER.
  cancelledLate         Boolean? @map("cancelled_late")

  /// RN-16: a cadeia de remarcações. "Quantas vezes remarcou" é dado de negócio.
  rescheduledToId String? @unique @map("rescheduled_to_id") @db.Uuid

  /// Ocorrência de uma série (MOD-AGENDA-05). Nulo é agendamento avulso.
  recurrenceId String? @map("recurrence_id") @db.Uuid

  /// MOD-AGENDA-10: quem assumiu o risco clínico, e quando.
  acknowledgedAlertsBy String?   @map("acknowledged_alerts_by") @db.Uuid
  acknowledgedAlertsAt DateTime? @map("acknowledged_alerts_at") @db.Timestamptz(6)

  /// RN-11: quem liberou o inadimplente e por quê.
  creditOverrideBy     String? @map("credit_override_by") @db.Uuid
  creditOverrideReason String? @map("credit_override_reason")

  /// Campo livre — costuma receber dado pessoal ("tocar o interfone 2").
  notesEncrypted String? @map("notes_encrypted")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  items     AppointmentItem[]
  statusLog AppointmentStatusLog[]

  pet          Pet          @relation(fields: [petId], references: [id], onDelete: Restrict)
  tutor        Tutor        @relation(fields: [tutorId], references: [id], onDelete: Restrict)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)

  /// A cadeia de remarcação é auto-referente: o cancelado aponta para o novo.
  rescheduledTo   Appointment? @relation("AppointmentReschedule", fields: [rescheduledToId], references: [id], onDelete: SetNull)
  rescheduledFrom Appointment? @relation("AppointmentReschedule")

  recurrence AppointmentRecurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)

  @@index([petId, startsAt(sort: Desc)], map: "idx_appointments_pet")
  @@index([tenantId, tutorId, startsAt(sort: Desc)], map: "idx_appointments_tutor")
  @@map("appointments")
}

/// Um atendimento pode ter banho + hidratação. Preço e duração congelados por item
/// (RN-04), porque o total é a soma deles e reajuste não pode reescrever a conta.
model AppointmentItem {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  appointmentId String @map("appointment_id") @db.Uuid
  serviceId     String @map("service_id") @db.Uuid

  /// Rótulo congelado junto: o serviço pode ser renomeado ou excluído depois, e o
  /// histórico precisa continuar sabendo o que foi vendido.
  label String @db.VarChar(80)

  priceCents  BigInt @map("price_cents")
  durationMin Int    @map("duration_min") @db.SmallInt

  /// RN-18: item acrescentado durante a execução, no check-out.
  addedAtCheckout Boolean @default(false) @map("added_at_checkout")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([appointmentId])
  @@map("appointment_items")
}

/// Trilha da máquina de estado (§6). Append-only por trigger, como `audit_logs`:
/// "quando isso virou no-show e quem decidiu" é pergunta que se faz meses depois.
model AppointmentStatusLog {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  appointmentId String @map("appointment_id") @db.Uuid

  /// Nulo na criação: não havia estado anterior.
  fromStatus AppointmentStatus? @map("from_status")
  toStatus   AppointmentStatus  @map("to_status")

  changedBy String?  @map("changed_by") @db.Uuid
  reason    String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@map("appointment_status_log")
}

/// Série recorrente (MOD-AGENDA-05).
///
/// RN-14: a recorrência é **materializada**, não uma regra viva. As ocorrências são
/// agendamentos reais até 12 semanas à frente, estendidas por job semanal. Interpretar
/// RRULE em toda leitura de agenda transformaria a consulta mais frequente do sistema
/// numa avaliação de calendário, e nada — bloqueio, remarcação, cancelamento de uma
/// ocorrência — poderia ser gravado sem inventar uma tabela de exceções.
model AppointmentRecurrence {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  petId          String @map("pet_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid

  /// iCal RRULE, restrita a FREQ DAILY/WEEKLY/MONTHLY (AC-02).
  rrule String @db.VarChar(200)

  /// Primeira ocorrência; a série é gerada a partir dela.
  startsAt DateTime  @map("starts_at") @db.Timestamptz(6)
  /// Fim da série. Nulo é série sem prazo, estendida pelo job semanal.
  until    DateTime? @db.Timestamptz(6)
  /// Até onde já foi materializado. É o que o job lê para saber o que gerar.
  materializedUntil DateTime? @map("materialized_until") @db.Timestamptz(6)

  /// Serviços da série, congelados como ids. O preço **não** é congelado aqui: cada
  /// ocorrência congela o seu na criação (RN-04), e uma série de um ano não pode
  /// carregar o preço de doze meses atrás.
  serviceIds String[] @map("service_ids") @db.Uuid

  active Boolean @default(true)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  appointments Appointment[]

  @@index([tenantId, active, materializedUntil], map: "idx_recurrences_materialize")
  @@map("appointment_recurrences")
}

// ─── MOD-LEDGER — conta corrente do tutor ────────────────────────────────────
// PRD financeiro_tutor_05 §4.
//
// Convenção de dinheiro do módulo: **inteiro em centavos (`BigInt`), nunca `Decimal`
// nem `Float`**. Soma de saldo corrido é a operação mais executada daqui e a única em
// que erro de arredondamento é irreversível e visível para o cliente final.

enum EntryDirection {
  DEBIT
  CREDIT
}

enum EntryCategory {
  SERVICE
  PRODUCT
  NO_SHOW_FEE
  PACKAGE_PURCHASE
  PACKAGE_REDEMPTION
  PAYMENT
  PAYMENT_REVERSAL
  ADJUSTMENT
  FEE_WAIVER
  DISCOUNT
}

enum EntrySourceType {
  ATTENDANCE
  APPOINTMENT
  PAYMENT
  PACKAGE
  MANUAL
  SYSTEM
}

enum EntryStatus {
  POSTED
  REVERSED
}

enum PaymentMethod {
  CASH
  PIX_MANUAL
  CARD_MACHINE_DEBIT
  CARD_MACHINE_CREDIT
  BANK_TRANSFER
  PACKAGE_CREDIT
  OTHER
}

enum PaymentStatus {
  RECORDED
  REVERSED
}

enum AllocationSource {
  AUTO_FIFO
  MANUAL
}

enum PurchaseStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  SUSPENDED
  CANCELLED
}

/// Uma conta por tutor por tenant (MOD-LEDGER-01).
///
/// RN-17: **criada preguiçosamente**. Não se cria conta no cadastro do tutor; a
/// primeira consulta ou o primeiro lançamento a cria com saldo zero. Tutor sem
/// movimentação nunca devolve 404 — devolve extrato vazio.
model LedgerAccount {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tutorId  String @map("tutor_id") @db.Uuid

  /// RN-02: positivo é crédito do tutor, negativo é inadimplência. Mesma convenção
  /// de `tutors.balance_cents`, que este módulo alimenta por evento.
  balanceCents BigInt @default(0) @map("balance_cents")
  currency     String @default("BRL") @db.Char(3)

  /// Optimistic locking. O caminho de escrita usa `FOR UPDATE`, mas a coluna deixa
  /// a corrida detectável em auditoria depois do fato.
  version Int @default(0)

  lastEntryAt   DateTime? @map("last_entry_at") @db.Timestamptz(6)
  lastPaymentAt DateTime? @map("last_payment_at") @db.Timestamptz(6)
  /// Início do atraso vigente; nulo se em dia.
  overdueSince  DateTime? @map("overdue_since") @db.Timestamptz(6)

  /// RN-18: marcado pelo job de reconciliação. **Não bloqueia lançamento novo** — a
  /// conta não trava para o tenant por um bug nosso.
  needsReview Boolean @default(false) @map("needs_review")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tutor    Tutor          @relation(fields: [tutorId], references: [id], onDelete: Restrict)
  entries  LedgerEntry[]
  payments Payment[]

  @@map("ledger_accounts")
}

/// O lançamento (MOD-LEDGER-02). **Append-only**, garantido por trigger e por RULE
/// no banco: erro nunca vira UPDATE, vira contrapartida vinculada (RN-01).
model LedgerEntry {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid
  tutorId   String @map("tutor_id") @db.Uuid

  direction EntryDirection
  /// Sempre positivo (o CHECK garante); o sinal vem de `direction`. A exceção é o
  /// lançamento informativo de uso de pacote, que vale zero.
  amountCents BigInt @map("amount_cents")

  /// Coluna **gerada** pelo Postgres: `CREDIT ? +amount : -amount`. A aplicação
  /// nunca escreve aqui — é opcional no Prisma só para que `create` não a exija.
  /// É o que o job de reconciliação soma.
  signedAmountCents BigInt? @map("signed_amount_cents")

  /// Saldo corrido no instante da postagem. É o que faz o extrato não precisar
  /// somar a tabela inteira para mostrar uma página.
  balanceAfterCents BigInt @map("balance_after_cents")

  category EntryCategory
  /// Texto visível ao tutor no extrato.
  description String @db.VarChar(200)
  /// Cifrado com a DEK do tenant. **Nunca** exposto ao tutor (AC-03 de MOD-LEDGER-06):
  /// pode conter juízo de valor ("cliente sempre atrasa").
  internalNotesEncrypted String? @map("internal_notes_encrypted")

  sourceType EntrySourceType @map("source_type")
  /// Idempotência com `source_type`, pelo índice único parcial.
  sourceId   String?         @map("source_id") @db.Uuid
  petId      String?         @map("pet_id") @db.Uuid

  /// RN-23: data do fato gerador — pode ser retroativa. O extrato ordena por ela.
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  /// Data do registro no sistema — nunca retroativa. A auditoria ordena por ela.
  postedAt   DateTime @default(now()) @map("posted_at") @db.Timestamptz(6)

  status EntryStatus @default(POSTED)

  /// Aponta para a contrapartida que estornou este lançamento.
  reversedByEntryId String? @map("reversed_by_entry_id") @db.Uuid
  /// Preenchido quando este lançamento **é** a contrapartida.
  reversesEntryId   String? @map("reverses_entry_id") @db.Uuid

  /// Quanto do débito já foi quitado por alocação de pagamento.
  settledCents BigInt @default(0) @map("settled_cents")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  account     LedgerAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  payment     Payment?
  allocations PaymentAllocation[]
  usage       PackageCreditUsage?
  purchase    PackagePurchase?

  @@map("ledger_entries")
}

/// Pagamento recebido **fora do sistema** e lançado aqui (MOD-LEDGER-03).
///
/// A v1 não processa dinheiro: o PIX cai na chave do petshop, a maquininha é do
/// petshop, e o que se registra é o fato. `external_ref` fica reservado para o `txid`
/// do PSP quando o gateway entrar, sem migração destrutiva (RN-19).
model Payment {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid
  tutorId   String @map("tutor_id") @db.Uuid

  amountCents BigInt @map("amount_cents")
  /// Quanto do pagamento já foi alocado a débitos. A diferença é o crédito que
  /// sobrou na conta (RN-07) e que o próximo débito consome.
  allocatedCents BigInt @default(0) @map("allocated_cents")

  method     PaymentMethod
  /// Quando o dinheiro entrou de fato — pode ser anterior ao registro.
  receivedAt DateTime      @map("received_at") @db.Timestamptz(6)
  /// Quem recebeu no balcão. É a coluna da responsabilização.
  receivedBy String?       @map("received_by") @db.Uuid

  /// Lançamento de crédito correspondente. 1:1.
  entryId String @unique @map("entry_id") @db.Uuid

  status         PaymentStatus @default(RECORDED)
  /// Obrigatório quando REVERSED (RN-25: só TENANT_ADMIN reverte).
  reversalReason String?       @map("reversal_reason")

  /// Cifrados: o comprovante pode exibir dado bancário de terceiro, e a observação
  /// do balcão é campo livre onde cabe qualquer coisa.
  proofUrlEncrypted String? @map("proof_url_encrypted")
  notesEncrypted    String? @map("notes_encrypted")

  /// Reservado para o `txid` do PSP (RN-19). Não usado na v1.
  externalRef String? @map("external_ref") @db.VarChar(120)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  account     LedgerAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  entry       LedgerEntry         @relation(fields: [entryId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]
  purchases   PackagePurchase[]
  receipt     Receipt?

  @@map("payments")
}

/// Quitação N:N entre pagamento e débito (MOD-LEDGER-04).
///
/// RN-06: FIFO por padrão — o pagamento quita os débitos mais antigos primeiro.
/// Alocação manual é auditada, porque quitação fora do FIFO é o vetor clássico de
/// desvio no balcão.
model PaymentAllocation {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  paymentId     String @map("payment_id") @db.Uuid
  debitEntryId  String @map("debit_entry_id") @db.Uuid

  amountCents BigInt           @map("amount_cents")
  allocatedBy AllocationSource @default(AUTO_FIFO) @map("allocated_by")

  /// A reversão do pagamento **marca**, não apaga: o AC-05 é explícito em que nada
  /// desaparece do rastro.
  reversedAt DateTime? @map("reversed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment    Payment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  debitEntry LedgerEntry @relation(fields: [debitEntryId], references: [id], onDelete: Restrict)

  @@map("payment_allocations")
}

/// Catálogo de pacotes do tenant (MOD-LEDGER-07).
model ServicePackage {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name String @db.VarChar(120)
  /// RN-10: o crédito cobre **estes** serviços. O casamento é por `service_id`,
  /// nunca por equivalência de valor.
  serviceIds String[] @map("service_ids") @db.Uuid

  credits    Int
  priceCents BigInt @map("price_cents")
  /// Decisão de negócio 2: 90 dias.
  validityDays Int  @default(90) @map("validity_days")

  /// Descontinuar não apaga as compras já feitas.
  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  purchases PackagePurchase[]

  @@map("service_packages")
}

/// A compra de um pacote por um tutor.
model PackagePurchase {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  tutorId   String @map("tutor_id") @db.Uuid
  packageId String @map("package_id") @db.Uuid

  /// Vinculação a um pet. Opcional: pacote de tutor com um pet só não precisa dela,
  /// e AC-05 permite reatribuir depois.
  petId String? @map("pet_id") @db.Uuid

  /// Nome, serviços, créditos e preço **no ato da compra**. RN-05: alterar o
  /// catálogo depois nunca muda o que já foi vendido.
  snapshot Json

  creditsTotal Int @map("credits_total")
  creditsUsed  Int @default(0) @map("credits_used")

  purchasedAt DateTime @default(now()) @map("purchased_at") @db.Timestamptz(6)
  /// `purchased_at + validity_days`. RN-08: vencido, o crédito é perdido e **nada é
  /// devolvido** — decisão de produto, com aviso prévio obrigatório (RN-09).
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  status PurchaseStatus @default(ACTIVE)
  /// Cifrado: pode citar óbito do pet ou situação familiar.
  suspensionReasonEncrypted String? @map("suspension_reason_encrypted")

  /// Rastro financeiro da compra.
  paymentId String? @map("payment_id") @db.Uuid
  entryId   String  @unique @map("entry_id") @db.Uuid

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  package ServicePackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  payment Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  entry   LedgerEntry    @relation(fields: [entryId], references: [id], onDelete: Restrict)
  usages  PackageCreditUsage[]

  @@map("package_purchases")
}

/// Um crédito de pacote consumido por um atendimento.
///
/// O único `(tenant_id, attendance_id, service_id)` é a idempotência do resgate: a
/// reentrega de `atendimento.concluido` não pode queimar o crédito duas vezes.
model PackageCreditUsage {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  purchaseId String @map("purchase_id") @db.Uuid

  attendanceId  String  @map("attendance_id") @db.Uuid
  appointmentId String? @map("appointment_id") @db.Uuid
  serviceId     String  @map("service_id") @db.Uuid
  petId         String  @map("pet_id") @db.Uuid

  /// Lançamento informativo de valor zero, para o uso aparecer no extrato.
  entryId String @unique @map("entry_id") @db.Uuid

  usedAt DateTime @default(now()) @map("used_at") @db.Timestamptz(6)
  /// RN-12: anulação do atendimento devolve o crédito, respeitando a validade
  /// original — o pacote não ganha sobrevida por causa de um erro nosso.
  revertedAt DateTime? @map("reverted_at") @db.Timestamptz(6)

  purchase PackagePurchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  entry    LedgerEntry     @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@map("package_credit_usages")
}

/// Políticas financeiras do tenant. Uma linha por tenant.
///
/// `no_show_fee_percent` e `cancellation_window_hours` **não** moram aqui: vivem em
/// `tenant_settings` desde o MOD-AGENDA, e o scheduling-service já calcula a taxa com
/// eles. Duplicá-los criaria duas fontes de verdade sobre quanto se cobra de quem falta.
model BillingSettings {
  tenantId String @id @map("tenant_id") @db.Uuid

  /// RN-15: nulo **não bloqueia nada**. A política de bloqueio é opt-in por tenant.
  creditLimitCents BigInt? @map("credit_limit_cents")
  /// Dias de atraso até a tag de inadimplente.
  overdueDays      Int     @default(30) @map("overdue_days")

  /// Subconjunto de `PaymentMethod`. Vazio nunca: o tenant desliga o que não usa.
  enabledPaymentMethods PaymentMethod[] @map("enabled_payment_methods")

  defaultPackageValidityDays Int   @default(90) @map("default_package_validity_days")
  /// RN-09: avisos em D-15 e D-3 por padrão. Expiração sem aviso é falha de produto.
  packageExpiryWarningDays   Int[] @default([15, 3]) @map("package_expiry_warning_days")

  noShowConsumesPackageCredit Boolean @default(false) @map("no_show_consumes_package_credit")

  /// RN-20: o sistema emite **recibo**, não nota fiscal. O texto deixa isso explícito.
  receiptFooterText String? @map("receipt_footer_text")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("billing_settings")
}

/// RN-04 — idempotência de API.
///
/// Todo POST que move dinheiro exige `idempotencyKey`. A repetição com o **mesmo**
/// payload devolve o mesmo recurso; com payload diferente, `ERR_LEDGER_012`. Não está
/// no §4 do PRD, mas sem a tabela a regra não tem onde se apoiar: o índice único de
/// `(source_type, source_id)` cobre evento reentregue, não duplo clique no balcão.
model LedgerIdempotencyKey {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  key      String @db.Uuid
  /// Qual operação a chave cobre — a mesma chave em endpoints diferentes é uso
  /// legítimo, e tratá-la como colisão quebraria o cliente sem motivo.
  endpoint String @db.VarChar(60)
  /// SHA-256 do payload normalizado. É o que separa "repetiu" de "mudou de ideia".
  requestHash String @map("request_hash") @db.VarChar(64)
  /// Id do recurso criado na primeira vez, para a repetição devolvê-lo.
  resourceId  String @map("resource_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ledger_idempotency_keys")
}

// ─── Agendador de jobs (packages/job-scheduler) ──────────────────────────────
//
// Tabelas de **plataforma**: não têm dono de tenant e por isso não têm RLS, como
// `users`, `roles` e `permissions`. Um job varre todos os tenants por definição —
// amarrá-lo a um contexto de tenant seria negar o que ele é.

enum JobStatus {
  OK
  FAILED
  TIMEOUT
}

/// Exclusão mútua entre réplicas. Uma linha por job.
///
/// O lease vence sozinho: se o processo que o tomou morrer no meio, a próxima réplica
/// o reivindica assim que `lease_until` passar. É a propriedade que um lock em memória
/// nunca tem, e a razão de não usar `pg_advisory_lock` (que ou vive numa conexão do
/// pool, ou obriga a segurar uma transação aberta pelo job inteiro).
model JobLease {
  name       String   @id @db.VarChar(80)
  /// `servico@host#id` — é o que o log mostra quando outra réplica está com o job.
  holder     String   @db.VarChar(160)
  leasedAt   DateTime @default(now()) @map("leased_at") @db.Timestamptz(6)
  leaseUntil DateTime @map("lease_until") @db.Timestamptz(6)

  @@map("job_leases")
}

/// Histórico de execução. É a resposta a "o job rodou?" — que sem isto só o log
/// responderia, e log rotaciona.
model JobRun {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String    @db.VarChar(80)
  startedAt  DateTime  @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime  @map("finished_at") @db.Timestamptz(6)
  status     JobStatus
  /// O que o job devolveu: `{ marked: 3 }`, `{ expired: 0 }`. É o que se quer ver numa
  /// consulta de uma linha só.
  result     Json?
  error      String?

  @@index([name, startedAt(sort: Desc)], map: "idx_job_runs_name_time")
  @@map("job_runs")
}

// ─── MOD-LEDGER-08 — recibo ──────────────────────────────────────────────────

enum ReceiptStatus {
  PENDING
  ISSUED
  SENT
  CANCELLED
}

/// Comprovante de pagamento.
///
/// RN-20: é **recibo, não nota fiscal**. O PDF diz isso em letras, para não induzir o
/// tenant a achar que cumpriu obrigação fiscal municipal que não cumpriu.
model Receipt {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  tutorId   String @map("tutor_id") @db.Uuid
  paymentId String @unique @map("payment_id") @db.Uuid

  /// RN-21: sequencial por tenant e ano (`2026/000123`). Alocado na criação, dentro da
  /// transação do pagamento — recibo cancelado **não** devolve o número.
  number String @db.VarChar(20)

  /// Chave do objeto no R2. O §4 previa `document_id` apontando para o MOD-DOC; sem a
  /// tabela `documents`, um UUID para o nada seria pior que o endereço real do arquivo.
  storageKey String? @map("storage_key")

  status ReceiptStatus @default(PENDING)

  issuedAt    DateTime? @map("issued_at") @db.Timestamptz(6)
  /// Inalcançável até o MOD-NOTIF existir: não há quem envie.
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  /// Última falha de geração, para o job de reprocesso não ser cego.
  lastError String? @map("last_error")
  attempts  Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@map("receipts")
}

/// Contador de recibo por tenant e ano (RN-21).
///
/// Uma `CREATE SEQUENCE` do Postgres é global e não sabe de tenant; criar uma por
/// tenant exigiria DDL em tempo de execução. `INSERT … ON CONFLICT DO UPDATE …
/// RETURNING` é atômico numa instrução e cabe na transação do pagamento.
model ReceiptCounter {
  tenantId   String @map("tenant_id") @db.Uuid
  year       Int
  lastNumber Int    @default(0) @map("last_number")

  @@id([tenantId, year])
  @@map("receipt_counters")
}
