// PetShop AI — Núcleo de Identidade e Tenancy (MOD-IDENT).
//
// A aplicação conecta como `app_user`, papel SEM BYPASSRLS: as políticas RLS de
// `migrations/*_rls_policies` valem também para o backend (MOD-IDENT-07).
// Migrations rodam pelo `directUrl`, como owner.
//
// Objetos que o Prisma não sabe declarar — políticas RLS, triggers, papéis do
// Postgres e índices únicos parciais — vivem em SQL escrito à mão nas migrations.
// Ver `prisma/migrations/README.md` antes de rodar `prisma migrate dev`.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_MIGRATION_URL")
}

enum TenantStatus {
  PROVISIONING
  TRIAL
  /// O teste venceu sem assinatura (camada comercial, fatia 3). Só leitura, como SUSPENDED.
  TRIAL_EXPIRED
  ACTIVE
  PAST_DUE
  SUSPENDED
  TERMINATED
  PROVISIONING_FAILED
}

enum Plan {
  STARTER
  PRO
  ENTERPRISE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum WebhookEventStatus {
  /// Aplicado: o espelho local mudou.
  PROCESSED
  /// Recebido e descartado de propósito — evento que não tratamos, ou carimbo mais
  /// velho que `users.clerk_synced_at` (RN-09).
  IGNORED
  /// Chegou, era para valer e não deu. Fica para intervenção humana.
  FAILED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AuditOutcome {
  ALLOWED
  DENIED
}

/// MOD-SITE-12. Nenhum tenant sai de nulo na v1.
enum CustomDomainStatus {
  PENDING
  VERIFYING
  ACTIVE
  FAILED
}

enum WhatsappProvisioning {
  OWN_NUMBER
}

enum SecurityEventType {
  CROSS_TENANT_ATTEMPT
  PERMISSION_DENIED
  TENANT_CONTEXT_MISSING
  WEBHOOK_SIGNATURE_INVALID
  LOGIN_FAILED
  /// MOD-SEC-02 — escrita recusada por falta de segundo fator.
  MFA_REQUIRED
}

/// Um petshop. Raiz do isolamento multi-tenant.
model Tenant {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug String @unique @db.VarChar(50)
  name String @db.VarChar(120)

  legalName     String? @map("legal_name") @db.VarChar(160)
  /// CNPJ cifrado em AES-256-GCM, formato `v1:<iv>:<tag>:<ct>` (PRD §4).
  cnpjEncrypted String? @map("cnpj_encrypted")

  /// Organization correspondente no Clerk. Nulo apenas enquanto `status = PROVISIONING`:
  /// o tenant é criado localmente antes da chamada ao Clerk, para que a falha dessa
  /// chamada seja recuperável pelo job de retry (AC-03 de MOD-IDENT-01).
  clerkOrgId String? @unique @map("clerk_org_id")

  status TenantStatus @default(PROVISIONING)
  plan   Plan         @default(STARTER)

  /// Domínio próprio do site do tenant (MOD-SITE-12) — **modelado, não implementado**.
  ///
  /// A v1 serve o site em `{slug}.{dominio}`, coberto pelo certificado wildcard que o
  /// Caddy já emite por DNS-01. Domínio próprio exige `on_demand_tls` com endpoint de
  /// autorização, verificação de posse por DNS e automação da Cloudflare — frente
  /// própria, fora da v1. Os campos existem desde já para que a resolução por host
  /// nasça consultando-os e não precise mudar de forma depois.
  ///
  /// `@unique` sem índice parcial é seguro aqui: o Postgres trata NULLs como
  /// distintos, então N tenants sem domínio convivem.
  customDomain           String?             @unique @map("custom_domain") @db.VarChar(253)
  customDomainStatus     CustomDomainStatus? @map("custom_domain_status")
  customDomainVerifiedAt DateTime?           @map("custom_domain_verified_at") @db.Timestamptz(6)

  trialEndsAt DateTime? @map("trial_ends_at") @db.Timestamptz(6)

  onboardingStep         Int       @default(1) @map("onboarding_step") @db.SmallInt
  onboardingCompletedAt  DateTime? @map("onboarding_completed_at") @db.Timestamptz(6)
  onboardingStartedAt    DateTime  @default(now()) @map("onboarding_started_at") @db.Timestamptz(6)
  /// Etapas puladas pelo admin (AC-03 de MOD-IDENT-02); vai no payload de
  /// `tenant.onboarding.concluido`.
  onboardingStepsSkipped Int[]     @default([]) @map("onboarding_steps_skipped")

  /// Chave de idempotência do provisionamento (AC-03 de MOD-IDENT-01).
  provisioningKey       String  @unique @map("provisioning_key")
  provisioningAttempts  Int     @default(0) @map("provisioning_attempts") @db.SmallInt
  provisioningLastError String? @map("provisioning_last_error")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  settings          TenantSettings?
  subscription      TenantSubscription?
  billingSettings   BillingSettings?
  taxiSettings      TaxiSettings?
  messagingSettings MessagingSettings?
  whatsappInstance  WhatsappInstance?
  siteSettings      SiteSettings?
  memberships       Membership[]
  invitations       Invitation[]
  roleOverrides     TenantRoleOverride[]
  dataKey           DataKey?

  messages              Message[]
  messageTemplates      MessageTemplate[]
  messagingSuppressions MessagingSuppression[]
  automations           Automation[]
  campaigns             Campaign[]
  campaignRuns          CampaignRun[]
  campaignTargets       CampaignTarget[]

  sitePhotos SitePhoto[]
  siteLeads  SiteLead[]

  portalChallenges     PortalLinkChallenge[]
  portalContactChanges PortalContactChange[]
  deletionRequests     DataDeletionRequest[]

  documents    Document[]
  termVersions TermVersion[]

  /// MOD-ADMIN-02: os acessos de suporte que este estabelecimento autorizou.
  supportGrants SupportAccessGrant[]

  /// MOD-AI: as conversas que chegaram pelo WhatsApp do estabelecimento.
  agentConversations AgentConversation[]
  agentSettings      AgentSettings?

  @@index([status])
  @@map("tenants")
}

/// Configurações operacionais e identidade visual (MOD-IDENT-08).
model TenantSettings {
  tenantId String @id @map("tenant_id") @db.Uuid

  timezone String @default("America/Sao_Paulo")

  /// Decisão de negócio: 24 horas de antecedência para cancelamento sem no-show.
  cancellationWindowHours Int @default(24) @map("cancellation_window_hours") @db.SmallInt
  noShowFeePercent        Int @default(0) @map("no_show_fee_percent") @db.SmallInt
  minBookingNoticeHours   Int @default(2) @map("min_booking_notice_hours") @db.SmallInt

  allowOverbooking              Boolean @default(false) @map("allow_overbooking")
  onlineBookingEnabled          Boolean @default(true) @map("online_booking_enabled")
  /// Decisão de negócio 8: agendamento online entra **CONFIRMED** por padrão. Quem
  /// quiser triar liga isto, e aí a solicitação do Portal vira PENDING com reserva
  /// de 24h (AC-03 de MOD-AGENDA-06).
  onlineBookingRequiresApproval Boolean @default(false) @map("online_booking_requires_approval")
  /// MOD-PORTAL, RN-15: desligar o agendamento online **não** é desligar o Portal.
  /// São duas chaves, porque um petshop com a agenda cheia ainda quer que o tutor veja
  /// o histórico e a conta.
  portalEnabled                 Boolean @default(true) @map("portal_enabled")

  /// `{ logoUrl, primaryColor, secondaryColor }`
  branding      Json
  /// Grade semanal: `{ monday: { closed, opensAt, closesAt }, ... }`
  businessHours Json @map("business_hours")

  /// Decisão de negócio: cada tenant conecta o próprio número via BSP oficial.
  whatsappProvisioning WhatsappProvisioning @default(OWN_NUMBER) @map("whatsapp_provisioning")

  /// Endereço público do estabelecimento (MOD-SITE-02).
  ///
  /// **Não é cifrado, ao contrário de `tutor_addresses`.** O do tutor é residencial e
  /// é dado pessoal; este é comercial e existe para ser publicado — no site, no mapa,
  /// no cabeçalho do recibo e no JSON-LD que o buscador lê. Cifrar dado destinado à
  /// página pública seria cerimônia sem proteção.
  ///
  /// Os seis campos obrigatórios do endereço andam juntos: ou todos preenchidos, ou
  /// todos nulos. Quem garante isso é o CHECK `tenant_settings_address_complete`.
  addressZip        String? @map("address_zip") @db.VarChar(8)
  addressStreet     String? @map("address_street") @db.VarChar(120)
  addressNumber     String? @map("address_number") @db.VarChar(10)
  addressComplement String? @map("address_complement") @db.VarChar(60)
  addressDistrict   String? @map("address_district") @db.VarChar(80)
  addressCity       String? @map("address_city") @db.VarChar(80)
  addressState      String? @map("address_state") @db.Char(2)

  /// Reservados para o "como chegar" com mapa embutido. Ficam vazios na v1: não há
  /// geocodificação nem chave de API de mapas, e o botão é montado do endereço
  /// textual (AC-02 de MOD-SITE-02).
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  /// Telefone e WhatsApp **de exibição**, distintos do número que o MOD-CRM usa para
  /// disparar (AC-04 de MOD-SITE-02). Amarrar os dois obrigaria a operação a escolher
  /// entre disparar e atender pelo mesmo aparelho.
  publicPhone    String? @map("public_phone") @db.VarChar(20)
  publicWhatsapp String? @map("public_whatsapp") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

/// Espelho local do usuário do Clerk. Tabela GLOBAL: um usuário pode pertencer a
/// N tenants (RN-01), então não tem `tenant_id` e não tem RLS.
model User {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId String @unique @map("clerk_user_id")

  /// PII cifrada. A busca usa `emailHash`, nunca LIKE sobre o texto cifrado.
  emailEncrypted String  @map("email_encrypted")
  emailHash      String  @unique @map("email_hash")
  fullName       String  @map("full_name") @db.VarChar(120)
  phoneEncrypted String? @map("phone_encrypted")
  avatarUrl      String? @map("avatar_url")

  mfaEnabled Boolean    @default(false) @map("mfa_enabled")
  status     UserStatus @default(ACTIVE)

  /// RN-09: só aplica webhook do Clerk cujo `updated_at` seja posterior a este valor.
  clerkSyncedAt DateTime? @map("clerk_synced_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships Membership[]
  /// MOD-NOTIF-01: o que o produto mandou a esta pessoa **como membro da equipe**.
  messages    Message[]
  /// MOD-ADMIN-01: o vínculo com a plataforma, que não é membership de tenant nenhum.
  platformAdmin PlatformAdmin[]
  /// MOD-ADMIN-02: os acessos de suporte que esta pessoa pediu.
  supportGrants SupportAccessGrant[]
  /// Os preços de plano que esta pessoa mexeu por último.
  planPrices    PlanPrice[]

  @@map("users")
}

/// O evento de webhook já recebido (MOD-IDENT-03).
///
/// **Sem `tenant_id`, e portanto fora do RLS**, como `users`: o webhook do Clerk chega
/// antes de se saber de que estabelecimento ele fala, e alguns eventos — `user.updated`
/// à frente — não falam de nenhum.
///
/// A tabela existe por uma razão só: a idempotência da RN-09. O provedor reentrega o
/// que não recebe 2xx depressa, e reaplicar um `user.updated` é inócuo, mas reaplicar
/// um `organizationMembership.deleted` depois de alguém ter sido reativado à mão
/// desfaria a reativação. Quem garante a unicidade é a **constraint**, e não uma
/// leitura antes da escrita: duas entregas do mesmo evento chegam juntas.
///
/// `status` guarda o desfecho, e por isso o expurgo não a resume a um log: `FAILED` é
/// o que a regra `clerk_webhook_failing` conta no painel da plataforma, e é a única
/// pista de uma colisão de e-mail (RN-12), que só resolve à mão.
model WebhookEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// `clerk`. Coluna e não enum porque o próximo provedor a precisar de idempotência
  /// entra sem migration de tipo.
  provider String @db.VarChar(20)

  /// O `svix-id` do cabeçalho — a identidade que o provedor dá à entrega.
  externalEventId String @map("external_event_id") @db.VarChar(80)

  eventType String @map("event_type") @db.VarChar(60)

  status WebhookEventStatus @default(PROCESSED)

  /// O motivo, quando `FAILED`. Curto e sem PII: "e-mail já pertence a outro usuário",
  /// nunca o endereço.
  error String? @db.VarChar(300)

  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  @@unique([provider, externalEventId])
  @@index([provider, status, receivedAt(sort: Desc)])
  @@map("webhook_events")
}

/// O papel de plataforma (MOD-ADMIN-01).
///
/// **Sem `tenant_id`, e portanto fora do RLS.** É a diferença que define a tabela: o
/// papel é da equipe PetShop AI, não de um estabelecimento, e uma política por tenant
/// esconderia a linha de quem precisa lê-la para resolver a própria sessão. Fica ao lado
/// de `users` e do catálogo global, e **não** entra em `RLS_MODELS`.
///
/// Revogação é soft e a unicidade é parcial (`idx_platform_admins_vivo`, na migration):
/// conceder de novo a quem já foi revogado é o caminho normal, e o que não pode existir
/// é a segunda linha viva.
model PlatformAdmin {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// Nulo só na linha de bootstrap: não havia quem concedesse.
  grantedBy String?  @map("granted_by") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy String?   @map("revoked_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("platform_admins")
}

/// A autorização do estabelecimento para o suporte ler o dado dele (MOD-ADMIN-02).
///
/// **Tem `tenant_id`, ao contrário de `platform_admins`** — e a diferença é o ponto: o
/// papel de plataforma é da equipe PetShop AI; o grant é do estabelecimento que autoriza.
/// É ele quem precisa vê-lo na própria tela, e por isso a tabela entra no RLS como
/// qualquer outra de negócio.
///
/// `reason` fica **em claro**: é o que o admin do petshop lê para decidir se aprova. É o
/// único campo do módulo que precisa ser legível, e não descreve o titular — descreve o
/// chamado.
model SupportAccessGrant {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  adminUserId String @map("admin_user_id") @db.Uuid
  reason      String @db.VarChar(300)

  status SupportGrantStatus @default(REQUESTED)

  approvedBy String?   @map("approved_by") @db.Uuid
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(6)
  /// Preenchido na aprovação, nunca no pedido: quem define o prazo é quem autoriza.
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)

  revokedBy String?   @map("revoked_by") @db.Uuid
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  admin  User   @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("support_access_grants")
}

enum SupportGrantStatus {
  REQUESTED
  ACTIVE
  DENIED
  EXPIRED
  REVOKED
}

/// A série temporal das métricas que o produto já emite (MOD-ADMIN-05).
///
/// **Fora do RLS, apesar de ter `tenant_id`** — e a exceção é declarada em
/// `PLATFORM_MODELS` no teste de sincronia. A coluna aqui não é dono: é **rótulo de
/// agregação**. A linha não pertence ao estabelecimento, pertence à plataforma, que
/// precisa somar todos os tenants numa consulta só; e `tenant_id` nulo é a métrica que
/// nasce sem tenant (`mfa_claim_missing`), que política nenhuma por tenant alcançaria.
///
/// Nenhum dado pessoal entra aqui: são contagens, e é por isso que a retenção é longa.
model PlatformMetric {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// O nome que `recordMetric` emite. Sem catálogo fechado de propósito: métrica nova
  /// aparece na série no primeiro roll-up, sem migration.
  metric String @db.VarChar(60)

  /// Nulo é métrica de plataforma, e a ausência é informação — não erro.
  tenantId String? @map("tenant_id") @db.Uuid

  /// Início da janela.
  bucket     DateTime         @map("bucket") @db.Timestamptz(6)
  resolution MetricResolution

  /// `sum` e `count` são o que se soma entre réplicas (RN-09); `p95` é o que não se
  /// soma, e por isso o merge fica com o maior dos dois — aproximação declarada.
  sum   Decimal @db.Decimal(18, 4)
  count Int
  min   Decimal @db.Decimal(18, 4)
  max   Decimal @db.Decimal(18, 4)
  p95   Decimal @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([metric, bucket(sort: Desc)], map: "idx_metrics_consulta")
  @@map("platform_metrics")
}

enum MetricResolution {
  FIVE_MIN
  DAY
}

/// O estado de cada regra de alerta (MOD-ADMIN-06).
///
/// Fora do RLS pela mesma razão da série: `tenant_id` diz **sobre quem** é o alerta, não
/// de quem é a linha. Quem responde por um alerta é a plataforma.
///
/// `PENDING` é o estado que o §6 do PRD não desenha, e ele existe por uma razão de
/// operação: a regra só dispara quando a condição vale em **duas** avaliações seguidas, e
/// o contador precisa sobreviver a deploy e a troca de réplica. Guardado em memória, ele
/// zeraria a cada subida — e com três réplicas revezando o lease do job, nunca chegaria a
/// dois.
model PlatformAlert {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  rule     String  @db.VarChar(60)
  tenantId String? @map("tenant_id") @db.Uuid

  status PlatformAlertStatus @default(PENDING)

  /// O valor medido na última avaliação — a profundidade da fila, o número de horas
  /// paradas. É o que a notificação carrega.
  value Decimal @db.Decimal(18, 4)

  /// Avaliações seguidas com e sem a condição. Uma zera a outra.
  breachStreak Int @default(1) @map("breach_streak")
  clearStreak  Int @default(0) @map("clear_streak")

  firstSeenAt     DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastEvaluatedAt DateTime  @default(now()) @map("last_evaluated_at") @db.Timestamptz(6)
  firedAt         DateTime? @map("fired_at") @db.Timestamptz(6)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, firedAt(sort: Desc)], map: "idx_alerts_abertos")
  @@map("platform_alerts")
}

enum PlatformAlertStatus {
  PENDING
  FIRING
  RESOLVED
}

/// Vínculo usuário ↔ tenant com papel (MOD-IDENT-05).
model Membership {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  roleKey  String @map("role_key")

  status         MembershipStatus @default(ACTIVE)
  /// RN-06: papéis operacionais têm espelho em `professionals` (MOD-AGENDA).
  isProfessional Boolean          @default(false) @map("is_professional")

  /// RN-03: incrementa a cada troca de papel. O gateway compara com o claim
  /// `permVersion` do token e força refresh na divergência.
  permVersion Int @default(1) @map("perm_version")

  invitedBy String?  @map("invited_by") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  /// MOD-SEC-03 — fim da carência para ligar o segundo fator.
  ///
  /// Não-nulo apenas em membership `TENANT_ADMIN`, o único papel a que a exigência se
  /// aplica (RN-01). É escrito quando o **papel** é atribuído, e não quando a pessoa
  /// entra: uma recepcionista promovida a administradora em março tem `joined_at` de
  /// janeiro, e derivar o prazo dali a barraria no instante em que ganhou o papel.
  ///
  /// Ligar o MFA não limpa a coluna — ela registra o prazo que foi concedido, e
  /// desligar o segundo fator depois não devolve prazo nenhum.
  mfaGraceUntil DateTime? @map("mfa_grace_until") @db.Timestamptz(6)

  /// Até quando esta pessoa já viu os agendamentos marcados pelo tutor no Portal.
  ///
  /// A única coluna de "lido" do produto, e ela é por **vínculo** e não por usuário:
  /// quem atende dois estabelecimentos tem duas caixas de entrada, e uma marca global
  /// faria a visita ao primeiro apagar o aviso do segundo.
  ///
  /// Nula é quem nunca abriu o sino. O contador não a lê como "desde sempre" — a
  /// janela de novidade tem teto próprio (ver `countNewPortalBookings`), senão a
  /// primeira abertura de um estabelecimento antigo mostraria a agenda inteira.
  portalBookingsSeenAt DateTime? @map("portal_bookings_seen_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleKey], references: [key])

  @@index([userId])
  @@index([tenantId, roleKey])
  @@map("memberships")
}

/// Papéis de sistema. Global, sem `tenant_id` — o tenant ajusta permissões via
/// `TenantRoleOverride`, não criando papéis próprios (questão 2 do PRD §11).
model Role {
  key      String  @id
  label    String
  isSystem Boolean @default(true) @map("is_system")

  permissions RolePermission[]
  memberships Membership[]

  @@map("roles")
}

/// Permissão granular no formato `recurso:acao`.
model Permission {
  key         String @id
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleKey       String @map("role_key")
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleKey], references: [key], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleKey, permissionKey])
  @@map("role_permissions")
}

/// Ajuste da matriz padrão por tenant: `granted = false` revoga, `true` concede.
model TenantRoleOverride {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  roleKey       String  @map("role_key")
  permissionKey String  @map("permission_key")
  granted       Boolean

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleKey, permissionKey])
  @@map("tenant_role_overrides")
}

/// MOD-IDENT-06 — tabela criada nesta fase para fixar o modelo e a política RLS.
/// Os endpoints de convite ainda não existem.
model Invitation {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  emailEncrypted String @map("email_encrypted")
  emailHash      String @map("email_hash")
  roleKey        String @map("role_key")

  /// SHA-256 do token; o token cru nunca é persistido.
  tokenHash String           @map("token_hash")
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)

  invitedBy  String?   @map("invited_by") @db.Uuid
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

/// MOD-IDENT-09 — append-only. `UPDATE` e `DELETE` são bloqueados por trigger
/// e por REVOKE na migration de RLS.
model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Nulo em ações de plataforma — visíveis apenas pela role `app_maintenance`.
  tenantId    String? @map("tenant_id") @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid

  action   String
  entity   String
  entityId String?      @map("entity_id")
  before   Json?
  after    Json?
  outcome  AuditOutcome @default(ALLOWED)

  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([entity, entityId, createdAt(sort: Desc)])
  /// MOD-SEC-04 — o filtro por ator da trilha.
  @@index([tenantId, actorUserId, createdAt(sort: Desc)])
  /// MOD-SEC-08 — o expurgo varre por data **sem** tenant: ele é cross-tenant por
  /// definição, e um índice que começa por tenant não serve a essa varredura.
  @@index([createdAt])
  @@map("audit_logs")
}

/// Eventos de segurança (MOD-SEC). Criado aqui porque MOD-IDENT-07 AC-02 exige
/// registrar `CROSS_TENANT_ATTEMPT`.
model SecurityEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId    String?           @map("tenant_id") @db.Uuid
  type        SecurityEventType
  actorUserId String?           @map("actor_user_id") @db.Uuid

  targetEntity String? @map("target_entity")
  targetId     String? @map("target_id")

  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")
  metadata  Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  /// MOD-SEC-08 — o expurgo, pela mesma razão de `audit_logs`.
  @@index([createdAt])
  @@map("security_events")
}

/// DEK por tenant, cifrada pela KEK mestra (envelope encryption, PRD §4).
/// A chave de plataforma — usada por `users`, que é tabela global — não fica aqui:
/// é derivada da KEK por HKDF, ver `src/crypto.ts`.
model DataKey {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  /// DEK cifrada pela KEK, no mesmo formato `v1:<iv>:<tag>:<ct>`.
  encryptedDek String @map("encrypted_dek")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("data_keys")
}

// ═══════════════════════════════════════════════════════════════════════════
// MOD-TUTOR — Cadastro e gestão de tutores (PRD tutores_02 §4)
// ═══════════════════════════════════════════════════════════════════════════

enum PersonType {
  PF
  PJ
}

enum TutorStatus {
  ACTIVE
  INACTIVE
  /// Terminal: origem de um merge, aponta `merged_into_id`.
  MERGED
  /// Terminal e irreversível: pedido do titular (LGPD art. 18).
  ANONYMIZED
}

enum DataCompleteness {
  COMPLETE
  PARTIAL
}

enum ConsentChannel {
  WHATSAPP
  EMAIL
  SMS
  TERMS
  /// MOD-DOC-07 — o termo de responsabilidade e ciência de riscos.
  SERVICE_LIABILITY
  IMAGE_USE
}

enum ConsentPurpose {
  TRANSACTIONAL
  MARKETING
  BOTH
}

enum ConsentSource {
  STAFF_FORM
  PORTAL
  SITE
  WHATSAPP
  IMPORT
  /// O provedor de e-mail informou que a pessoa marcou a mensagem como spam
  /// (AC-02 de MOD-NOTIF-10). É a única origem que não é um gesto numa tela nossa.
  PROVIDER
}

/// O cliente pagante e titular dos dados pessoais.
///
/// CPF, CNPJ, telefones e e-mail ficam cifrados com a DEK do tenant; as colunas
/// `*_hash` (HMAC-SHA256 com pepper) é que sustentam unicidade e busca exata —
/// `LIKE` sobre texto cifrado não existe. `full_name` fica em claro, decisão
/// consciente do PRD §4 para viabilizar a busca por similaridade no balcão.
model Tutor {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  personType PersonType @default(PF) @map("person_type")

  fullName   String  @map("full_name") @db.VarChar(160)
  /// Razão social (PJ).
  legalName  String? @map("legal_name") @db.VarChar(160)
  /// RN-14: quando preenchido, é o nome exibido em telas e comunicações.
  socialName String? @map("social_name") @db.VarChar(120)

  cpfEncrypted  String? @map("cpf_encrypted")
  cpfHash       String? @map("cpf_hash")
  cnpjEncrypted String? @map("cnpj_encrypted")
  cnpjHash      String? @map("cnpj_hash")

  /// E.164. Obrigatório: é o canal primário e a chave do agente de IA (RN-03).
  phoneEncrypted    String  @map("phone_encrypted")
  phoneHash         String  @map("phone_hash")
  phoneAltEncrypted String? @map("phone_alt_encrypted")
  phoneAltHash      String? @map("phone_alt_hash")

  emailEncrypted String? @map("email_encrypted")
  emailHash      String? @map("email_hash")

  birthDate DateTime? @map("birth_date") @db.Date
  notes     String?

  status           TutorStatus      @default(ACTIVE)
  dataCompleteness DataCompleteness @default(PARTIAL) @map("data_completeness")

  /// RN-13 — vínculo com o login do Portal (MOD-PORTAL).
  ///
  /// Preenchido pelo `portal-bff` quando o tutor prova, por código, ser dono do
  /// telefone ou do e-mail da ficha. Um tutor, um login: o índice único **parcial**
  /// `idx_tutors_portal_user` é quem garante isso (RN-05), e não uma checagem no
  /// código — trocar o vínculo é operação de equipe, auditada.
  portalUserId     String?   @map("portal_user_id") @db.Uuid
  /// Quando o vínculo nasceu. O `portal_user_id` sozinho não conta essa história.
  portalLinkedAt   DateTime? @map("portal_linked_at") @db.Timestamptz(6)
  /// Alimenta a métrica de adoção e a decisão de continuar mandando WhatsApp para
  /// quem nunca abre o Portal.
  portalLastSeenAt DateTime? @map("portal_last_seen_at") @db.Timestamptz(6)
  /// Destino do merge, quando `status = MERGED`.
  mergedIntoId     String?   @map("merged_into_id") @db.Uuid

  /// Mantido pelo trigger `tutors_search_trigger`; a aplicação nunca escreve aqui.
  searchVector Unsupported("tsvector")? @map("search_vector")

  /// RN-10: escrito pelo consumo de `atendimento.concluido`, nunca calculado na
  /// listagem. Alimenta a tag automática INATIVO.
  lastAttendanceAt DateTime? @map("last_attendance_at") @db.Timestamptz(6)

  /// Denormalizados pelo mesmo motivo do RN-10: a listagem de balcão tem SLO de
  /// 300ms e não pode agregar outros serviços por linha.
  /// TODO(MOD-LEDGER): alimentar por `lancamento.criado`.
  balanceCents Int @default(0) @map("balance_cents")
  /// TODO(MOD-PET): alimentar por `pet.criado` / `pet.vinculado`.
  petsCount    Int @default(0) @map("pets_count")

  anonymizedAt DateTime? @map("anonymized_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  addresses      TutorAddress[]
  consents       TutorConsent[]
  tagAssignments TutorTagAssignment[]

  petTutors PetTutor[]

  appointments   Appointment[]
  taxiRides      TaxiRide[]
  attendances    Attendance[]
  ledgerAccounts LedgerAccount[]
  messages       Message[]

  campaignTargets CampaignTarget[]

  portalChallenges     PortalLinkChallenge[]
  portalContactChanges PortalContactChange[]
  deletionRequests     DataDeletionRequest[]

  agentConversations AgentConversation[]

  mergedInto Tutor?  @relation("TutorMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom Tutor[] @relation("TutorMerge")

  @@map("tutors")
}

/// Um principal + N adicionais. Logradouro cifrado: endereço residencial é dado
/// sensível à segurança física do titular (PRD §4).
model TutorAddress {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tutorId  String @map("tutor_id") @db.Uuid

  label   String @default("Casa") @db.VarChar(40)
  zipCode String @map("zip_code") @db.VarChar(8)

  streetEncrypted     String  @map("street_encrypted")
  numberEncrypted     String  @map("number_encrypted")
  complementEncrypted String? @map("complement_encrypted")

  district String @db.VarChar(80)
  city     String @db.VarChar(80)
  state    String @db.VarChar(2)

  /// Geocodificação para a roteirização do Taxi Dog (MOD-TAXI).
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  /// "Portão azul, chamar no interfone 12".
  accessNotes String? @map("access_notes")

  /// RN-15: exatamente um por tutor, garantido por índice único parcial.
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@map("tutor_addresses")
}

/// Tag de segmentação. `is_system = true` são mantidas por evento, nunca à mão.
model TutorTag {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  key      String  @db.VarChar(40)
  label    String  @db.VarChar(60)
  color    String  @default("#E34A32") @db.VarChar(9)
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignments TutorTagAssignment[]

  @@map("tutor_tags")
}

model TutorTagAssignment {
  tenantId String @map("tenant_id") @db.Uuid
  tutorId  String @map("tutor_id") @db.Uuid
  tagId    String @map("tag_id") @db.Uuid

  /// Nulo quando a atribuição foi automática.
  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  tutor Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  tag   TutorTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tutorId, tagId])
  @@index([tagId])
  @@map("tutor_tag_assignments")
}

/// RN-05 — append-only. Revogar nunca apaga o opt-in anterior: o histórico é a
/// prova do tenant perante a ANPD. `UPDATE`/`DELETE` barrados por trigger.
model TutorConsent {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tutorId  String @map("tutor_id") @db.Uuid

  channel ConsentChannel
  granted Boolean
  purpose ConsentPurpose @default(MARKETING)
  /// Versão do termo aceito nesta transição.
  version String         @db.VarChar(20)
  source  ConsentSource  @default(STAFF_FORM)

  /// Prova do consentimento (PRD §4).
  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")

  /// O papel do aceite (MOD-DOC-07 e 08). Nulo nos canais de contato e no `TERMS`,
  /// que não arquivam documento, e nas linhas anteriores ao MOD-DOC.
  ///
  /// Preenchido **no INSERT**, nunca depois: a tabela é append-only por trigger, e uma
  /// coluna que precisasse de UPDATE para chegar ao valor certo não caberia nela.
  documentId String? @unique @map("document_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tutor    Tutor     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@map("tutor_consents")
}

/// Snapshot pré-merge dos dois cadastros. Guardado porque o merge não é reversível
/// automaticamente (questão 5 do PRD §11) — é o que permite reverter à mão.
model TutorMergeLog {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  sourceId String @map("source_id") @db.Uuid
  targetId String @map("target_id") @db.Uuid

  snapshot      Json
  /// `{ pets: [...], ledgerEntries: [...], appointments: [...] }`
  movedEntities Json @map("moved_entities")

  performedBy String?  @map("performed_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("tutor_merge_log")
}

// ═══════════════════════════════════════════════════════════════════════════
// MOD-PET — Cadastro de pets e tabelas de domínio (PRD pets_03 §4)
// ═══════════════════════════════════════════════════════════════════════════

enum PetSex {
  MALE
  FEMALE
  UNKNOWN
}

enum PetStatus {
  ACTIVE
  INACTIVE
  DECEASED
  /// Terminal no tenant de origem.
  TRANSFERRED_OUT
}

/// AC-03 de MOD-PET-01: o pet resgatado entra com idade estimada, e a tela precisa
/// saber a diferença — "2 anos" e "≈ 2 anos" mudam a conduta clínica.
enum BirthDatePrecision {
  EXACT
  ESTIMATED
  UNKNOWN
}

/// Motivo da transferência de titularidade (MOD-PET-05). Não é campo livre: é o que
/// separa "adotado" de "erro de cadastro" no relatório e na conversa com o tutor.
enum TransferReason {
  ADOPTION
  SALE
  TUTOR_DEATH
  CORRECTION
  OTHER
}

/// De onde a foto veio. `GROOMING_RESULT` é a foto pós-tosa que o MOD-CRM manda ao
/// tutor; separá-la de uma foto qualquer do álbum é o que impede mandar a foto errada.
enum PhotoSource {
  STAFF
  TUTOR
  GROOMING_RESULT
}

enum PetTutorRole {
  PRIMARY
  SECONDARY
}

/// Espécie. `tenant_id` nulo é catálogo global, somente leitura para o tenant (RN-02).
model Species {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid

  key       String  @db.VarChar(40)
  label     String  @db.VarChar(60)
  /// Não está no PRD: sem ele "Outros" apareceria no meio da lista, em ordem
  /// alfabética. A ordenação do seletor é decisão de produto, não do acaso.
  sortOrder Int     @default(0) @map("sort_order") @db.SmallInt
  active    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  breeds Breed[]
  pets   Pet[]

  @@map("species")
}

/// Raça. O catálogo global cobre o comum; o tenant acrescenta o que faltar.
model Breed {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String? @map("tenant_id") @db.Uuid
  speciesId String  @map("species_id") @db.Uuid

  label           String @db.VarChar(80)
  /// Minúsculo e sem acento, para o dedupe do AC-03 de MOD-PET-03.
  normalizedLabel String @map("normalized_label") @db.VarChar(80)

  /// Sugestão de porte ao selecionar a raça; a recepção pode trocar.
  defaultSizeId String? @map("default_size_id") @db.Uuid
  groomingNotes String? @map("grooming_notes")
  active        Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  species     Species           @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  defaultSize Size?             @relation(fields: [defaultSizeId], references: [id], onDelete: SetNull)
  pets        Pet[]
  visibility  BreedVisibility[]

  @@index([speciesId])
  @@map("breeds")
}

/// Porte. RN-03: insumo direto do preço e da duração do serviço.
model Size {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid

  key   String @db.VarChar(40)
  label String @db.VarChar(60)

  /// Faixa de referência do AC-04: fora dela o cadastro avisa, nunca bloqueia.
  weightMinKg Decimal @map("weight_min_kg") @db.Decimal(5, 2)
  weightMaxKg Decimal @map("weight_max_kg") @db.Decimal(5, 2)

  sortOrder Int     @default(0) @map("sort_order") @db.SmallInt
  active    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  pets           Pet[]
  breeds         Breed[]
  servicePricing ServicePricing[]

  @@map("sizes")
}

/// Pelagem. RN-03: `grooming_time_factor` multiplica a duração base do serviço.
model Coat {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid

  key   String @db.VarChar(40)
  label String @db.VarChar(60)

  groomingTimeFactor Decimal @default(1.00) @map("grooming_time_factor") @db.Decimal(3, 2)

  sortOrder Int     @default(0) @map("sort_order") @db.SmallInt
  active    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  pets Pet[]

  @@map("coats")
}

/// O paciente. A agenda é dele, o prontuário é dele, e o preço do banho depende do
/// porte e da pelagem dele.
///
/// `microchip` e `notes` ficam cifrados com a DEK do tenant (PRD §4). Como o
/// AES-GCM é não determinístico, a unicidade do microchip por tenant se apoia em
/// `microchip_hash` — mesmo par cifra/hash que o MOD-TUTOR usa para CPF e telefone.
model Pet {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name String @db.VarChar(60)

  speciesId String  @map("species_id") @db.Uuid
  /// Nulo é legítimo: "SRD" é raça do catálogo, mas nem todo cadastro sabe a raça.
  breedId   String? @map("breed_id") @db.Uuid
  sizeId    String  @map("size_id") @db.Uuid
  coatId    String? @map("coat_id") @db.Uuid

  sex PetSex @default(UNKNOWN)

  birthDate          DateTime?          @map("birth_date") @db.Date
  birthDatePrecision BirthDatePrecision @default(UNKNOWN) @map("birth_date_precision")

  /// RN-10: reflete sempre a pesagem mais recente; a série vive em `pet_weights`.
  weightKg Decimal? @map("weight_kg") @db.Decimal(5, 2)
  neutered Boolean?

  microchipEncrypted String? @map("microchip_encrypted")
  microchipHash      String? @map("microchip_hash")

  color String? @db.VarChar(40)

  /// FK "solta" de propósito: a capa é uma das linhas de `pet_photos`, e uma FK real
  /// criaria um ciclo (foto → pet → foto) que complica exclusão e seed. A consistência
  /// é garantida no serviço, que só grava id de foto viva do próprio pet.
  coverPhotoId String? @map("cover_photo_id") @db.Uuid

  status             PetStatus @default(ACTIVE)
  deceasedAt         DateTime? @map("deceased_at") @db.Date
  /// AC-03 de MOD-PET-08 conta 30 dias a partir do **registro**, não da data do
  /// óbito: o tutor comunica dias depois, e a janela de correção é do lançamento.
  deceasedRecordedAt DateTime? @map("deceased_recorded_at") @db.Timestamptz(6)

  notesEncrypted String? @map("notes_encrypted")

  /// Mantido pelo trigger `pets_search_trigger`; a aplicação nunca escreve aqui.
  searchVector Unsupported("tsvector")? @map("search_vector")

  /// Escrito pelo consumo de `atendimento.concluido`. Denormalizado porque a
  /// listagem tem SLO de 300ms e o RN-10 proíbe calcular na hora.
  lastAttendanceAt DateTime? @map("last_attendance_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  species Species @relation(fields: [speciesId], references: [id])
  breed   Breed?  @relation(fields: [breedId], references: [id])
  size    Size    @relation(fields: [sizeId], references: [id])
  coat    Coat?   @relation(fields: [coatId], references: [id])

  petTutors PetTutor[]
  weights   PetWeight[]
  transfers PetTransferLog[]
  photos    PetPhoto[]

  appointments  Appointment[]
  taxiRides     TaxiRide[]
  prescriptions Prescription[]
  messages      Message[]

  allergies     Allergy[]
  temperaments  Temperament[]
  medicalAlerts MedicalAlert[]
  attendances   Attendance[]

  @@map("pets")
}

/// Vínculo N:N com papel (MOD-PET-02). RN-04: exatamente um PRIMARY ativo por pet,
/// garantido por índice único parcial.
///
/// O vínculo é encerrado com `unlinked_at`, não apagado: quem autorizou um
/// procedimento ano passado precisa continuar rastreável depois da transferência.
model PetTutor {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  petId    String @map("pet_id") @db.Uuid
  tutorId  String @map("tutor_id") @db.Uuid

  role         PetTutorRole @default(SECONDARY)
  relationship String?      @db.VarChar(40)

  canAuthorizeProcedures Boolean @default(true) @map("can_authorize_procedures")

  linkedAt   DateTime  @default(now()) @map("linked_at") @db.Timestamptz(6)
  unlinkedAt DateTime? @map("unlinked_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  pet   Pet   @relation(fields: [petId], references: [id], onDelete: Cascade)
  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@map("pet_tutors")
}

/// Série de pesagens (MOD-PET-07). Base da dosagem clínica e do alerta do RN-11.
model PetWeight {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  petId    String @map("pet_id") @db.Uuid

  weightKg   Decimal  @map("weight_kg") @db.Decimal(5, 2)
  measuredAt DateTime @default(now()) @map("measured_at") @db.Timestamptz(6)

  /// Pesagem aferida no atendimento, preenchida pelo consumo de
  /// `atendimento.concluido`. Nulo é a pesagem avulsa, feita na balança do balcão.
  /// Serve também de chave de idempotência: o broker entrega ao menos uma vez.
  attendanceId String? @map("attendance_id") @db.Uuid
  measuredBy   String? @map("measured_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("pet_weights")
}

/// Álbum do pet (MOD-PET-04). O arquivo mora no R2; aqui ficam a referência, a
/// procedência e o que a LGPD exige saber sobre ele.
///
/// Não há URL pública: `variants` guarda **chaves de objeto**, e a URL é assinada na
/// leitura com validade de 15 minutos (RN-13). Guardar URL assinada no banco seria
/// guardar um dado que nasce vencido.
model PetPhoto {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  petId    String @map("pet_id") @db.Uuid

  /// `{ thumb, medium, full }` — chave de cada variante no bucket.
  variants Json

  caption String?     @db.VarChar(140)
  takenAt DateTime    @default(now()) @map("taken_at") @db.Timestamptz(6)
  source  PhotoSource @default(STAFF)

  /// MOD-PRONT-10: a foto de antes e depois presa ao atendimento. `attendancePhase`
  /// nulo é a foto de álbum, que não pertence a momento nenhum da execução.
  attendanceId    String?          @map("attendance_id") @db.Uuid
  attendancePhase AttendancePhase? @map("attendance_phase")

  /// RN-14: só vira material de campanha com o consentimento IMAGE_USE do tutor,
  /// conferido no momento da marcação — não no do upload.
  marketingUse Boolean @default(false) @map("marketing_use")

  sizeBytes Int    @map("size_bytes")
  mimeType  String @map("mime_type") @db.VarChar(40)

  uploadedBy String? @map("uploaded_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// O arquivo no bucket só some no `media-purge`; o soft delete tira da tela na hora.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("pet_photos")
}

// ─── MOD-PRONT — Prontuário clínico e comportamental ─────────────────────────

/// Severidade clínica, compartilhada por alergia e alerta médico. `CRITICAL` é o
/// único nível que bloqueia operação (RN-03 de prontuario_04); os demais avisam.
enum ClinicalSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AllergyType {
  FOOD
  PRODUCT
  MEDICATION
  ENVIRONMENTAL
  OTHER
}

/// Classificação comportamental (MOD-PRONT-04). `UNKNOWN` é honesto: o pet que
/// nunca foi atendido não é dócil, é desconhecido — e a equipe precisa da diferença.
enum TemperamentClassification {
  DOCILE
  ANXIOUS
  FEARFUL
  REACTIVE
  AGGRESSIVE
  UNKNOWN
}

/// Alergia e restrição (MOD-PRONT-03).
///
/// Nunca é apagada: a desativação preserva a linha com quem desativou e por quê
/// (AC-04). Uma alergia que "some" do histórico é uma informação de segurança que
/// desapareceu sem rastro — e é justamente essa que faz falta depois.
model Allergy {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  petId    String @map("pet_id") @db.Uuid

  type     AllergyType
  label    String           @db.VarChar(120)
  severity ClinicalSeverity

  /// Cifrada: detalhe clínico da reação observada (§4).
  reactionEncrypted String? @map("reaction_encrypted")

  /// Serviços que esta alergia bloqueia (RN-03). FK lógica para `services`, que
  /// vive no MOD-AGENDA — array em vez de tabela de junção porque a lista é curta
  /// e sempre lida junto com a alergia.
  blocksServices String[] @map("blocks_services") @db.Uuid
  /// Palavras-chave de produto ("shampoo neutro X"), casadas no check-out.
  blocksProducts String[] @map("blocks_products")

  diagnosedAt DateTime? @map("diagnosed_at") @db.Date
  diagnosedBy String?   @map("diagnosed_by") @db.Uuid

  active          Boolean   @default(true)
  resolutionNotes String?   @map("resolution_notes")
  deactivatedBy   String?   @map("deactivated_by") @db.Uuid
  deactivatedAt   DateTime? @map("deactivated_at") @db.Timestamptz(6)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("allergies")
}

/// Observação de temperamento (MOD-PRONT-04).
///
/// É série histórica, não campo do pet: RN-16 exige que o histórico de risco
/// sobreviva à melhora. `is_current` marca o vigente, e o índice parcial garante
/// que só exista um por pet.
model Temperament {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  petId    String @map("pet_id") @db.Uuid

  classification TemperamentClassification

  /// NAIL_TRIMMING, DRYER, MUZZLE, BATH, STRANGERS, OTHER_DOGS — em que situação.
  contexts String[]

  requiresMuzzle      Boolean @default(false) @map("requires_muzzle")
  requiresTwoHandlers Boolean @default(false) @map("requires_two_handlers")

  /// Cifrada. Obrigatória para REACTIVE e AGGRESSIVE (AC-02): "morde" sem contexto
  /// não diz à equipe o que evitar.
  notesEncrypted String? @map("notes_encrypted")

  observedBy String?  @map("observed_by") @db.Uuid
  observedAt DateTime @default(now()) @map("observed_at") @db.Timestamptz(6)

  isCurrent Boolean @default(true) @map("is_current")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("temperaments")
}

/// Condição médica ativa (MOD-PRONT-05): cardiopatia, epilepsia, idade avançada.
/// Diferente da alergia, não bloqueia serviço — instrui a execução ("não usar
/// secador quente").
model MedicalAlert {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  petId    String @map("pet_id") @db.Uuid

  condition String           @db.VarChar(120)
  severity  ClinicalSeverity

  /// Cifrada: instrução operacional que pode descrever quadro clínico.
  instructionsEncrypted String? @map("instructions_encrypted")

  active          Boolean   @default(true)
  resolutionNotes String?   @map("resolution_notes")
  deactivatedBy   String?   @map("deactivated_by") @db.Uuid
  deactivatedAt   DateTime? @map("deactivated_at") @db.Timestamptz(6)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("medical_alerts")
}

// ─── MOD-PRONT — atendimento (01, 09, 10) ────────────────────────────────────

/// Natureza do que foi feito. Não é o serviço do catálogo: um atendimento de banho
/// pode ter três itens, e o tipo é a lente pela qual o histórico se lê.
enum AttendanceType {
  GROOMING
  BATH
  VET_CONSULT
  VACCINE
  PROCEDURE
  DAYCARE
  OTHER
}

/// De onde veio o atendimento. `RETROACTIVE` é o registro lançado depois do fato,
/// pelo caminho de reparo — e existir como categoria própria é o que impede que ele
/// se confunda com o encaixe, que é atendimento de verdade sem hora marcada.
enum AttendanceOrigin {
  SCHEDULED
  WALK_IN
  RETROACTIVE
}

/// `DRAFT` nasce no check-in e vive enquanto o pet está no salão: é onde o banhista
/// anota o que viu durante a execução. `VOIDED` é terminal — anular não apaga.
enum AttendanceStatus {
  DRAFT
  COMPLETED
  VOIDED
}

/// RN-09 do prontuário: o tutor vê o que foi feito, não o que a equipe escreveu
/// entre si.
enum AttendanceNoteVisibility {
  INTERNAL
  TUTOR_VISIBLE
}

/// `ADDENDUM` é a correção versionada de um registro fechado (MOD-PRONT-09);
/// `OPERATIONAL` é a nota rápida durante a execução (MOD-PRONT-10). Vivem na mesma
/// tabela porque ambas são texto append-only preso ao atendimento, e separá-las em
/// duas tabelas duplicaria o trigger e a linha do tempo.
enum AttendanceNoteKind {
  ADDENDUM
  OPERATIONAL
}

/// Foto de antes e depois (MOD-PRONT-10). Nulo é a foto de álbum, que não pertence
/// a nenhum momento do atendimento.
enum AttendancePhase {
  BEFORE
  AFTER
}

/// O registro do que foi feito com o animal (MOD-PRONT-01).
///
/// Nasce do check-in em `DRAFT` e fecha no check-out — o serviço não o cria por
/// chamada direta, consome `atendimento.iniciado` e `atendimento.concluido`. É o
/// mesmo contrato assíncrono pelo qual o MOD-LEDGER lança o débito do mesmo evento.
///
/// A imutabilidade da RN-05 é dupla: `editable_until` é conferido na aplicação para
/// devolver um 409 explicável, e um trigger recusa a escrita no banco para o caso de
/// alguém chegar por fora dela.
model Attendance {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  petId         String  @map("pet_id") @db.Uuid
  /// Snapshot: quem respondia pelo pet no dia. A transferência de titularidade não
  /// reescreve quem autorizou o procedimento (RN-14).
  tutorId       String  @map("tutor_id") @db.Uuid
  /// Nulo só no registro de reparo lançado sem agendamento correspondente.
  appointmentId String? @map("appointment_id") @db.Uuid

  type   AttendanceType
  origin AttendanceOrigin @default(SCHEDULED)

  performedBy String @map("performed_by") @db.Uuid

  startedAt  DateTime  @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  /// Cifrada: o campo livre costuma citar o tutor ("a tutora contou que ele passou
  /// a noite no veterinário") — dado pessoal por associação (§4).
  observationsEncrypted String? @map("observations_encrypted")

  /// Pesagem do dia, repetida aqui como fato do atendimento. A série canônica
  /// continua em `pet_weights`, alimentada pelo mesmo evento.
  weightKg Decimal? @map("weight_kg") @db.Decimal(5, 2)

  status AttendanceStatus @default(DRAFT)

  /// Obrigatório quando `VOIDED` — anulação sem motivo é exclusão disfarçada.
  voidReason String?   @map("void_reason")
  voidedBy   String?   @map("voided_by") @db.Uuid
  voidedAt   DateTime? @map("voided_at") @db.Timestamptz(6)

  /// `finished_at + 24h` (RN-05). Nulo enquanto o atendimento é rascunho.
  editableUntil DateTime? @map("editable_until") @db.Timestamptz(6)

  /// Incrementa a cada adendo. É o que a linha do tempo mostra como "v2".
  version Int @default(1)

  /// Soma dos itens no momento do fechamento (RN-07).
  totalCents BigInt @default(0) @map("total_cents")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  items         AttendanceItem[]
  notes         AttendanceNote[]
  prescriptions Prescription[]

  pet         Pet          @relation(fields: [petId], references: [id], onDelete: Restrict)
  tutor       Tutor        @relation(fields: [tutorId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, petId, startedAt(sort: Desc)])
  @@index([tenantId, performedBy, startedAt(sort: Desc)])
  @@map("attendances")
}

/// Um serviço executado dentro do atendimento.
///
/// RN-07: `unit_price_cents` é fotografia, não referência. Reajuste do catálogo não
/// pode reescrever o que foi cobrado ano passado — e `label` existe pela mesma
/// razão, para o histórico sobreviver ao serviço renomeado ou excluído.
model AttendanceItem {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  attendanceId String @map("attendance_id") @db.Uuid

  serviceId String @map("service_id") @db.Uuid
  label     String @db.VarChar(120)

  /// Quem executou **este** item. Costuma ser o profissional do atendimento, mas o
  /// banho e a tosa do mesmo pet podem ser de duas pessoas.
  executedBy String @map("executed_by") @db.Uuid

  unitPriceCents  BigInt @map("unit_price_cents")
  quantity        Int    @default(1)
  totalPriceCents BigInt @map("total_price_cents")

  notes String?

  /// `[{ name, batch }]` — RN-11: o lote é o que permite rastrear a origem de uma
  /// reação alérgica que só aparece dois dias depois.
  productsUsed Json? @map("products_used")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([tenantId, attendanceId])
  @@map("attendance_items")
}

/// Adendo (MOD-PRONT-09) e nota operacional (MOD-PRONT-10).
///
/// **Append-only por trigger**, como `audit_logs` e `tutor_consents`: um adendo que
/// pode ser editado não corrige nada, só move o problema um nível acima.
model AttendanceNote {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  attendanceId String @map("attendance_id") @db.Uuid

  kind       AttendanceNoteKind
  visibility AttendanceNoteVisibility @default(INTERNAL)

  /// Cifrado pela mesma razão de `observations`: é campo livre de equipe.
  bodyEncrypted String @map("body_encrypted")

  /// A versão do atendimento no momento em que o adendo entrou.
  version Int @default(1)

  authorId  String?  @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([tenantId, attendanceId, createdAt])
  @@map("attendance_notes")
}

/// AC-02 de MOD-PET-03: o tenant não edita nem apaga raça global — esconde da lista
/// dele. A linha existir **é** o "escondido"; mostrar de volta é apagá-la.
model BreedVisibility {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  breedId  String @map("breed_id") @db.Uuid

  hiddenAt DateTime @default(now()) @map("hidden_at") @db.Timestamptz(6)
  hiddenBy String?  @map("hidden_by") @db.Uuid

  breed Breed @relation(fields: [breedId], references: [id], onDelete: Cascade)

  @@map("breed_visibility")
}

/// Histórico de titularidade (MOD-PET-05). RN-06: o prontuário nunca se move; o que
/// muda de dono é o cadastro, e esta tabela é a prova de quando e por quê.
model PetTransferLog {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  petId    String @map("pet_id") @db.Uuid

  /// Nulo só no caso improvável de transferência de pet sem responsável ativo —
  /// possível se um `tutor.anonimizado` desvinculou o último antes.
  fromTutorId String? @map("from_tutor_id") @db.Uuid
  toTutorId   String  @map("to_tutor_id") @db.Uuid

  reason TransferReason
  notes  String?

  /// A data que o tenant declara para o efeito; os vínculos mudam no commit.
  effectiveDate DateTime? @map("effective_date") @db.Date

  performedBy String?  @map("performed_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("pet_transfer_log")
}

// ─── MOD-AGENDA — catálogo de serviços, profissionais e bloqueios ────────────
// PRD agenda_operacao_06 §4, sub-features 01 a 03.

enum ServiceCategory {
  BATH
  GROOMING
  VET
  VACCINE
  /// MOD-TAXI: o serviço que ancora a cobrança da corrida. Categoria própria, e não
  /// `OTHER` com flag, porque o seletor de agendamento precisa **esconder** o taxi da
  /// lista de serviços marcáveis — corrida se pede pelo painel do Taxi Dog.
  TAXI
  OTHER
}

/// O que o petshop vende. O preço e a duração **não** ficam aqui: eles variam por
/// porte e moram em `service_pricing` (MOD-AGENDA-01).
model Service {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name        String          @db.VarChar(80)
  category    ServiceCategory
  description String?         @db.VarChar(300)

  /// Duração do porte de referência. É o valor que a UI **sugere** ao montar a
  /// tabela de preços; nunca a fonte do cálculo — ver a nota em `ServicePricing`.
  baseDurationMin Int @map("base_duration_min") @db.SmallInt

  /// Restringe a execução ao papel VET (AC-01 de MOD-AGENDA-01).
  requiresVet Boolean @default(false) @map("requires_vet")

  /// AC-03: serviço com agendamento futuro não é excluído, só desativado — some do
  /// seletor sem tocar no que já está marcado.
  active Boolean @default(true)

  /// AC-04 de MOD-SITE-05: a vitrine é subconjunto do catálogo, não espelho dele. O
  /// serviço que o petshop presta mas não quer anunciar sai da página e continua
  /// agendável no balcão. Padrão `true` — quem cadastrou um serviço quer vendê-lo.
  showOnSite Boolean @default(true) @map("show_on_site")

  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  pricing       ServicePricing[]
  professionals ProfessionalService[]

  appointmentItems AppointmentItem[]
  taxiSettings     TaxiSettings[]

  @@index([tenantId, active])
  @@map("services")
}

/// Preço **e** duração por porte.
///
/// Os dois são obrigatórios: a duração por porte é tabela, não multiplicador sobre a
/// base (decisão do §11 Q1 do PRD da agenda, que prevalece sobre o RN-03 de pets_03).
/// O petshop precisa poder dizer que banho em Golden leva 90 min sem que isso mexa em
/// nenhum outro serviço — e uma agenda que estima errado é uma agenda que mente.
///
/// A ausência de linha para um porte é significativa: o AC-02 manda devolver 422 em
/// vez de interpolar, porque preço inventado no fechamento vira briga no balcão.
model ServicePricing {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  sizeId    String @map("size_id") @db.Uuid

  /// Dinheiro é inteiro em centavos (convenção fixada a partir do PRD 05).
  priceCents  BigInt @map("price_cents")
  durationMin Int    @map("duration_min") @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  size    Size    @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  @@unique([serviceId, sizeId], map: "idx_service_pricing_unique")
  @@map("service_pricing")
}

/// Quem executa. Separado de `memberships` de propósito: existe profissional sem
/// login (o tosador que não usa o sistema) e existe membro que não atende (o
/// financeiro). O vínculo é opcional, nos dois sentidos.
model Professional {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  userId   String? @map("user_id") @db.Uuid

  displayName String @map("display_name") @db.VarChar(60)
  roleKey     String @map("role_key") @db.VarChar(30)

  /// Capacidade **simultânea**, não sequencial (decisão do §11 Q7): o banhista lava
  /// um pet, põe para secar e começa o próximo. O conflito do RN-13 é
  /// `count(sobreposições) >= este número`, e não "existe sobreposição" — é por isso
  /// que a garantia vem de transação SERIALIZABLE e não de `EXCLUDE USING GIST`.
  maxConcurrentPets Int @default(1) @map("max_concurrent_pets") @db.SmallInt

  /// Cor da coluna no painel do dia.
  color String? @db.VarChar(7)

  /// Registro no conselho regional (MOD-DOC-05).
  ///
  /// Guardado em duas colunas e impresso como uma (`12345/SP`). Sem ele a RN-10 do
  /// MOD-PRONT é inaplicável: `ERR_PRONT_009` estava no catálogo desde o prontuário e
  /// nenhuma rota conseguia levantá-lo, porque não havia onde consultar o registro.
  ///
  /// A validação é de **forma**, nunca de existência: não há base pública consultável
  /// do CFMV, e prometer verificação que não se faz é pior que não prometer.
  crmv      String? @db.VarChar(20)
  crmvState String? @map("crmv_state") @db.Char(2)

  /// AC-04: desligar alguém com agendamento futuro exige reatribuição antes.
  active Boolean @default(true)

  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  services  ProfessionalService[]
  schedules ProfessionalSchedule[]
  blocks    CalendarBlock[]

  appointments  Appointment[]
  taxiRides     TaxiRide[]
  prescriptions Prescription[]

  @@index([tenantId, active])
  @@map("professionals")
}

/// Habilitação N:N. Sem linha aqui, o profissional não aparece no seletor daquele
/// serviço — é o que impede marcar tosa com quem só dá banho.
model ProfessionalService {
  professionalId String @map("professional_id") @db.Uuid
  serviceId      String @map("service_id") @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId], map: "idx_professional_service")
  @@map("professional_services")
}

/// Uma faixa contínua de trabalho. O almoço não é um campo: é o que **parte** o dia
/// em duas linhas do mesmo `weekday` — modelar como "início, fim e intervalo" quebra
/// no dia em que alguém tiver dois intervalos.
model ProfessionalSchedule {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid

  /// 0 = domingo, 6 = sábado.
  weekday Int @db.SmallInt

  /// Minutos desde a meia-noite, no fuso do tenant. Guardar minuto e não `time`
  /// evita a armadilha de um `time` sem fuso ser comparado com `timestamptz`.
  startsAtMin Int @map("starts_at_min") @db.SmallInt
  endsAtMin   Int @map("ends_at_min") @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, weekday])
  @@map("professional_schedules")
}

/// Folga, feriado e manutenção. `professional_id` nulo é o bloqueio do tenant
/// inteiro: o feriado some da oferta de todo mundo sem precisar de uma linha por
/// pessoa (AC-03 de MOD-AGENDA-03).
model CalendarBlock {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  professionalId String? @map("professional_id") @db.Uuid

  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)

  reason String? @db.VarChar(120)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId, startsAt, endsAt], map: "idx_blocks_window")
  @@map("calendar_blocks")
}

// ─── MOD-AGENDA — agendamentos (fatia 2) ─────────────────────────────────────
// PRD agenda_operacao_06 §4 e §6.

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum AppointmentSource {
  STAFF
  PORTAL
  RECURRENCE
  AI_AGENT
  /// Encaixe: o pet chegou sem hora marcada e o agendamento nasce retroativo, já
  /// concluído, só para a agenda continuar contando a mesma história que o caixa.
  WALK_IN
}

/// Um atendimento marcado.
///
/// `ends_at` é **calculado**, nunca digitado (RN-01): sai da soma das durações dos
/// itens, que por sua vez vêm da tabela de preço do porte corrigida pela pelagem. É
/// coluna e não expressão porque o índice GIST de conflito precisa dela materializada.
model Appointment {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  petId          String @map("pet_id") @db.Uuid
  tutorId        String @map("tutor_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid

  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)

  status AppointmentStatus @default(CONFIRMED)
  source AppointmentSource @default(STAFF)

  /// RN-04: fotografia do momento da criação. Reajuste de preço não retroage.
  totalCents BigInt @map("total_cents")

  /// RN-17: a hora **real**, que a métrica compara com `starts_at`. Check-in fora do
  /// horário é permitido — o pet está ali.
  checkinAt  DateTime? @map("checkin_at") @db.Timestamptz(6)
  checkoutAt DateTime? @map("checkout_at") @db.Timestamptz(6)

  cancelledAt           DateTime? @map("cancelled_at") @db.Timestamptz(6)
  /// Cifrado: o motivo pode citar doença do tutor ou do pet (§9).
  cancelReasonEncrypted String?   @map("cancel_reason_encrypted")
  /// RN-06: dentro da janela de 24h. É o que decide a taxa no MOD-LEDGER.
  cancelledLate         Boolean?  @map("cancelled_late")

  /// RN-16: a cadeia de remarcações. "Quantas vezes remarcou" é dado de negócio.
  rescheduledToId String? @unique @map("rescheduled_to_id") @db.Uuid

  /// Ocorrência de uma série (MOD-AGENDA-05). Nulo é agendamento avulso.
  recurrenceId String? @map("recurrence_id") @db.Uuid

  /// MOD-AGENDA-10: quem assumiu o risco clínico, e quando.
  acknowledgedAlertsBy String?   @map("acknowledged_alerts_by") @db.Uuid
  acknowledgedAlertsAt DateTime? @map("acknowledged_alerts_at") @db.Timestamptz(6)

  /// RN-11: quem liberou o inadimplente e por quê.
  creditOverrideBy     String? @map("credit_override_by") @db.Uuid
  creditOverrideReason String? @map("credit_override_reason")

  /// Campo livre — costuma receber dado pessoal ("tocar o interfone 2").
  notesEncrypted String? @map("notes_encrypted")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  items       AppointmentItem[]
  statusLog   AppointmentStatusLog[]
  attendances Attendance[]
  taxiRides   TaxiRide[]

  pet          Pet          @relation(fields: [petId], references: [id], onDelete: Restrict)
  tutor        Tutor        @relation(fields: [tutorId], references: [id], onDelete: Restrict)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)

  /// A cadeia de remarcação é auto-referente: o cancelado aponta para o novo.
  rescheduledTo   Appointment? @relation("AppointmentReschedule", fields: [rescheduledToId], references: [id], onDelete: SetNull)
  rescheduledFrom Appointment? @relation("AppointmentReschedule")

  recurrence AppointmentRecurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)

  @@index([petId, startsAt(sort: Desc)], map: "idx_appointments_pet")
  @@index([tenantId, tutorId, startsAt(sort: Desc)], map: "idx_appointments_tutor")
  @@map("appointments")
}

/// Um atendimento pode ter banho + hidratação. Preço e duração congelados por item
/// (RN-04), porque o total é a soma deles e reajuste não pode reescrever a conta.
model AppointmentItem {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  appointmentId String @map("appointment_id") @db.Uuid
  serviceId     String @map("service_id") @db.Uuid

  /// Rótulo congelado junto: o serviço pode ser renomeado ou excluído depois, e o
  /// histórico precisa continuar sabendo o que foi vendido.
  label String @db.VarChar(80)

  priceCents  BigInt @map("price_cents")
  durationMin Int    @map("duration_min") @db.SmallInt

  /// RN-18: item acrescentado durante a execução, no check-out.
  addedAtCheckout Boolean @default(false) @map("added_at_checkout")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([appointmentId])
  @@map("appointment_items")
}

/// Trilha da máquina de estado (§6). Append-only por trigger, como `audit_logs`:
/// "quando isso virou no-show e quem decidiu" é pergunta que se faz meses depois.
model AppointmentStatusLog {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  appointmentId String @map("appointment_id") @db.Uuid

  /// Nulo na criação: não havia estado anterior.
  fromStatus AppointmentStatus? @map("from_status")
  toStatus   AppointmentStatus  @map("to_status")

  changedBy String?  @map("changed_by") @db.Uuid
  reason    String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@map("appointment_status_log")
}

/// Série recorrente (MOD-AGENDA-05).
///
/// RN-14: a recorrência é **materializada**, não uma regra viva. As ocorrências são
/// agendamentos reais até 12 semanas à frente, estendidas por job semanal. Interpretar
/// RRULE em toda leitura de agenda transformaria a consulta mais frequente do sistema
/// numa avaliação de calendário, e nada — bloqueio, remarcação, cancelamento de uma
/// ocorrência — poderia ser gravado sem inventar uma tabela de exceções.
model AppointmentRecurrence {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  petId          String @map("pet_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid

  /// iCal RRULE, restrita a FREQ DAILY/WEEKLY/MONTHLY (AC-02).
  rrule String @db.VarChar(200)

  /// Primeira ocorrência; a série é gerada a partir dela.
  startsAt          DateTime  @map("starts_at") @db.Timestamptz(6)
  /// Fim da série. Nulo é série sem prazo, estendida pelo job semanal.
  until             DateTime? @db.Timestamptz(6)
  /// Até onde já foi materializado. É o que o job lê para saber o que gerar.
  materializedUntil DateTime? @map("materialized_until") @db.Timestamptz(6)

  /// Serviços da série, congelados como ids. O preço **não** é congelado aqui: cada
  /// ocorrência congela o seu na criação (RN-04), e uma série de um ano não pode
  /// carregar o preço de doze meses atrás.
  serviceIds String[] @map("service_ids") @db.Uuid

  active Boolean @default(true)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  appointments Appointment[]

  @@index([tenantId, active, materializedUntil], map: "idx_recurrences_materialize")
  @@map("appointment_recurrences")
}

// ─── MOD-LEDGER — conta corrente do tutor ────────────────────────────────────
// PRD financeiro_tutor_05 §4.
//
// Convenção de dinheiro do módulo: **inteiro em centavos (`BigInt`), nunca `Decimal`
// nem `Float`**. Soma de saldo corrido é a operação mais executada daqui e a única em
// que erro de arredondamento é irreversível e visível para o cliente final.

enum EntryDirection {
  DEBIT
  CREDIT
}

enum EntryCategory {
  SERVICE
  PRODUCT
  NO_SHOW_FEE
  PACKAGE_PURCHASE
  PACKAGE_REDEMPTION
  PAYMENT
  PAYMENT_REVERSAL
  ADJUSTMENT
  FEE_WAIVER
  DISCOUNT
}

enum EntrySourceType {
  ATTENDANCE
  APPOINTMENT
  PAYMENT
  PACKAGE
  MANUAL
  SYSTEM
}

enum EntryStatus {
  POSTED
  REVERSED
}

enum PaymentMethod {
  CASH
  PIX_MANUAL
  CARD_MACHINE_DEBIT
  CARD_MACHINE_CREDIT
  BANK_TRANSFER
  PACKAGE_CREDIT
  OTHER
}

enum PaymentStatus {
  RECORDED
  REVERSED
}

enum AllocationSource {
  AUTO_FIFO
  MANUAL
}

enum PurchaseStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  SUSPENDED
  CANCELLED
}

/// Uma conta por tutor por tenant (MOD-LEDGER-01).
///
/// RN-17: **criada preguiçosamente**. Não se cria conta no cadastro do tutor; a
/// primeira consulta ou o primeiro lançamento a cria com saldo zero. Tutor sem
/// movimentação nunca devolve 404 — devolve extrato vazio.
model LedgerAccount {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tutorId  String @map("tutor_id") @db.Uuid

  /// RN-02: positivo é crédito do tutor, negativo é inadimplência. Mesma convenção
  /// de `tutors.balance_cents`, que este módulo alimenta por evento.
  balanceCents BigInt @default(0) @map("balance_cents")
  currency     String @default("BRL") @db.Char(3)

  /// Optimistic locking. O caminho de escrita usa `FOR UPDATE`, mas a coluna deixa
  /// a corrida detectável em auditoria depois do fato.
  version Int @default(0)

  lastEntryAt   DateTime? @map("last_entry_at") @db.Timestamptz(6)
  lastPaymentAt DateTime? @map("last_payment_at") @db.Timestamptz(6)
  /// Início do atraso vigente; nulo se em dia.
  overdueSince  DateTime? @map("overdue_since") @db.Timestamptz(6)

  /// RN-18: marcado pelo job de reconciliação. **Não bloqueia lançamento novo** — a
  /// conta não trava para o tenant por um bug nosso.
  needsReview Boolean @default(false) @map("needs_review")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tutor    Tutor         @relation(fields: [tutorId], references: [id], onDelete: Restrict)
  entries  LedgerEntry[]
  payments Payment[]

  @@map("ledger_accounts")
}

/// O lançamento (MOD-LEDGER-02). **Append-only**, garantido por trigger e por RULE
/// no banco: erro nunca vira UPDATE, vira contrapartida vinculada (RN-01).
model LedgerEntry {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid
  tutorId   String @map("tutor_id") @db.Uuid

  direction   EntryDirection
  /// Sempre positivo (o CHECK garante); o sinal vem de `direction`. A exceção é o
  /// lançamento informativo de uso de pacote, que vale zero.
  amountCents BigInt         @map("amount_cents")

  /// Coluna **gerada** pelo Postgres: `CREDIT ? +amount : -amount`. A aplicação
  /// nunca escreve aqui — é opcional no Prisma só para que `create` não a exija.
  /// É o que o job de reconciliação soma.
  signedAmountCents BigInt? @map("signed_amount_cents")

  /// Saldo corrido no instante da postagem. É o que faz o extrato não precisar
  /// somar a tabela inteira para mostrar uma página.
  balanceAfterCents BigInt @map("balance_after_cents")

  category               EntryCategory
  /// Texto visível ao tutor no extrato.
  description            String        @db.VarChar(200)
  /// Cifrado com a DEK do tenant. **Nunca** exposto ao tutor (AC-03 de MOD-LEDGER-06):
  /// pode conter juízo de valor ("cliente sempre atrasa").
  internalNotesEncrypted String?       @map("internal_notes_encrypted")

  sourceType EntrySourceType @map("source_type")
  /// Idempotência com `source_type`, pelo índice único parcial.
  sourceId   String?         @map("source_id") @db.Uuid
  petId      String?         @map("pet_id") @db.Uuid

  /// RN-23: data do fato gerador — pode ser retroativa. O extrato ordena por ela.
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  /// Data do registro no sistema — nunca retroativa. A auditoria ordena por ela.
  postedAt   DateTime @default(now()) @map("posted_at") @db.Timestamptz(6)

  status EntryStatus @default(POSTED)

  /// Aponta para a contrapartida que estornou este lançamento.
  reversedByEntryId String? @map("reversed_by_entry_id") @db.Uuid
  /// Preenchido quando este lançamento **é** a contrapartida.
  reversesEntryId   String? @map("reverses_entry_id") @db.Uuid

  /// Quanto do débito já foi quitado por alocação de pagamento.
  settledCents BigInt @default(0) @map("settled_cents")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  account     LedgerAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  payment     Payment?
  allocations PaymentAllocation[]
  usage       PackageCreditUsage?
  purchase    PackagePurchase?

  @@map("ledger_entries")
}

/// Pagamento recebido **fora do sistema** e lançado aqui (MOD-LEDGER-03).
///
/// A v1 não processa dinheiro: o PIX cai na chave do petshop, a maquininha é do
/// petshop, e o que se registra é o fato. `external_ref` fica reservado para o `txid`
/// do PSP quando o gateway entrar, sem migração destrutiva (RN-19).
model Payment {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid
  tutorId   String @map("tutor_id") @db.Uuid

  amountCents    BigInt @map("amount_cents")
  /// Quanto do pagamento já foi alocado a débitos. A diferença é o crédito que
  /// sobrou na conta (RN-07) e que o próximo débito consome.
  allocatedCents BigInt @default(0) @map("allocated_cents")

  method     PaymentMethod
  /// Quando o dinheiro entrou de fato — pode ser anterior ao registro.
  receivedAt DateTime      @map("received_at") @db.Timestamptz(6)
  /// Quem recebeu no balcão. É a coluna da responsabilização.
  receivedBy String?       @map("received_by") @db.Uuid

  /// Lançamento de crédito correspondente. 1:1.
  entryId String @unique @map("entry_id") @db.Uuid

  status         PaymentStatus @default(RECORDED)
  /// Obrigatório quando REVERSED (RN-25: só TENANT_ADMIN reverte).
  reversalReason String?       @map("reversal_reason")

  /// Cifrados: o comprovante pode exibir dado bancário de terceiro, e a observação
  /// do balcão é campo livre onde cabe qualquer coisa.
  proofUrlEncrypted String? @map("proof_url_encrypted")
  notesEncrypted    String? @map("notes_encrypted")

  /// Reservado para o `txid` do PSP (RN-19). Não usado na v1.
  externalRef String? @map("external_ref") @db.VarChar(120)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  account     LedgerAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  entry       LedgerEntry         @relation(fields: [entryId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]
  purchases   PackagePurchase[]
  receipt     Receipt?

  @@map("payments")
}

/// Quitação N:N entre pagamento e débito (MOD-LEDGER-04).
///
/// RN-06: FIFO por padrão — o pagamento quita os débitos mais antigos primeiro.
/// Alocação manual é auditada, porque quitação fora do FIFO é o vetor clássico de
/// desvio no balcão.
model PaymentAllocation {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  paymentId    String @map("payment_id") @db.Uuid
  debitEntryId String @map("debit_entry_id") @db.Uuid

  amountCents BigInt           @map("amount_cents")
  allocatedBy AllocationSource @default(AUTO_FIFO) @map("allocated_by")

  /// A reversão do pagamento **marca**, não apaga: o AC-05 é explícito em que nada
  /// desaparece do rastro.
  reversedAt DateTime? @map("reversed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment    Payment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  debitEntry LedgerEntry @relation(fields: [debitEntryId], references: [id], onDelete: Restrict)

  @@map("payment_allocations")
}

/// Catálogo de pacotes do tenant (MOD-LEDGER-07).
model ServicePackage {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name       String   @db.VarChar(120)
  /// RN-10: o crédito cobre **estes** serviços. O casamento é por `service_id`,
  /// nunca por equivalência de valor.
  serviceIds String[] @map("service_ids") @db.Uuid

  credits      Int
  priceCents   BigInt @map("price_cents")
  /// Decisão de negócio 2: 90 dias.
  validityDays Int    @default(90) @map("validity_days")

  /// Descontinuar não apaga as compras já feitas.
  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  purchases PackagePurchase[]

  @@map("service_packages")
}

/// A compra de um pacote por um tutor.
model PackagePurchase {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  tutorId   String @map("tutor_id") @db.Uuid
  packageId String @map("package_id") @db.Uuid

  /// Vinculação a um pet. Opcional: pacote de tutor com um pet só não precisa dela,
  /// e AC-05 permite reatribuir depois.
  petId String? @map("pet_id") @db.Uuid

  /// Nome, serviços, créditos e preço **no ato da compra**. RN-05: alterar o
  /// catálogo depois nunca muda o que já foi vendido.
  snapshot Json

  creditsTotal Int @map("credits_total")
  creditsUsed  Int @default(0) @map("credits_used")

  purchasedAt DateTime @default(now()) @map("purchased_at") @db.Timestamptz(6)
  /// `purchased_at + validity_days`. RN-08: vencido, o crédito é perdido e **nada é
  /// devolvido** — decisão de produto, com aviso prévio obrigatório (RN-09).
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  status                    PurchaseStatus @default(ACTIVE)
  /// Cifrado: pode citar óbito do pet ou situação familiar.
  suspensionReasonEncrypted String?        @map("suspension_reason_encrypted")

  /// Rastro financeiro da compra.
  paymentId String? @map("payment_id") @db.Uuid
  entryId   String  @unique @map("entry_id") @db.Uuid

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  package ServicePackage       @relation(fields: [packageId], references: [id], onDelete: Restrict)
  payment Payment?             @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  entry   LedgerEntry          @relation(fields: [entryId], references: [id], onDelete: Restrict)
  usages  PackageCreditUsage[]

  @@map("package_purchases")
}

/// Um crédito de pacote consumido por um atendimento.
///
/// O único `(tenant_id, attendance_id, service_id)` é a idempotência do resgate: a
/// reentrega de `atendimento.concluido` não pode queimar o crédito duas vezes.
model PackageCreditUsage {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  purchaseId String @map("purchase_id") @db.Uuid

  attendanceId  String  @map("attendance_id") @db.Uuid
  appointmentId String? @map("appointment_id") @db.Uuid
  serviceId     String  @map("service_id") @db.Uuid
  petId         String  @map("pet_id") @db.Uuid

  /// Lançamento informativo de valor zero, para o uso aparecer no extrato.
  entryId String @unique @map("entry_id") @db.Uuid

  usedAt     DateTime  @default(now()) @map("used_at") @db.Timestamptz(6)
  /// RN-12: anulação do atendimento devolve o crédito, respeitando a validade
  /// original — o pacote não ganha sobrevida por causa de um erro nosso.
  revertedAt DateTime? @map("reverted_at") @db.Timestamptz(6)

  purchase PackagePurchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  entry    LedgerEntry     @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@map("package_credit_usages")
}

/// Políticas financeiras do tenant. Uma linha por tenant.
///
/// `no_show_fee_percent` e `cancellation_window_hours` **não** moram aqui: vivem em
/// `tenant_settings` desde o MOD-AGENDA, e o scheduling-service já calcula a taxa com
/// eles. Duplicá-los criaria duas fontes de verdade sobre quanto se cobra de quem falta.
model BillingSettings {
  tenantId String @id @map("tenant_id") @db.Uuid

  /// RN-15: nulo **não bloqueia nada**. A política de bloqueio é opt-in por tenant.
  creditLimitCents BigInt? @map("credit_limit_cents")
  /// Dias de atraso até a tag de inadimplente.
  overdueDays      Int     @default(30) @map("overdue_days")

  /// Subconjunto de `PaymentMethod`. Vazio nunca: o tenant desliga o que não usa.
  enabledPaymentMethods PaymentMethod[] @map("enabled_payment_methods")

  defaultPackageValidityDays Int   @default(90) @map("default_package_validity_days")
  /// RN-09: avisos em D-15 e D-3 por padrão. Expiração sem aviso é falha de produto.
  packageExpiryWarningDays   Int[] @default([15, 3]) @map("package_expiry_warning_days")

  noShowConsumesPackageCredit Boolean @default(false) @map("no_show_consumes_package_credit")

  /// RN-20: o sistema emite **recibo**, não nota fiscal. O texto deixa isso explícito.
  receiptFooterText String? @map("receipt_footer_text")

  /// A chave PIX que o tutor copia para pagar (AC-05 de MOD-PORTAL-08).
  ///
  /// **Não é cifrada**, pela mesma razão do endereço comercial em `tenant_settings`:
  /// existe para ser distribuída — vai no balcão, no WhatsApp e na tela do Portal.
  /// Cifrar o que se entrega a todo cliente seria cerimônia sem proteção.
  ///
  /// A v1 não processa dinheiro (RN-19): não há PSP, não há conciliação automática e
  /// o pagamento continua sendo registrado à mão por quem recebeu. A chave é
  /// instrução, não checkout.
  pixKey String? @map("pix_key") @db.VarChar(140)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("billing_settings")
}

/// RN-04 — idempotência de API.
///
/// Todo POST que move dinheiro exige `idempotencyKey`. A repetição com o **mesmo**
/// payload devolve o mesmo recurso; com payload diferente, `ERR_LEDGER_012`. Não está
/// no §4 do PRD, mas sem a tabela a regra não tem onde se apoiar: o índice único de
/// `(source_type, source_id)` cobre evento reentregue, não duplo clique no balcão.
model LedgerIdempotencyKey {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  key         String @db.Uuid
  /// Qual operação a chave cobre — a mesma chave em endpoints diferentes é uso
  /// legítimo, e tratá-la como colisão quebraria o cliente sem motivo.
  endpoint    String @db.VarChar(60)
  /// SHA-256 do payload normalizado. É o que separa "repetiu" de "mudou de ideia".
  requestHash String @map("request_hash") @db.VarChar(64)
  /// Id do recurso criado na primeira vez, para a repetição devolvê-lo.
  resourceId  String @map("resource_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ledger_idempotency_keys")
}

// ─── Agendador de jobs (packages/job-scheduler) ──────────────────────────────
//
// Tabelas de **plataforma**: não têm dono de tenant e por isso não têm RLS, como
// `users`, `roles` e `permissions`. Um job varre todos os tenants por definição —
// amarrá-lo a um contexto de tenant seria negar o que ele é.

enum JobStatus {
  OK
  FAILED
  TIMEOUT
}

/// Exclusão mútua entre réplicas. Uma linha por job.
///
/// O lease vence sozinho: se o processo que o tomou morrer no meio, a próxima réplica
/// o reivindica assim que `lease_until` passar. É a propriedade que um lock em memória
/// nunca tem, e a razão de não usar `pg_advisory_lock` (que ou vive numa conexão do
/// pool, ou obriga a segurar uma transação aberta pelo job inteiro).
model JobLease {
  name       String   @id @db.VarChar(80)
  /// `servico@host#id` — é o que o log mostra quando outra réplica está com o job.
  holder     String   @db.VarChar(160)
  leasedAt   DateTime @default(now()) @map("leased_at") @db.Timestamptz(6)
  leaseUntil DateTime @map("lease_until") @db.Timestamptz(6)

  @@map("job_leases")
}

/// Histórico de execução. É a resposta a "o job rodou?" — que sem isto só o log
/// responderia, e log rotaciona.
model JobRun {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String    @db.VarChar(80)
  startedAt  DateTime  @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime  @map("finished_at") @db.Timestamptz(6)
  status     JobStatus
  /// O que o job devolveu: `{ marked: 3 }`, `{ expired: 0 }`. É o que se quer ver numa
  /// consulta de uma linha só.
  result     Json?
  error      String?

  @@index([name, startedAt(sort: Desc)], map: "idx_job_runs_name_time")
  @@map("job_runs")
}

// ─── MOD-LEDGER-08 — recibo ──────────────────────────────────────────────────

enum ReceiptStatus {
  PENDING
  ISSUED
  SENT
  CANCELLED
}

/// Comprovante de pagamento.
///
/// RN-20: é **recibo, não nota fiscal**. O PDF diz isso em letras, para não induzir o
/// tenant a achar que cumpriu obrigação fiscal municipal que não cumpriu.
model Receipt {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  tutorId   String @map("tutor_id") @db.Uuid
  paymentId String @unique @map("payment_id") @db.Uuid

  /// RN-21: sequencial por tenant e ano (`2026/000123`). Alocado na criação, dentro da
  /// transação do pagamento — recibo cancelado **não** devolve o número.
  number String @db.VarChar(20)

  /// O registro em `documents`, que passou a ser o dono do arquivo (MOD-DOC-02).
  documentId String? @unique @map("document_id") @db.Uuid

  /// Chave do objeto no R2, de quando o recibo guardava o próprio arquivo.
  ///
  /// **Não é mais escrita.** Fica como leitura de reserva durante a janela de
  /// convivência do AC-04 de MOD-DOC-02, e cai numa segunda migration — derrubá-la
  /// junto com o backfill tiraria o caminho de volta.
  storageKey String? @map("storage_key")

  status ReceiptStatus @default(PENDING)

  issuedAt    DateTime? @map("issued_at") @db.Timestamptz(6)
  /// Inalcançável até o MOD-NOTIF existir: não há quem envie.
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  /// Última falha de geração, para o job de reprocesso não ser cego.
  lastError String? @map("last_error")
  attempts  Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment  Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  document Document? @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@map("receipts")
}

// ─── MOD-TAXI — leva-e-traz (PRD taxi_dog_07 §4) ─────────────────────────────

enum TaxiLeg {
  PICKUP
  DROPOFF
}

enum TaxiRideStatus {
  REQUESTED
  ASSIGNED
  EN_ROUTE
  ARRIVED
  ONBOARD
  DELIVERED
  FAILED
  CANCELLED
}

enum TaxiPriceSource {
  ZONE
  DEFAULT
  MANUAL
}

enum TaxiFailureReason {
  NO_ONE_HOME
  WRONG_ADDRESS
  PET_REFUSED
  NO_SPACE
  VEHICLE_ISSUE
  OTHER
}

enum TaxiCancelReason {
  TUTOR_REQUEST
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  PET_DECEASED
  SHOP_REQUEST
}

/// Uma perna do leva-e-traz.
///
/// **Ida e volta são duas linhas** (RN-02), e não uma com `tipo [ida/volta/ambos]`
/// como o SPEC §129 previa: cada perna tem janela, motorista, veículo, status, hora
/// real e falha próprios. Em uma linha só, cada um desses campos precisaria de um
/// gêmeo com sufixo `_volta`.
///
/// `appointment_id` é obrigatório (RN-01): o Taxi Dog é complemento da agenda, não
/// uma segunda agenda. `pet_id` e `tutor_id` são denormalizados de propósito — a rota
/// do motorista é a consulta mais quente do módulo e não pode depender de join.
model TaxiRide {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  appointmentId String @map("appointment_id") @db.Uuid
  petId         String @map("pet_id") @db.Uuid
  tutorId       String @map("tutor_id") @db.Uuid

  leg    TaxiLeg
  status TaxiRideStatus @default(REQUESTED)

  /// A janela **prometida ao tutor**, não a estimada. É contra ela que a métrica
  /// `taxi_window_adherence_rate` mede o módulo inteiro.
  windowStartsAt DateTime @map("window_starts_at") @db.Timestamptz(6)
  windowEndsAt   DateTime @map("window_ends_at") @db.Timestamptz(6)

  /// `professionals` com `role_key = 'DRIVER'` (RN-03). Nulo é a fila sem dono.
  driverId  String? @map("driver_id") @db.Uuid
  /// RN-04: a capacidade efetiva é `min(motorista, veículo)`.
  vehicleId String? @map("vehicle_id") @db.Uuid

  /// Procedência do endereço. Nulo quando foi informado na hora — o endereço em si
  /// está sempre copiado abaixo (RN-11).
  addressId String? @map("address_id") @db.Uuid

  /// Em claro, como em `tutor_addresses`: sozinho não identifica ninguém, e é o que
  /// a resolução de zona consulta.
  zipCode String @map("zip_code") @db.VarChar(8)

  /// Snapshot cifrado (§4). Mudar o cadastro do tutor depois não reescreve para onde
  /// o motorista foi.
  streetEncrypted      String  @map("street_encrypted")
  numberEncrypted      String  @map("number_encrypted")
  complementEncrypted  String? @map("complement_encrypted")
  /// "Portão azul, interfone 12" — dado de segurança física do tutor.
  accessNotesEncrypted String? @map("access_notes_encrypted")

  district String @db.VarChar(80)
  city     String @db.VarChar(80)
  state    String @db.VarChar(2)

  /// Copiadas do endereço quando existem. Insumo do MOD-TAXI-10; a v1 não roteiriza.
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  /// Nulo quando o preço veio do padrão do tenant ou foi definido à mão.
  zoneId      String?         @map("zone_id") @db.Uuid
  /// RN-07: congelado na criação. Reajuste de zona não retroage.
  priceCents  BigInt          @map("price_cents")
  priceSource TaxiPriceSource @default(DEFAULT) @map("price_source")

  /// RN-05: o item do agendamento que cobra esta corrida. Nulo depois do
  /// cancelamento, que remove o item e recalcula o total.
  appointmentItemId String? @map("appointment_item_id") @db.Uuid

  /// RN-10: quando o `atendimento.concluido` liberou a perna de volta. Nulo em
  /// `DROPOFF` significa pet ainda na secagem.
  readyAt DateTime? @map("ready_at") @db.Timestamptz(6)

  assignedAt  DateTime? @map("assigned_at") @db.Timestamptz(6)
  enRouteAt   DateTime? @map("en_route_at") @db.Timestamptz(6)
  arrivedAt   DateTime? @map("arrived_at") @db.Timestamptz(6)
  onboardAt   DateTime? @map("onboard_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)

  failureReason TaxiFailureReason? @map("failure_reason")
  cancelReason  TaxiCancelReason?  @map("cancel_reason")
  cancelledAt   DateTime?          @map("cancelled_at") @db.Timestamptz(6)

  /// Campo livre do motorista, propenso a dado pessoal.
  notesEncrypted String? @map("notes_encrypted")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  statusLog TaxiRideStatusLog[]

  appointment Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  pet         Pet           @relation(fields: [petId], references: [id], onDelete: Restrict)
  tutor       Tutor         @relation(fields: [tutorId], references: [id], onDelete: Restrict)
  driver      Professional? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicle     TaxiVehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  zone        TaxiZone?     @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([appointmentId], map: "idx_taxi_rides_appointment")
  @@index([tenantId, tutorId, windowStartsAt(sort: Desc)], map: "idx_taxi_rides_tutor")
  @@map("taxi_rides")
}

/// Trilha da máquina de estado, append-only por trigger — como `audit_logs` e
/// `tutor_consents`.
///
/// As duas horas existem porque são coisas diferentes (RN-20): `occurred_at` é a que
/// o motorista informou, e pode ser retroativa em até 6h quando ele estava sem sinal;
/// `recorded_at` é sempre o servidor. Guardar só uma esconderia a retroação de quem
/// audita, ou perderia a hora real do fato.
model TaxiRideStatusLog {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  rideId   String @map("ride_id") @db.Uuid

  fromStatus TaxiRideStatus? @map("from_status")
  toStatus   TaxiRideStatus  @map("to_status")

  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  /// Quem estava com a corrida no momento, e quem apertou o botão. Podem diferir:
  /// a recepção fecha corrida do motorista que ficou sem bateria.
  driverId String? @map("driver_id") @db.Uuid
  byUserId String? @map("by_user_id") @db.Uuid

  notesEncrypted String? @map("notes_encrypted")

  ride TaxiRide @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId, recordedAt], map: "idx_taxi_ride_status_log_ride")
  @@map("taxi_ride_status_log")
}

/// A frota. `pet_capacity` aperta o limite do motorista quando ele sai com a van
/// pequena (RN-04).
model TaxiVehicle {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  plate String  @db.VarChar(8)
  label String  @db.VarChar(40)
  model String? @db.VarChar(40)

  petCapacity Int @map("pet_capacity") @db.SmallInt

  /// Veículo na oficina sai do seletor sem sumir do histórico das corridas.
  active Boolean @default(true)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  rides TaxiRide[]

  @@index([tenantId, active])
  @@map("taxi_vehicles")
}

/// Preço por região, resolvido a partir do CEP.
///
/// `zip_prefixes` é array porque uma zona comercial costuma ser um punhado de faixas
/// não contíguas. O **prefixo mais longo vence** (RN-17): quem cadastrou o mais
/// específico estava descrevendo a exceção.
model TaxiZone {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name        String   @db.VarChar(60)
  zipPrefixes String[] @map("zip_prefixes")
  priceCents  BigInt   @map("price_cents")

  active Boolean @default(true)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  rides TaxiRide[]

  @@index([tenantId, active])
  @@map("taxi_zones")
}

/// Configuração do módulo por tenant, como `billing_settings`.
///
/// `enabled` nasce **false** (RN-22): o petshop que não faz leva-e-traz não deve ver
/// um campo morto no wizard de agendamento.
model TaxiSettings {
  tenantId String @id @map("tenant_id") @db.Uuid

  enabled Boolean @default(false)

  /// O serviço de catálogo, categoria `TAXI`, que ancora a cobrança (RN-05). Sem ele
  /// a criação de corrida recusa com ERR_TAXI_010.
  taxiServiceId String? @map("taxi_service_id") @db.Uuid

  /// Fallback do CEP que nenhuma zona cobre (RN-18).
  defaultPriceCents  BigInt  @default(0) @map("default_price_cents")
  /// RN-18: recusar CEP fora de zona é opt-in.
  blockOutsideZones  Boolean @default(false) @map("block_outside_zones")
  /// RN-16: porta fechada não se cobra por padrão.
  chargeFailedPickup Boolean @default(false) @map("charge_failed_pickup")

  defaultWindowMinutes Int @default(60) @map("default_window_minutes") @db.SmallInt
  unassignedAlertHours Int @default(12) @map("unassigned_alert_hours") @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [taxiServiceId], references: [id], onDelete: SetNull)

  @@map("taxi_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// MOD-CRM — Relacionamento e automação (PRD relacionamento_crm_08)
// ─────────────────────────────────────────────────────────────────────────────

enum MessageChannel {
  WHATSAPP
  EMAIL
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

/// Com quem o motor está falando (MOD-NOTIF-01).
///
/// A fila nasceu inteiramente moldada no tutor — consentimento, janela de silêncio e
/// os três tetos descrevem a relação comercial com um cliente. O e-mail que vai a um
/// membro da equipe percorre a mesma fila e o mesmo despacho, mas **nenhum** desses
/// gates: um convite que não sai às 21h porque a janela fechou é um convite quebrado.
enum MessageRecipientKind {
  TUTOR
  USER
}

/// Decide base legal, janela de silêncio e teto diário de uma vez (RN-01).
enum MessageCategory {
  TRANSACTIONAL
  OPERATIONAL
  MARKETING
}

enum MessageStatus {
  QUEUED
  SCHEDULED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  DEAD
  BLOCKED
  CANCELLED
  /// RN-08: absorvida por outra mensagem dentro da janela de 5 minutos. A linha fica
  /// para a idempotência (o `dedupe_key` do evento continua gravado) e para o painel
  /// poder dizer a verdade — não foi cancelada, saiu dentro de outra.
  MERGED
}

enum MessageBlockReason {
  NO_CONSENT
  SUPPRESSED
  NO_CHANNEL
  PET_DECEASED
  QUIET_HOURS_EXPIRED
  /// O tutor já recebeu a mensagem de marketing da semana
  /// (`messaging_settings.marketing_weekly_cap`).
  WEEKLY_CAP
  /// A conta do estabelecimento está em só leitura — teste vencido ou suspensão.
  /// O único motivo que não fala do destinatário, e sim de quem ia falar com ele.
  TENANT_INACTIVE
}

enum MessageOriginType {
  APPOINTMENT
  TAXI_RIDE
  LEDGER_ENTRY
  CAMPAIGN_RUN
  PET
  /// Disparo que alguém decidiu fazer pela tela (MOD-CRM-12).
  MANUAL
  /// Resposta de uma conversa do WhatsApp — do agente ou da recepção (MOD-AI-06).
  /// Separada de `MANUAL` porque aqui o cliente escreveu primeiro, e é o que torna as
  /// duas distinguíveis no painel de entregas sem ler o corpo de nada.
  AGENT_HANDOFF
}

enum SuppressionReason {
  HARD_BOUNCE
  NOT_ON_WHATSAPP
  ANONYMIZED
  MANUAL
}

enum MessageEventKind {
  SENT
  DELIVERED
  READ
  FAILED
  BOUNCED
}

/// A fila de saída e o histórico, na mesma tabela.
///
/// São a mesma coisa vista em dois momentos: enquanto `status` é `QUEUED` ou
/// `SCHEDULED` a linha é fila; depois é histórico. Separar as duas obrigaria a copiar
/// o corpo cifrado de uma tabela para outra no instante do envio — o momento em que
/// menos se quer ter trabalho a fazer.
model Message {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Exatamente um dos dois, casando com `recipientKind` — a garantia é o CHECK
  /// `messages_recipient_check`, não só o schema Zod (AC-02 de MOD-NOTIF-01).
  recipientKind MessageRecipientKind @default(TUTOR) @map("recipient_kind")

  tutorId String? @map("tutor_id") @db.Uuid
  userId  String? @map("user_id") @db.Uuid
  petId   String? @map("pet_id") @db.Uuid

  /// O anexo, **por referência** (MOD-NOTIF-05). O arquivo é lido do R2 na hora do
  /// envio; o corpo cifrado guarda texto, nunca bytes. Sem FK declarada: `documents`
  /// vive sob RLS no mesmo tenant, e a mensagem sobrevive a um documento anulado.
  documentId String? @map("document_id") @db.Uuid

  channel   MessageChannel
  direction MessageDirection @default(OUTBOUND)
  category  MessageCategory

  templateKey     String @map("template_key") @db.VarChar(60)
  /// Qual versão do texto gerou este corpo. Zero = o padrão de `messaging-seed.ts`.
  templateVersion Int    @default(0) @map("template_version")

  /// Telefone E.164 ou e-mail, cifrado. O hash ao lado casa supressão e inbound sem
  /// precisar decifrar linha por linha.
  toEncrypted String @map("to_encrypted")
  toHash      String @map("to_hash") @db.Char(64)

  subjectEncrypted String? @map("subject_encrypted")
  /// RN-14: renderizado **na entrada da fila**, com os dados daquele instante. Editar
  /// o template depois não reescreve o que já está esperando para sair.
  bodyEncrypted    String  @map("body_encrypted")

  /// O texto do e-mail, renderizado junto com o do WhatsApp, para quando o WhatsApp não
  /// consegue entregar (a confirmação do agendamento online). Apagado assim que a
  /// mensagem sai por um dos dois; nulo em quem não pediu segundo canal.
  fallbackSubjectEncrypted String? @map("fallback_subject_encrypted")
  fallbackBodyEncrypted    String? @map("fallback_body_encrypted")

  status      MessageStatus       @default(QUEUED)
  blockReason MessageBlockReason? @map("block_reason")

  /// Idempotência do motor (AC-04 de MOD-CRM-03): único por tenant.
  dedupeKey String @map("dedupe_key") @db.VarChar(120)

  /// O que invalida a mensagem enquanto ela espera (AC-06 de MOD-CRM-03).
  originType MessageOriginType? @map("origin_type")
  originId   String?            @map("origin_id") @db.Uuid

  /// RN-08: quando esta mensagem foi absorvida por outra, qual é a outra. Sem FK
  /// declarada de propósito — é referência dentro da mesma tabela e do mesmo tenant, e
  /// a retenção apaga corpos sem apagar linhas, então nada aqui precisa cascatear.
  mergedIntoId String? @map("merged_into_id") @db.Uuid

  /// Quando pode sair. Nulo = assim que o worker pegar.
  scheduledFor DateTime? @map("scheduled_for") @db.Timestamptz(6)

  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  failedAt    DateTime? @map("failed_at") @db.Timestamptz(6)

  attempts Int @default(0) @db.SmallInt

  provider          String? @db.VarChar(20)
  providerMessageId String? @map("provider_message_id") @db.VarChar(120)

  /// Em claro: é o que o painel de falhas mostra, e não carrega dado do tutor.
  errorCode   String? @map("error_code") @db.VarChar(60)
  errorDetail String? @map("error_detail") @db.VarChar(500)

  /// Nulo quando o gatilho foi automação, e não gente.
  requestedBy String?  @map("requested_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  events MessageEvent[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tutor  Tutor? @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  /// **Sem cascade, e sem `SetNull`** (AC-04 de MOD-NOTIF-01). O registro do que se
  /// mandou a um ex-membro é auditoria: apagá-lo com o vínculo apagaria a prova de
  /// que o convite foi enviado. `SetNull` — que o §4 do PRD esboça — deixaria a linha
  /// em `USER` sem `user_id` e violaria o próprio CHECK da tabela.
  user   User?  @relation(fields: [userId], references: [id], onDelete: Restrict)
  pet    Pet?   @relation(fields: [petId], references: [id], onDelete: SetNull)

  @@unique([tenantId, dedupeKey], map: "idx_messages_dedupe")
  @@index([tenantId, tutorId, createdAt(sort: Desc)], map: "idx_messages_tutor")
  @@index([tenantId, userId, createdAt(sort: Desc)], map: "idx_messages_user")
  @@map("messages")
}

/// Callback do provedor, append-only por trigger. É a prova de entrega — e a única
/// coisa que explica, semanas depois, por que uma mensagem consta como falhada.
model MessageEvent {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  messageId String @map("message_id") @db.Uuid

  event      MessageEventKind
  occurredAt DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(6)
  /// Payload bruto do provedor, para quando a dúvida for "o que exatamente ele disse".
  raw        Json?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, occurredAt], map: "idx_message_events_message")
  @@map("message_events")
}

/// **Só o que o petshop mudou.** Os textos padrão vivem em
/// `packages/shared-types/src/messaging-seed.ts` e a listagem é a união dos dois.
model MessageTemplate {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  key     String         @db.VarChar(60)
  channel MessageChannel

  subject String? @db.VarChar(160)
  body    String

  active  Boolean @default(true)
  /// Incrementa a cada gravação. Vai carimbada na mensagem para explicar, depois, com
  /// que texto ela saiu.
  version Int     @default(1)

  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// O índice já é criado em SQL na migration; declará-lo aqui é o que dá ao cliente
  /// o `upsert` por chave composta — e o que impede um diff futuro de recriá-lo.
  @@unique([tenantId, key, channel], map: "idx_templates_key")
  @@map("message_templates")
}

/// Um por tenant, como `taxi_settings` e `billing_settings`.
///
/// `enabled` nasce **false**: ligar o motor é decisão de quem responde pelo número e
/// pelo domínio de e-mail do petshop, não um padrão que se descobre pelo cliente
/// recebendo mensagem.
model MessagingSettings {
  tenantId String @id @map("tenant_id") @db.Uuid

  enabled Boolean @default(false)

  /// Decisão 16, no fuso do tenant. Minutos desde a meia-noite, como
  /// `professional_schedules` — a mesma unidade evita duas conversões diferentes de
  /// horário local no mesmo produto.
  quietStartMin Int @default(480) @map("quiet_start_min") @db.SmallInt
  quietEndMin   Int @default(1200) @map("quiet_end_min") @db.SmallInt

  marketingWeekdaysOnly Boolean @default(true) @map("marketing_weekdays_only")

  /// RN-05/RN-06. `TRANSACTIONAL` e `OPERATIONAL` não contam para o teto diário.
  dailyCap     Int @default(500) @map("daily_cap")
  perMinuteCap Int @default(20) @map("per_minute_cap") @db.SmallInt

  /// Quantas mensagens de MARKETING um mesmo tutor recebe em sete dias. O teto acima
  /// protege o número do petshop; este protege o tutor. `0` desliga.
  marketingWeeklyCap Int @default(1) @map("marketing_weekly_cap") @db.SmallInt

  defaultChannel  String @default("AUTO") @map("default_channel") @db.VarChar(10)
  retentionMonths Int    @default(24) @map("retention_months") @db.SmallInt

  senderName   String? @map("sender_name") @db.VarChar(60)
  replyToEmail String? @map("reply_to_email") @db.VarChar(160)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("messaging_settings")
}

/// Endereço que não se deve mais tentar — por hash, nunca em claro (AC-05 de
/// MOD-CRM-04).
///
/// Sobrevive à exclusão do tutor de propósito: guardar o hash de quem pediu para parar
/// é o que impede que o mesmo contato, recadastrado amanhã, volte a ser incomodado.
model MessagingSuppression {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  channel     MessageChannel
  addressHash String         @map("address_hash") @db.Char(64)

  reason    SuppressionReason
  /// Nulo = permanente.
  expiresAt DateTime?         @map("expires_at") @db.Timestamptz(6)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel, addressHash], map: "idx_suppressions_addr")
  @@map("messaging_suppressions")
}

/// O que o petshop ligou e com que parâmetros.
///
/// A linha só existe quando o petshop mexe: sem linha, vale o padrão do código. É a
/// mesma escolha de `message_templates`, pela mesma razão.
model Automation {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  key     String  @db.VarChar(60)
  enabled Boolean @default(true)

  channel     String  @default("AUTO") @db.VarChar(10)
  templateKey String? @map("template_key") @db.VarChar(60)

  /// Validado por união discriminada em `AutomationConfigSchema`, por chave.
  config Json @default("{}")

  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key], map: "idx_automations_key")
  @@map("automations")
}

enum CampaignType {
  INACTIVE
  BIRTHDAY
  DUNNING
  MANUAL
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  DONE
  CANCELLED
  FAILED
}

enum CampaignTargetStatus {
  SENT
  SKIPPED
  FAILED
}

enum CampaignSkipReason {
  NO_CONSENT
  ALREADY_TARGETED
  HAS_DEBT
  PET_DECEASED
  NO_CHANNEL
  SUPPRESSED
  WEEKLY_CAP
  ENQUEUE_FAILED
}

/// Uma campanha é **quem receber**, não o que enviar (MOD-CRM-07 e MOD-CRM-12).
///
/// O texto continua vindo do catálogo; o que a campanha acrescenta é o segmento, o
/// agendamento e a prestação de contas. `segment` é um filtro reproduzível em JSON e
/// **nunca** uma lista congelada de tutores: uma lista montada na segunda e disparada na
/// quinta convida de volta quem já voltou na terça.
model Campaign {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name   String         @db.VarChar(120)
  type   CampaignType
  status CampaignStatus @default(DRAFT)

  templateKey String @map("template_key") @db.VarChar(60)
  channel     String @default("AUTO") @db.VarChar(10)

  /// Validado por `CampaignSegmentSchema`. Objeto vazio = todo tutor ativo.
  segment Json @default("{}")

  scheduledFor DateTime? @map("scheduled_for") @db.Timestamptz(6)

  /// Disparo em massa tem autor. Nulo quando quem criou foi o job — a campanha de
  /// reativação nasce da automação, não de uma pessoa.
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   CampaignRun[]

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("campaigns")
}

/// Uma execução da campanha. Uma campanha manual costuma ter uma; a de reativação tem
/// uma por passada do job, e é a série delas que mostra se a régua está funcionando.
model CampaignRun {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  campaignId String @map("campaign_id") @db.Uuid

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  targeted Int @default(0)
  sent     Int @default(0)
  skipped  Int @default(0)
  failed   Int @default(0)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  targets  CampaignTarget[]

  @@index([campaignId, startedAt(sort: Desc)])
  @@map("campaign_runs")
}

/// Quem entrou na mira, e o que aconteceu com essa pessoa.
///
/// A linha é gravada **mesmo quando nada é enviado** — é ela que responde pelos pulados
/// da prévia, e é sobre ela que a carência da campanha de inativos consulta (AC-02 de
/// MOD-CRM-07): sem registrar quem foi pulado e quem recebeu, "não repetir em 60 dias"
/// não teria onde olhar.
model CampaignTarget {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  runId    String @map("run_id") @db.Uuid
  tutorId  String @map("tutor_id") @db.Uuid

  status     CampaignTargetStatus
  skipReason CampaignSkipReason?  @map("skip_reason")

  /// FK "solta" para `messages` de propósito: a retenção do MOD-CRM expurga mensagem
  /// antiga, e uma FK real levaria o histórico da campanha junto.
  messageId String? @map("message_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run    CampaignRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  tutor  Tutor       @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([runId, status], map: "idx_campaign_targets_run")
  @@index([tutorId, createdAt(sort: Desc)], map: "idx_campaign_targets_tutor")
  @@map("campaign_targets")
}

enum WhatsappInstanceStatus {
  NOT_CONFIGURED
  CONNECTING
  CONNECTED
  DISCONNECTED
  BANNED
}

/// A conexão do WhatsApp do petshop (MOD-CRM-01).
///
/// Uma linha por tenant: o número é o da empresa, não o de um atendente. É esta tabela
/// que torna a disponibilidade do canal uma pergunta **por tenant** — antes dela
/// `ChannelPort.available` era um booleano do processo inteiro, o que só servia
/// enquanto o único canal era o e-mail.
///
/// `warmup_started_at` não é decoração de auditoria: é a âncora do teto progressivo da
/// RN-06. Um número recém-pareado disparando quinhentas mensagens no primeiro dia é
/// banimento pedido, e o banimento custa o ativo mais caro do petshop — o número que
/// os clientes já têm salvo.
model WhatsappInstance {
  tenantId String @id @map("tenant_id") @db.Uuid

  provider     String @default("evolution") @db.VarChar(20)
  /// `tenant-<slug>` na Evolution. Fica gravado porque o slug do tenant é travado, mas
  /// o nome da instância precisa sobreviver a qualquer mudança futura dele.
  instanceName String @map("instance_name") @db.VarChar(80)

  status WhatsappInstanceStatus @default(NOT_CONFIGURED)

  /// Preenchido no pareamento, pelo que o provedor informa. É público — é o número que
  /// o petshop divulga —, então não é cifrado.
  phoneE164 String? @map("phone_e164") @db.VarChar(20)

  /// A chave da instância na Evolution, cifrada com a DEK do tenant.
  apiKeyEncrypted String? @map("api_key_encrypted")

  /// Autentica o callback (RN-11). Só o hash: quem lê o banco não consegue forjar um
  /// webhook, e o token em claro existe uma única vez, na criação da instância.
  webhookTokenHash String? @map("webhook_token_hash") @db.Char(64)

  connectedAt     DateTime? @map("connected_at") @db.Timestamptz(6)
  lastSeenAt      DateTime? @map("last_seen_at") @db.Timestamptz(6)
  warmupStartedAt DateTime? @map("warmup_started_at") @db.Timestamptz(6)

  /// O que o provedor disse quando a conexão caiu ou o número foi bloqueado. Serve à
  /// faixa vermelha da tela — "desconectado" sem motivo não ajuda ninguém a reconectar.
  lastError String? @map("last_error") @db.VarChar(300)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// A busca do webhook é por hash, no escopo de plataforma: o callback chega sem saber
  /// de que tenant é, e é este índice que o resolve.
  @@index([webhookTokenHash], map: "idx_whatsapp_webhook_token")
  @@map("whatsapp_instances")
}

// ---------------------------------------------------------------------------
// MOD-SITE — o site do estabelecimento
// ---------------------------------------------------------------------------

enum SitePhotoKind {
  HERO
  GALLERY
}

enum SiteLeadStatus {
  NEW
  CONTACTED
  CONVERTED
  DISCARDED
}

/// Conteúdo e estado de publicação do site (MOD-SITE-01 e 03).
///
/// Uma linha por tenant, e quase tudo opcional: a página nasce montada do que o
/// petshop já cadastrou em `tenants` e `tenant_settings` — nome, logo, cores,
/// endereço, telefone, horário. O que mora aqui são os **quatro textos livres** e as
/// chaves que ligam ou desligam partes da página. Não há editor de blocos: cada campo
/// a mais é um campo que fica desatualizado (decisão de produto de 2026-08-28).
model SiteSettings {
  tenantId String @id @map("tenant_id") @db.Uuid

  published   Boolean   @default(false)
  /// Primeira publicação. Nunca é limpo ao despublicar — é a data em que o site
  /// passou a existir, e serve de métrica.
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  /// Os quatro textos livres. Vazios, a página usa padrões derivados do cadastro.
  headline   String? @db.VarChar(120)
  about      String? @db.VarChar(800)
  /// Faixa temporária: "fechados dia 25". Some sozinha quando o admin a apaga.
  notice     String? @db.VarChar(200)
  footerNote String? @map("footer_note") @db.VarChar(200)

  /// A faixa "a partir de R$ X" da vitrine (MOD-SITE-05).
  showPrices      Boolean @default(true) @map("show_prices")
  leadFormEnabled Boolean @default(true) @map("lead_form_enabled")

  /// Sobrescrevem os metadados derivados (AC-05 de MOD-SITE-10). Vazios, voltam ao
  /// derivado — nunca ficam em branco na página.
  seoTitle       String? @map("seo_title") @db.VarChar(60)
  seoDescription String? @map("seo_description") @db.VarChar(160)
  ogImageUrl     String? @map("og_image_url")

  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("site_settings")
}

/// Fotos do estabelecimento e da equipe (MOD-SITE-04).
///
/// **Não é `pet_photos`.** A origem é upload novo e deliberado: reaproveitar o álbum
/// do pet na página pública transformaria consentimento de guarda em consentimento de
/// publicação, que são coisas diferentes (AC-03).
model SitePhoto {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Chave no R2, segregada por tenant (SPEC §214). A URL pública é montada pelo
  /// frontend a partir do id — o bucket continua privado.
  storageKey String        @map("storage_key")
  /// Acessibilidade e SEO de imagem.
  alt        String?       @db.VarChar(120)
  kind       SitePhotoKind @default(GALLERY)
  position   Int           @default(0) @db.SmallInt

  widthPx     Int?   @map("width_px")
  heightPx    Int?   @map("height_px")
  contentType String @map("content_type") @db.VarChar(60)
  sizeBytes   Int    @map("size_bytes")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind, position], map: "idx_site_photos_tenant_kind")
  @@map("site_photos")
}

/// Quem preencheu o formulário do site (MOD-SITE-08 e 09).
///
/// A primeira categoria de **pessoa sem vínculo nenhum** do sistema: não é cliente,
/// não é funcionário, e talvez nunca mais apareça. Daí a cifra no telefone e no
/// e-mail — mais justificada aqui que em `tutors`, porque não há relação contratual
/// que justifique guardar em claro — e daí a retenção do RN-11.
model SiteLead {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name           String  @db.VarChar(120)
  /// AES-256-GCM, formato `v1:<iv>:<tag>:<ct>`, como todo telefone do sistema.
  phoneEncrypted String  @map("phone_encrypted")
  /// `hashSearchable('lead_phone', …)` — casa com `tutors.phone_hash` (AC-04).
  phoneHash      String  @map("phone_hash")
  emailEncrypted String? @map("email_encrypted")
  message        String? @db.VarChar(1000)

  status SiteLeadStatus @default(NEW)

  /// Preenchido quando o telefone já é de um cliente: a equipe precisa saber que não
  /// é aquisição, é um cliente que não achou o WhatsApp.
  existingTutorId  String? @map("existing_tutor_id") @db.Uuid
  convertedTutorId String? @map("converted_tutor_id") @db.Uuid
  /// Anotação da equipe ao mudar o status.
  note             String? @db.VarChar(500)

  /// Antiabuso, retenção curta (90 dias).
  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent") @db.VarChar(300)

  /// Quando o PII foi apagado pela retenção. A linha fica, para estatística.
  purgedAt  DateTime? @map("purged_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt(sort: Desc)], map: "idx_site_leads_tenant_status")
  @@index([tenantId, phoneHash], map: "idx_site_leads_phone_hash")
  @@map("site_leads")
}

// ─── MOD-PORTAL ──────────────────────────────────────────────────────────────

enum PortalChannel {
  EMAIL
  WHATSAPP
}

/// O desafio que liga uma conta do Clerk a uma ficha de tutor (MOD-PORTAL-01).
///
/// **A linha nasce mesmo quando o identificador não casa com ficha nenhuma**, e é isso
/// que sustenta a resposta uniforme do RN-04: sem ela, o rate limit só contaria as
/// tentativas bem-sucedidas e o silêncio na tabela seria, ele próprio, a resposta de
/// "esta pessoa não é cliente daqui".
///
/// Nada aqui é cifrado, e é decisão, não esquecimento: o identificador é *hash* porque
/// só se busca por igualdade, e o código é *hash* porque nunca precisa ser lido de
/// volta, só comparado. Cifrar daria a ilusão de proteção com a chave ao lado.
model PortalLinkChallenge {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Nulo quando não casou com ficha nenhuma.
  tutorId String? @map("tutor_id") @db.Uuid

  /// `hashSearchable('portal:identifier', …)` — nunca o e-mail ou o telefone em claro.
  identifierHash String        @map("identifier_hash")
  channel        PortalChannel
  /// HMAC do código de 6 dígitos.
  codeHash       String        @map("code_hash")

  /// Quem pediu. O vínculo só se completa se **o mesmo** usuário verificar — sem isso,
  /// um código interceptado valeria para qualquer conta.
  clerkUserId String @map("clerk_user_id")

  /// Marca o caso do AC-06: o mesmo telefone em duas fichas. Escolher uma por conta
  /// própria daria a um dos dois o extrato financeiro do outro.
  ambiguous Boolean @default(false)

  attempts Int     @default(0) @db.SmallInt
  blocked  Boolean @default(false)

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)

  ipAddress String?  @map("ip_address") @db.Inet
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tutor  Tutor? @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tenantId, identifierHash, createdAt(sort: Desc)], map: "idx_portal_challenges_tenant_identifier")
  @@map("portal_link_challenges")
}

/// O campo de contato cuja troca exige prova de posse (MOD-PORTAL-09, AC-02).
enum PortalContactField {
  PHONE
  EMAIL
}

/// A troca de telefone ou e-mail que ainda não aconteceu.
///
/// **Tabela própria, e não uma variante de `portal_link_challenges`.** As duas mandam um
/// código de seis dígitos e param por aí. O desafio de vínculo é construído inteiro em
/// torno da resposta uniforme do RN-04 — ele grava linha para identificador que não casa
/// com ficha nenhuma, justamente para que o silêncio não denuncie quem é cliente. Aqui
/// não há nada a esconder: quem pede já está autenticado e já é dono da ficha. Juntar as
/// duas obrigaria cada consulta a lembrar de qual `purpose` está lendo, e o dia em que
/// alguém esquecesse, um desafio de troca responderia como desafio de acesso.
///
/// O valor pendente é **cifrado**, e não hasheado como o identificador do vínculo: ele
/// precisa ser lido de volta para virar o telefone da ficha quando o código confere. O
/// hash ao lado existe para outra pergunta — se este contato já é de outra ficha —, e é
/// o mesmo `hashSearchable` que o tutor-service grava, senão a comparação nunca casaria.
model PortalContactChange {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  /// Sempre presente, ao contrário do desafio de vínculo: aqui se sabe de quem é.
  tutorId  String @map("tutor_id") @db.Uuid

  field   PortalContactField
  /// Por onde o código saiu. Decorre de `field`, e fica gravado porque é o que
  /// aconteceu — o mapa pode mudar, a linha antiga não.
  channel PortalChannel

  /// O valor novo, com a DEK do tenant. Só vira contato da ficha depois do código.
  pendingValueEncrypted String @map("pending_value_encrypted")
  /// `hashSearchable('tutor:phone' | 'tutor:email', …)` — para a checagem de duplicata.
  pendingValueHash      String @map("pending_value_hash")

  /// HMAC do código, com o id da linha no namespace, como no desafio de vínculo.
  codeHash String @map("code_hash")

  attempts Int     @default(0) @db.SmallInt
  blocked  Boolean @default(false)

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)

  ipAddress String?  @map("ip_address") @db.Inet
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tutor  Tutor  @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tenantId, tutorId, createdAt(sort: Desc)], map: "idx_portal_contact_changes_tutor")
  @@map("portal_contact_changes")
}

enum DataDeletionRequestStatus {
  OPEN
  DONE
  REJECTED
}

/// O pedido de exclusão de dados do titular (LGPD art. 18, V; AC-05 de MOD-PORTAL-09).
///
/// **É pedido, e não execução.** A anonimização do MOD-SEC apaga a ficha de alguém que
/// pode ter débito aberto e nota fiscal com prazo de guarda — a decisão precisa de gente,
/// e o que o Portal faz é registrar e cobrar o prazo.
///
/// A linha existe porque registrar num log não é encaminhar: o pedido só chega à equipe
/// se houver fila que alguém veja, e é ela que o sino da topbar conta. `due_at` é gravado
/// no pedido em vez de calculado na leitura para que o prazo não mude se a regra mudar —
/// o que foi prometido ao titular naquele dia foi aquilo.
///
/// `ip_address` e `user_agent` são **prova** de quem pediu, pela mesma razão de
/// `tutor_consents`: um pedido de exclusão contestado depois precisa mostrar de onde veio.
model DataDeletionRequest {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tutorId  String @map("tutor_id") @db.Uuid

  status DataDeletionRequestStatus @default(OPEN)

  /// O que o titular escreveu, sem obrigação de escrever nada. Em claro, como
  /// `tutors.notes`: é texto de trabalho da equipe, e cifrá-lo esconderia da fila o que
  /// a fila existe para ler.
  reason String?

  /// Quinze dias a partir do pedido (art. 19, II), congelado na criação.
  dueAt DateTime @map("due_at") @db.Timestamptz(6)

  respondedAt DateTime? @map("responded_at") @db.Timestamptz(6)
  respondedBy String?   @map("responded_by") @db.Uuid
  /// O que a equipe respondeu. O titular lê esta frase no Portal.
  resolution  String?

  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tutor  Tutor  @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, dueAt], map: "idx_deletion_requests_tenant_status")
  @@index([tutorId, createdAt(sort: Desc)], map: "idx_deletion_requests_tutor")
  @@map("data_deletion_requests")
}

// ─── MOD-DOC — documentos formais (PRD documentos_pdf_11 §4) ─────────────────

enum DocumentKind {
  RECEIPT
  PRESCRIPTION
  TERM_ACCEPTANCE
  IMAGE_CONSENT
}

enum DocumentStatus {
  PENDING
  ISSUED
  FAILED
  CANCELLED
}

/// O registro de todo documento com valor legal emitido pelo sistema.
///
/// **O que entra aqui é o que precisa bater, byte a byte, com o papel entregue.**
/// Extrato e relatório ficam de fora de propósito (RN-01): descrevem o estado atual e
/// são regerados a cada pedido — um extrato guardado é um extrato errado uma semana
/// depois.
///
/// A tabela é o dono do arquivo. `receipts` guarda número, status e reprocesso do
/// recibo e aponta para cá; era o `document_id` que o schema do MOD-LEDGER já previa e
/// não tinha para onde apontar.
model Document {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  kind   DocumentKind
  /// Série do §MOD-DOC-03. `2026/000123` no recibo, `RX-2026/000004` no resto.
  number String       @db.VarChar(24)

  /// Sujeito. Nulo em documento sem titular — e é por `tutor_id` que o Portal filtra,
  /// nunca por tipo, para que um tipo novo não vaze por esquecimento (AC-03 de
  /// MOD-DOC-10).
  tutorId String? @map("tutor_id") @db.Uuid
  petId   String? @map("pet_id") @db.Uuid

  /// Chave no R2. Nula enquanto `PENDING`.
  storageKey String? @map("storage_key")
  /// SHA-256 do arquivo. É a base do código de conferência do MOD-DOC-12.
  checksum   String? @db.Char(64)
  sizeBytes  Int?    @map("size_bytes")

  status DocumentStatus @default(PENDING)

  issuedAt       DateTime? @map("issued_at") @db.Timestamptz(6)
  /// Fim da guarda obrigatória: cinco anos (RN-17). Nem o pedido de exclusão do art. 18
  /// apaga documento emitido — ele anonimiza o cadastro.
  retentionUntil DateTime? @map("retention_until") @db.Date

  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  /// Última falha, para o job de reprocesso não ser cego.
  lastError String? @map("last_error")
  attempts  Int     @default(0)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receipt      Receipt?
  prescription Prescription?
  consent      TutorConsent?

  @@unique([tenantId, kind, number], map: "idx_documents_number")
  @@index([tenantId, kind, issuedAt(sort: Desc)], map: "idx_documents_tenant_kind")
  @@index([tenantId, tutorId, issuedAt(sort: Desc)], map: "idx_documents_tenant_tutor")
  @@map("documents")
}

/// O receituário veterinário (MOD-DOC-04, fecha o MOD-PRONT-07).
///
/// É o documento mais delicado do sistema: erra a dosagem e mata o animal, sai sem
/// CRMV e expõe o profissional, muda depois de emitido e deixa de ser prova. Daí as
/// três decisões que a tabela carrega.
///
/// **Não há UPDATE de conteúdo.** Nenhuma rota edita `items_encrypted` — a janela de
/// 24h que a RN-05 do MOD-PRONT concede ao atendimento vale para o registro clínico,
/// **não** para o papel que saiu pela porta. Corrigir é anular e emitir outra, e a
/// anulada continua visível com o motivo.
///
/// **O CRMV é snapshot.** O prescritor que corrigir o próprio registro amanhã não
/// reescreve o que já imprimiu (AC-03 de MOD-DOC-05) — e o job de reprocesso, que pode
/// renderizar o PDF dias depois, precisa imprimir o que era verdade no dia.
///
/// O número e o arquivo moram em `documents`: aqui fica só o que é da prescrição.
model Prescription {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  petId        String @map("pet_id") @db.Uuid
  attendanceId String @map("attendance_id") @db.Uuid

  /// `professionals.id` do prescritor — quem assina, e não quem conduziu o
  /// atendimento: são a mesma pessoa no caminho normal e podem não ser no encaixe.
  vetId String @map("vet_id") @db.Uuid
  /// Snapshot do registro no dia, na forma impressa: `12345/SP`.
  crmv  String @map("crmv") @db.VarChar(20)

  /// JSON dos itens, cifrado com a DEK do tenant. Sigilo profissional veterinário
  /// (Res. CFMV 1.138/2016) — a mesma justificativa do `observations_encrypted`.
  itemsEncrypted        String  @map("items_encrypted")
  /// Orientações ao tutor. Cifradas pelo mesmo motivo.
  instructionsEncrypted String? @map("instructions_encrypted")

  /// O PDF. Nulo é impossível na prática — a linha nasce junto do documento, na mesma
  /// transação —, e opcional no schema porque a FK é `Restrict`: apagar o documento
  /// não pode deixar a prescrição órfã em silêncio.
  documentId String? @unique @map("document_id") @db.Uuid

  issuedAt DateTime @map("issued_at") @db.Timestamptz(6)

  /// Anulação. O motivo é obrigatório quando há data — anulação sem motivo é
  /// exclusão disfarçada, a mesma regra do atendimento.
  voidedAt   DateTime? @map("voided_at") @db.Timestamptz(6)
  voidReason String?   @map("void_reason")
  voidedBy   String?   @map("voided_by") @db.Uuid

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  pet        Pet          @relation(fields: [petId], references: [id], onDelete: Restrict)
  attendance Attendance   @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  vet        Professional @relation(fields: [vetId], references: [id], onDelete: Restrict)
  document   Document?    @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([tenantId, petId, issuedAt(sort: Desc)], map: "idx_prescriptions_tenant_pet")
  @@index([tenantId, attendanceId], map: "idx_prescriptions_tenant_attendance")
  @@map("prescriptions")
}

enum TermKind {
  TERMS
  SERVICE_LIABILITY
  IMAGE_USE
}

/// O texto do termo, por tenant e por versão (MOD-DOC-06).
///
/// **A tabela existe porque a prova já existia.** `CURRENT_TERMS_VERSION = '1.0'` estava
/// cravada no código desde o MOD-TUTOR, e toda linha de `tutor_consents` gravava esse
/// número como prova de um documento que não existia em lugar nenhum — nem para o tutor
/// reler, nem para o petshop mostrar o que apresentou.
///
/// **Versão publicada é imutável.** Não há rascunho, não há edição e não há exclusão:
/// corrigir o texto que alguém aceitou é falsificar o contrato de todos que aceitaram.
/// O caminho é publicar a versão seguinte, e a anterior continua legível para sempre —
/// é ela que explica o aceite antigo.
///
/// **Todo tenant nasce com as três versões `1.0` da plataforma**, semeadas no
/// provisionamento, e o parque anterior foi preenchido pela migration com o mesmo
/// número. Sem isso, o primeiro aceite validado contra esta tabela invalidaria de uma
/// vez tudo o que já havia sido aceito.
model TermVersion {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  kind TermKind
  /// `1.0`, `2.0`. Ordinal, não texto livre — é o que a comparação de vigência usa.
  version String @db.VarChar(20)

  title String @db.VarChar(120)
  /// Markdown restrito: título, parágrafo, lista e negrito. Nada de HTML — o texto é
  /// digitado pelo tenant e desenhado num Chromium.
  body  String

  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  /// Nulo nas versões semeadas: quem publicou foi a plataforma, não uma pessoa.
  publishedBy String?  @map("published_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, version], map: "idx_term_versions_version")
  @@index([tenantId, kind, publishedAt(sort: Desc)], map: "idx_term_versions_current")
  @@map("term_versions")
}

/// Contador por tenant, tipo e ano (RN-16).
///
/// Uma `CREATE SEQUENCE` do Postgres é global e não sabe de tenant; criar uma por
/// tenant exigiria DDL em tempo de execução. `INSERT … ON CONFLICT DO UPDATE …
/// RETURNING` é atômico numa instrução e cabe na transação que originou o documento.
///
/// Herdeira de `receipt_counters`, com o `last_number` de cada tenant preservado: a
/// série do recibo já emitida não é renumerada.
model DocumentCounter {
  tenantId   String       @map("tenant_id") @db.Uuid
  kind       DocumentKind
  year       Int
  lastNumber Int          @default(0) @map("last_number")

  @@id([tenantId, kind, year])
  @@map("document_counters")
}

// ═══════════════════════════════════════════════════════════════════════════
// MOD-AI — a conversa que chega (PRD agentes_ia_15 §4)
// ═══════════════════════════════════════════════════════════════════════════

enum AgentConversationStatus {
  ACTIVE
  HANDOFF
  ASSIGNED
  CLOSED
}

/// O registro em que o agente fala com o cliente (MOD-AI-07).
///
/// `SOBRIO` é o comportamento anterior à humanização, preservado como escolha: há
/// petshop cujo público não quer conversa. `CORDIAL` é o padrão — trata pelo nome e
/// admite um emoji ocasional. `CALOROSO` é a recepção que escreve como quem conhece o
/// cliente de balcão.
enum AgentTone {
  SOBRIO
  CORDIAL
  CALOROSO
}

enum AgentHandoffReason {
  REQUESTED
  SENTIMENT
  UNRESOLVED
  TOO_LONG
  BUDGET
  ERROR
  DISABLED
  UNKNOWN_NUMBER
  AMBIGUOUS
  MEDIA
  OUT_OF_HOURS
  WRITE_FAILED
}

/// O ciclo de uma chamada de tool (MOD-AI-04).
///
/// Leitura nasce e morre em `EXECUTED` ou `FAILED`. Escrita entra por `PROPOSED` e sai
/// por um dos três: o tutor confirmou, pediu outra coisa, ou demorou demais.
enum AgentToolCallStatus {
  EXECUTED
  PROPOSED
  CONFIRMED
  SUPERSEDED
  EXPIRED
  FAILED
}

enum AgentTurnRole {
  TUTOR
  AGENT
  STAFF
}

enum AgentSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum AgentInboundKind {
  TEXT
  AUDIO
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

/// A conversa de um número com o estabelecimento (MOD-AI-02).
///
/// **A chave é o telefone, e não o tutor**, e é a diferença que separa esta tabela de
/// tudo o que o produto tinha até aqui. `tutor_id` é nulo em dois casos legítimos — o
/// número sem ficha (AC-02 de MOD-AI-01) e o número em duas fichas (AC-03) — e nos dois
/// a conversa existe, precisa ser respondida e não tem dono. Guardar o contato cifrado
/// aqui é o que permite continuar a mesma conversa quando a segunda mensagem chegar.
model AgentConversation {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Nulo é número não reconhecido, ou reconhecido demais — ver o comentário do modelo.
  tutorId String?        @map("tutor_id") @db.Uuid
  channel MessageChannel @default(WHATSAPP)

  /// O telefone E.164 de quem escreveu, cifrado com a DEK do tenant. O hash ao lado é o
  /// que reencontra a conversa viva sem decifrar linha por linha — o mesmo desenho de
  /// `messages.to_hash`.
  contactEncrypted String @map("contact_encrypted")
  contactHash      String @map("contact_hash") @db.Char(64)

  status        AgentConversationStatus @default(ACTIVE)
  handoffReason AgentHandoffReason?     @map("handoff_reason")
  handoffAt     DateTime?               @map("handoff_at") @db.Timestamptz(6)

  /// Quem da equipe assumiu (AC-02 de MOD-AI-06). Sem FK: `users` é global e o membro
  /// pode sair do estabelecimento sem levar o histórico da conversa junto.
  assignedTo String?   @map("assigned_to") @db.Uuid
  assignedAt DateTime? @map("assigned_at") @db.Timestamptz(6)

  /// Acumulado do modelo, em **milésimos de centavo** (RN-13).
  ///
  /// A unidade não é a do §4 do PRD, e a razão está na migration: um turno custa uma
  /// fração de centavo, e em centavos inteiros todo turno arredondaria para zero — o
  /// teto mensal nunca seria alcançado e o custo por conversa seria sempre zero.
  costMillicents Int @default(0) @map("cost_millicents")
  turnCount      Int @default(0) @map("turn_count")

  /// Desde quando há turno do tutor esperando resposta — e, ao mesmo tempo, a posse de
  /// quem está respondendo agora (ver a migration). Nulo = nada pendente.
  pendingAt DateTime? @map("pending_at") @db.Timestamptz(6)

  /// Turnos seguidos em que nenhuma consulta deu certo (AC-03 de MOD-AI-05). Três e a
  /// conversa vai para gente; qualquer tool bem-sucedida zera.
  unresolvedStreak Int @default(0) @map("unresolved_streak") @db.SmallInt

  /// Base da expiração (AC-02 de MOD-AI-02) e da ordenação da fila.
  lastTurnAt DateTime  @default(now()) @map("last_turn_at") @db.Timestamptz(6)
  closedAt   DateTime? @map("closed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  turns     AgentTurn[]
  toolCalls AgentToolCall[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// `SetNull` e não `Cascade`: a anonimização do titular (MOD-TUTOR-08) apaga o corpo
  /// dos turnos e solta o vínculo, e a contagem sobrevive para o painel de qualidade.
  tutor  Tutor? @relation(fields: [tutorId], references: [id], onDelete: SetNull)

  @@index([tenantId, status], map: "idx_agent_conv_tenant_status")
  @@map("agent_conversations")
}

/// A configuração do agente, um por tenant (MOD-AI-07).
///
/// `enabled` nasce **falso**: ligar um robô que fala com o cliente em nome do petshop é
/// decisão de quem responde pelo número — o mesmo critério de `MessagingSettings`.
model AgentSettings {
  tenantId String @id @map("tenant_id") @db.Uuid

  enabled Boolean @default(false)

  /// Hora local do estabelecimento, `HH:MM`. Fora da janela o modelo não é chamado.
  opensAt  String @default("08:00") @map("opens_at") @db.VarChar(5)
  closesAt String @default("19:00") @map("closes_at") @db.VarChar(5)

  /// Teto de gasto do mês com o provedor, em centavos (AC-02 de MOD-AI-08).
  monthlyCapCents Int @default(50000) @map("monthly_cap_cents")

  /// Como o agente se apresenta e conversa (MOD-AI-07).
  ///
  /// `persona_name` é o **primeiro nome** que ele usa ao se apresentar, e nulo é o
  /// padrão: sem nome ele diz "sou o atendimento automático do <petshop>". O nome entra
  /// no aviso de automação, **nunca no lugar dele** — o §9 do PRD exige que o cliente
  /// saiba que fala com um robô, e uma persona que substituísse o aviso seria
  /// exatamente a forma de apagá-lo sem parecer que se apagou.
  personaName String?   @map("persona_name") @db.VarChar(24)
  tone        AgentTone @default(CORDIAL)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("agent_settings")
}

/// Um turno é uma mensagem da conversa, de qualquer um dos três lados.
///
/// `content_encrypted` é o campo mais sensível do módulo (§9): é o que o cliente
/// resolveu escrever, e pode conter qualquer coisa que o produto cifra em toda outra
/// tabela. `message_id` liga ao que entrou ou saiu pelo motor do MOD-NOTIF — nulo só
/// quando o turno não virou mensagem, que é o caso da resposta automática de sistema.
model AgentTurn {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid

  role      AgentTurnRole
  kind      AgentInboundKind @default(TEXT)
  messageId String?          @map("message_id") @db.Uuid

  contentEncrypted String @map("content_encrypted")

  /// De `response.usage`, para o custo sair do medido e não do estimado (RN-13).
  inputTokens     Int @default(0) @map("input_tokens")
  outputTokens    Int @default(0) @map("output_tokens")
  cacheReadTokens Int @default(0) @map("cache_read_tokens")
  /// O que este turno custou, em milésimos de centavo. Ver o comentário da conversa.
  costMillicents  Int @default(0) @map("cost_millicents")

  sentiment AgentSentiment?
  /// Quem escreveu, quando foi gente da equipe.
  authorId  String?         @map("author_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolCalls    AgentToolCall[]

  @@index([conversationId, createdAt], map: "idx_agent_turns_conv")
  @@index([tenantId, createdAt], map: "idx_agent_turns_custo")
  @@map("agent_turns")
}

/// O que o agente fez, e o que ele ainda só propôs (MOD-AI-04).
///
/// **A proposta existe para o "sim" ter um antecedente.** O agente oferece um horário, a
/// linha nasce `PROPOSED` com um token e um prazo, e a confirmação do turno seguinte
/// aponta para ela — e não para o que o modelo lembrar de ter oferecido. Uma viva por
/// conversa, garantido por índice único parcial e não por leitura seguida de escrita.
///
/// A leitura também entra aqui, como `EXECUTED`: a pergunta do painel de qualidade é o
/// que o agente fez na conversa, e uma consulta que falhou conta essa história tanto
/// quanto uma proposta que virou agendamento.
model AgentToolCall {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  conversationId String @map("conversation_id") @db.Uuid
  /// Nulo enquanto a linha nasce dentro do turno — o turno só é gravado quando o modelo
  /// termina de falar, e a chamada acontece no meio. O `runner` costura os dois.
  turnId         String? @map("turn_id") @db.Uuid

  tool String @db.VarChar(40)

  /// **Cifrado** — carrega id de pet, data e horário escolhido (§4).
  argumentsEncrypted String  @map("arguments_encrypted")
  /// Em claro e curto: "3 horários", "Pet não encontrado", "agendamento criado".
  resultSummary      String? @map("result_summary")

  status AgentToolCallStatus

  /// Só nas propostas, e conferido **dentro** da conversa: um token que valesse em
  /// qualquer conversa seria uma chave de escrita viajando pelo WhatsApp.
  confirmationToken String?   @map("confirmation_token") @db.VarChar(64)
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz(6)
  /// Quando deixou de estar viva — confirmada, superada ou vencida.
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  turn         AgentTurn?        @relation(fields: [turnId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt], map: "idx_agent_tool_calls_conv")
  @@index([tenantId, createdAt], map: "idx_agent_tool_calls_periodo")
  @@map("agent_tool_calls")
}

/// Camada comercial, fatia 4 — a assinatura do estabelecimento (Asaas).
///
/// Uma linha por estabelecimento: a situação de agora, e não o histórico, que é do Asaas.
/// `plan` é o **contratado**; só vira `tenants.plan` com o pagamento confirmado.
/// Índices únicos parciais e RLS em `20260921130000_assinatura`.
model TenantSubscription {
  tenantId String @id @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  provider String             @default("asaas") @db.VarChar(20)
  plan     Plan
  method   BillingMethod
  cycle    BillingCycle       @default(MONTHLY)
  status   SubscriptionStatus @default(PENDING)

  /// O preço **contratado**, congelado. É o grandfathering: mexer em `plan_prices` não o toca.
  priceCents Int? @map("price_cents")

  /// A descida de plano que espera a renovação (só no anual). `plan` segue em vigor até lá.
  scheduledPlan Plan? @map("scheduled_plan")
  /// O preço que a descida agendada vai custar, fixado quando ela foi agendada.
  scheduledPriceCents Int? @map("scheduled_price_cents")
  /// O fim do período pago. É por ele que a subida proporcional sabe quantos meses faltam.
  currentPeriodEndsAt DateTime? @map("current_period_ends_at") @db.Timestamptz(6)

  providerCustomerId     String? @map("provider_customer_id") @db.VarChar(64)
  providerSubscriptionId String? @map("provider_subscription_id") @db.VarChar(64)
  providerCheckoutId     String? @map("provider_checkout_id") @db.VarChar(64)

  /// O link para pagar o que está em aberto: fatura do PIX ou checkout do cartão.
  paymentUrl   String?   @map("payment_url")
  overdueSince DateTime? @map("overdue_since") @db.Timestamptz(6)
  lastPaidAt   DateTime? @map("last_paid_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tenant_subscriptions")
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingMethod {
  CREDIT_CARD
  PIX
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

/// O preço vigente de um plano — o de quem assina a partir de agora.
///
/// Sem `tenant_id` e sem RLS, como `platform_admins`: o preço é da instalação. Linha
/// ausente significa "usa o padrão do catálogo", que é diferente de alguém ter escolhido
/// exatamente o padrão — por isso a tabela nasce vazia.
model PlanPrice {
  plan             Plan     @id
  priceCents       Int      @map("price_cents")
  priceYearlyCents Int      @map("price_yearly_cents")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?  @map("updated_by") @db.Uuid
  updatedByUser    User?    @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("plan_prices")
}

// ─── MOD-IMPORT — a carga da base do sistema anterior ────────────────────────
//
// Duas tabelas, e é o que separa a importação de um `COPY` de madrugada: elas guardam
// o que ENTROU, linha por linha, e é essa lista que permite desfazer.
//
// **Nenhum dado de domínio é escrito por elas.** O módulo compõe os serviços de
// MOD-TUTOR, MOD-PET e MOD-AGENDA por porta declarada, então o tutor importado nasce
// com a mesma validação, a mesma cifragem, o mesmo evento e a mesma trilha do tutor
// cadastrado à mão. Um `INSERT` direto seria mais rápido de escrever e criaria uma
// segunda verdade por tabela — a que envelhece quando a regra muda de um lado só.

enum ImportEntity {
  TUTOR
  PET
  PROFISSIONAL
  AGENDA
}

enum ImportBatchStatus {
  APLICADO
  DESFEITO
}

enum ImportOutcome {
  CRIADO
  ATUALIZADO
  IGNORADO
  ERRO
}

model ImportBatch {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  entity   ImportEntity
  fileName String       @map("file_name") @db.VarChar(200)

  /// SHA-256 do conteúdo. É o que permite avisar "este arquivo já foi aplicado em tal
  /// dia" a quem sobe duas vezes — e é a prova de que o aplicado é o que foi conferido,
  /// já que o arquivo não fica guardado entre os dois passos.
  fileHash String @map("file_hash") @db.VarChar(64)

  /// O mapeamento coluna → campo que o humano confirmou. Guardado porque é a única
  /// forma de reler o relatório de um lote antigo e entender de onde cada valor veio;
  /// sem ele, "Nome" não diz se era o do pet ou o do tutor.
  mapping Json @default("{}")

  rowCount     Int @default(0) @map("row_count")
  createdCount Int @default(0) @map("created_count")
  updatedCount Int @default(0) @map("updated_count")
  ignoredCount Int @default(0) @map("ignored_count")
  failedCount  Int @default(0) @map("failed_count")

  status ImportBatchStatus @default(APLICADO)

  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  undoneAt  DateTime? @map("undone_at") @db.Timestamptz(6)

  rows ImportRow[]

  @@index([tenantId, createdAt(sort: Desc)], map: "idx_import_batches_tenant")
  @@map("import_batches")
}

/// Uma linha por linha do arquivo. É trilha **e** lista de desfazer ao mesmo tempo: o
/// `undo` apaga só o que tem `outcome = CRIADO`, nunca o que foi atualizado — quem
/// reimportou por cima de um cadastro que já existia não quer que desfazer o apague.
///
/// Append-only na prática (nada aqui é editado depois), mas sem o privilégio de
/// imutabilidade de `audit_logs`: isto é registro operacional, e o lote precisa poder
/// ser marcado como desfeito.
model ImportRow {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  batchId  String @map("batch_id") @db.Uuid

  /// Repetida do lote de propósito: o desfazer percorre por (lote, resultado) e a
  /// consulta não precisa do JOIN só para saber o que apagar.
  entity ImportEntity
  lineNo Int          @map("line_no")

  /// A chave natural daquela linha — é o que o relatório mostra para o operador achá-la
  /// na planilha dele.
  ref      String?       @db.VarChar(200)
  outcome  ImportOutcome
  entityId String?       @map("entity_id") @db.Uuid
  message  String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, outcome], map: "idx_import_rows_batch")
  @@map("import_rows")
}
