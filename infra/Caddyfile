# Borda do PetShop AI. O único processo com porta aberta para a internet.
#
# Duas decisões estão embutidas aqui:
#
# 1. Do gateway publica-se o MÍNIMO, host a host e caminho a caminho — nunca o
#    processo inteiro. O cliente HTTP do frontend é `server-only`, então o Admin,
#    o site e o Portal na web não precisam de endereço público nenhum: falam pela
#    rede interna do compose. O que precisa é quem nasce FORA e não alcança essa
#    rede, e hoje são dois casos:
#
#      - os webhooks de provedor (`/internal/…`), no ápice;
#      - o app do tutor, em `api.{$APP_DOMAIN}` — o caso que este comentário
#        antecipava como "se um dia o MOD-PORTAL precisar". Um aparelho não tem
#        rede interna, e aí não há alternativa.
#
#    O recorte do `api.` é por CAMINHO, e é a parte que importa: só `/portal/v1`
#    e o catálogo de estabelecimentos. O `/v1` do Admin e o `/platform/v1` do
#    console continuam sem endereço na internet, e é isso que impede uma rota
#    administrativa nova de nascer publicada por engano.
#
#    O CORS continua irrelevante: cliente nativo não manda `Origin`.
#
# 2. O wildcard existe porque o slug do tenant é subdomínio. Ele exige DNS-01, que
#    exige o módulo da Cloudflare (ver Dockerfile.caddy) e um token de API com
#    permissão de editar a zona.
{
	email {$ACME_EMAIL}

	servers {
		# ── Quando o Caddy NÃO é o primeiro a tocar a conexão ────────────────
		#
		# Na VPS com EasyPanel as portas 80/443 são do Traefik, e ele nos entrega
		# `*.{$APP_DOMAIN}` por um router TCP com `tls.passthrough` — bytes crus,
		# sem cabeçalho nenhum acrescentado. Sem PROXY protocol o Caddy enxergaria
		# o IP do container do Traefik em TODA requisição: o `X-Forwarded-For` que
		# ele monta viraria constante, e o rate limit do backend — que confia nele
		# por `trustProxy: true` — passaria a contar o mundo inteiro num balde só.
		# O sintoma seria um Portal que tranca sozinho sob carga normal.
		#
		# `allow` é o que impede que o próprio cabeçalho vire a mentira: só de uma
		# origem listada ele é lido. Medido contra o caddy:2: origem FORA da lista
		# sem cabeçalho passa normalmente, e origem DENTRO da lista sem cabeçalho
		# também — o wrapper não exige o PROXY, só o aceita. É por isso que esta
		# mesma configuração serve ao caminho do swarm, onde o Caddy está na porta
		# e ninguém envia cabeçalho algum: lá o padrão `127.0.0.1/32` não casa com
		# cliente nenhum e o IP real continua vindo do socket.
		#
		# O valor certo é a sub-rede da rede do Traefik:
		#   docker network inspect easypanel -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
		listener_wrappers {
			proxy_protocol {
				allow {$PROXY_PROTOCOL_ALLOW:127.0.0.1/32}
			}
			# O wrapper de TLS vem por último, sempre: ele desembrulha o que os
			# anteriores já entregaram em claro.
			tls
		}

		# HTTP/3 fica de fora porque o 443/UDP não atravessa um proxy de camada 4.
		# Anunciá-lo por Alt-Svc atrás do Traefik manda o navegador bater numa porta
		# que não leva a lugar nenhum, para depois cair de volta no TCP — custo sem
		# contrapartida. Na borda dedicada o que se perde é só o QUIC.
		protocols h1 h2
	}
}

{$APP_DOMAIN}, *.{$APP_DOMAIN} {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
		# Sem `resolvers` explícitos o desafio pode consultar um resolver que ainda
		# serve o registro TXT em cache e falhar por propagação.
		resolvers 1.1.1.1 8.8.8.8
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# O Caddy anuncia a si mesmo por padrão; não há razão para contar a versão.
		-Server
	}

	# MOD-SEC-09 — a política de conteúdo, em modo relatório.
	#
	# `Report-Only`, e não valendo: as três raízes do Next carregam script do
	# Clerk, fonte do Google e imagem de bucket, e uma CSP restritiva errada não
	# degrada — apaga a tela, e só no navegador do cliente. Uma semana de
	# relatório limpo é o que autoriza trocar o nome do cabeçalho.
	#
	# `'unsafe-inline'` em `script-src` é o Next: ele injeta o payload de
	# hidratação num `<script>` inline sem nonce. Removê-lo exige nonce por
	# requisição no middleware, que é frente própria — está na questão 3 do §11
	# do PRD.
	#
	# Fica FORA do bloco acima, com matcher de host, porque `api.` não tem
	# navegador: é quase 1 KB de instrução que ninguém lê, em cima de toda
	# resposta de API, em rede móvel. Apagá-la com `-Cabeçalho` dentro do
	# `handle @api` NÃO funciona — os dois `header` são diferidos, o global é
	# aplicado depois, e ele a repõe. Medido na resposta, não deduzido.
	@navegador not host api.{$APP_DOMAIN}
	header @navegador {
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.clerk.accounts.dev https://*.clerk.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.clerk.accounts.dev https://*.clerk.com; frame-src https://*.clerk.accounts.dev https://*.clerk.com https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
	}

	# As duas rotas que não são do Next, e a superfície pública inteira do backend: o
	# retorno de entrega do Resend (MOD-NOTIF-10) e a sincronização de usuário do Clerk
	# (MOD-IDENT-03). Os dois são serviços na internet — não alcançam a rede interna do
	# compose, e o callback deles precisa de um endereço de verdade.
	#
	# Valem só no domínio da aplicação, nunca nos subdomínios de tenant: o webhook é da
	# instalação, não de um petshop. O que os protege é inteiramente a assinatura Svix,
	# conferida sobre o corpo cru — e sem o segredo correspondente
	# (`RESEND_WEBHOOK_SECRET`, `CLERK_WEBHOOK_SECRET`) a rota recusa tudo.
	#
	# A terceira é a do Asaas (camada comercial, fatia 4), que não assina o corpo: ela se
	# autentica pelo token do header `asaas-access-token`, e sem `ASAAS_WEBHOOK_TOKEN`
	# recusa tudo do mesmo jeito.
	@webhooks {
		host {$APP_DOMAIN}
		path /internal/v1/email/webhook /internal/v1/clerk/webhook /internal/v1/asaas/webhook
	}
	handle @webhooks {
		reverse_proxy {$BACKEND_UPSTREAM:api-gateway:3000}
	}

	# ── A API do app do tutor ────────────────────────────────────────────────
	#
	# O app Flutter de `app/` é o outro cliente que nasce fora da rede interna, e
	# o que ele alcança aqui é o Portal e mais nada: dezessete caminhos, todos
	# sob `/portal/v1`, mais o catálogo de estabelecimentos da primeira tela.
	#
	# O catálogo mora sob `/public/` e é nomeado um a um de propósito — o prefixo
	# inteiro serve também ao site do tenant, cujo cliente é o servidor do Next,
	# e que por isso está FORA do balde de rate limit geral (`app.ts`). Abrir o
	# prefixo publicaria uma superfície sem teto; esta rota tem o teto por IP
	# dela, no módulo.
	#
	# O slug do petshop vai no header `x-petshop-tenant-slug`, e não no host,
	# porque um aparelho não tem host: um `api.` só atende todos os tenants. E
	# `api` está na lista de slugs reservados (`shared-types/identity.ts`), então
	# nenhum estabelecimento o reivindica.
	#
	# Isto é um matcher DENTRO deste bloco, e não um site próprio: `api.` é
	# subdomínio de APP_DOMAIN e o certificado é o wildcard que já está aqui. Um
	# site próprio pediria à Let's Encrypt uma emissão só para ele, sem ganho.
	@api {
		host api.{$APP_DOMAIN}
		path /portal/v1 /portal/v1/* /public/v1/portal/tenants
	}
	handle @api {
		reverse_proxy {$BACKEND_UPSTREAM:api-gateway:3000}
	}

	# Todo o resto de `api.` morre aqui, e não no Next. Sem este bloco um caminho
	# fora do recorte cairia no `handle` de baixo e voltaria como o 307 que o
	# Admin dá para quem chega por subdomínio reservado — e o app leria uma
	# redireção para uma tela de login como se fosse resposta da API.
	@apiOutros host api.{$APP_DOMAIN}
	handle @apiOutros {
		respond 404
	}

	handle {
		reverse_proxy {$FRONTEND_UPSTREAM:frontend:3002}
	}

	log {
		output stdout
		format json
	}
}

# ── A landing de venda ────────────────────────────────────────────────────────
#
# Host próprio, fora de `{$APP_DOMAIN}`: `lp.officestecnologia.com.br` não é
# subdomínio do domínio da aplicação, então o wildcard acima não o cobre e ele
# precisa do bloco — e do certificado — dele.
#
# Os arquivos vêm DENTRO da imagem (`infra/Dockerfile.caddy`), não de um bind
# mount: em `docker stack deploy` um bind relativo vira diretório vazio em
# silêncio. Enquanto a VPS era compartilhada quem servia isto era um nginx à
# parte, publicado pelo Traefik do EasyPanel; na máquina dedicada o Caddy é a
# borda e serve arquivo nativamente, o que apaga um container inteiro.
#
# O DNS-01 aqui não é capricho: é o mesmo token da Cloudflare, e um desafio que
# não depende de a porta 80 chegar limpa continua valendo se o registro um dia
# passar a proxiar pela Cloudflare (laranja), onde o HTTP-01 quebraria.
{$LANDING_DOMAIN:lp.officestecnologia.com.br} {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1 8.8.8.8
	}

	encode zstd gzip
	root * /srv/landing

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# O HTML é sempre revalidado, porque uma troca de preço no console precisa
	# aparecer no próximo acesso. CSS e JS não têm hash no nome, então uma hora com
	# revalidação — é o que o nginx do EasyPanel fazia, e vale o mesmo aqui.
	@estaticos path *.css *.js *.svg
	header @estaticos Cache-Control "public, max-age=3600, must-revalidate"
	header /index.html Cache-Control "no-cache"

	# Nada aqui fala com o backend: a página busca o preço em `/api/planos` do
	# Next, noutro host, e o HTML já traz o preço padrão como reserva.
	try_files {path} {path}/ /index.html
	file_server

	log {
		output stdout
		format json
	}
}
