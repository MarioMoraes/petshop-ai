# Borda do PetShop AI. O único processo com porta aberta para a internet.
#
# Duas decisões estão embutidas aqui:
#
# 1. O gateway NÃO é publicado. O cliente HTTP do frontend é `server-only` — o
#    browser nunca fala com a API — então o gateway atende só na rede interna do
#    compose. Isso apaga a superfície pública inteira da API e torna o CORS
#    desnecessário. Se um dia o MOD-PORTAL precisar de chamadas do browser, aí sim
#    se abre `api.{$APP_DOMAIN}` — e não antes. As duas exceções são os webhooks de
#    provedor abaixo, que nascem fora e não têm como entrar pela rede interna.
#
# 2. O wildcard existe porque o slug do tenant é subdomínio. Ele exige DNS-01, que
#    exige o módulo da Cloudflare (ver Dockerfile.caddy) e um token de API com
#    permissão de editar a zona.

{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN}, *.{$APP_DOMAIN} {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
		# Sem `resolvers` explícitos o desafio pode consultar um resolver que ainda
		# serve o registro TXT em cache e falhar por propagação.
		resolvers 1.1.1.1 8.8.8.8
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# O Caddy anuncia a si mesmo por padrão; não há razão para contar a versão.
		-Server

		# MOD-SEC-09 — a política de conteúdo, em modo relatório.
		#
		# `Report-Only`, e não valendo: as três raízes do Next carregam script do
		# Clerk, fonte do Google e imagem de bucket, e uma CSP restritiva errada não
		# degrada — apaga a tela, e só no navegador do cliente. Uma semana de
		# relatório limpo é o que autoriza trocar o nome do cabeçalho.
		#
		# `'unsafe-inline'` em `script-src` é o Next: ele injeta o payload de
		# hidratação num `<script>` inline sem nonce. Removê-lo exige nonce por
		# requisição no middleware, que é frente própria — está na questão 3 do §11
		# do PRD.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.clerk.accounts.dev https://*.clerk.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.clerk.accounts.dev https://*.clerk.com; frame-src https://*.clerk.accounts.dev https://*.clerk.com https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
	}

	# As duas rotas que não são do Next, e a superfície pública inteira do backend: o
	# retorno de entrega do Resend (MOD-NOTIF-10) e a sincronização de usuário do Clerk
	# (MOD-IDENT-03). Os dois são serviços na internet — não alcançam a rede interna do
	# compose, e o callback deles precisa de um endereço de verdade.
	#
	# Valem só no domínio da aplicação, nunca nos subdomínios de tenant: o webhook é da
	# instalação, não de um petshop. O que os protege é inteiramente a assinatura Svix,
	# conferida sobre o corpo cru — e sem o segredo correspondente
	# (`RESEND_WEBHOOK_SECRET`, `CLERK_WEBHOOK_SECRET`) a rota recusa tudo.
	@webhooks {
		host {$APP_DOMAIN}
		path /internal/v1/email/webhook /internal/v1/clerk/webhook
	}
	handle @webhooks {
		reverse_proxy api-gateway:3000
	}

	handle {
		reverse_proxy frontend:3002
	}

	log {
		output stdout
		format json
	}
}
