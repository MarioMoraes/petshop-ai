# syntax=docker/dockerfile:1.7
#
# Caddy com o módulo de DNS da Cloudflare.
#
# A imagem oficial não serve aqui: o slug do tenant é subdomínio (`petshop-x.dominio`,
# e o slug está impresso em QR code), então o certificado precisa ser wildcard — e
# wildcard só sai por desafio DNS-01, que exige um módulo de provedor compilado
# dentro do binário. A Cloudflare é a escolha porque a conta já existe: as fotos de
# pet vivem no R2 dela.
#
# Trocar de provedor de DNS = trocar este módulo e o bloco `dns` do Caddyfile.
FROM caddy:2-builder AS builder
RUN xcaddy build --with github.com/caddy-dns/cloudflare

FROM caddy:2
COPY --from=builder /usr/bin/caddy /usr/bin/caddy

# O Caddyfile vai DENTRO da imagem, e não como bind mount.
#
# Em `docker stack deploy` um bind mount de arquivo com caminho relativo não é
# resolvido, e o Docker responde criando um DIRETÓRIO vazio no lugar — o Caddy sobe
# sem configuração nenhuma, sem erro visível, e a borda responde 404 para tudo. O
# preço de assar o arquivo é ter de republicar a imagem para mudar a configuração
# da borda, o que acontece raramente.
#
# O compose de produção continua sobrepondo este arquivo com o bind mount da pasta
# `infra/`, que lá funciona: é o mesmo conteúdo, e editar sem rebuild ajuda em
# desenvolvimento.
#
# O contexto de build é a RAIZ do monorepo, e não `infra/`, por causa da linha
# seguinte.
COPY infra/Caddyfile /etc/caddy/Caddyfile

# A landing de venda, servida pela própria borda.
#
# Enquanto a VPS era compartilhada, ela era um nginx à parte com router próprio no
# Traefik do EasyPanel (`infra/docker-compose.landing.yml`), montando
# `frontend/landing-page` do checkout — publicar uma mudança era `git pull`. Na
# máquina dedicada não há Traefik nem rede `easypanel`, e o bind mount relativo é
# justamente o que o comentário acima proíbe: viraria um diretório vazio e o
# `lp.` responderia 404.
#
# São quatro arquivos estáticos e nenhum processo a mais: o Caddy já é a borda e
# serve arquivo nativamente. O custo é que mudar a landing passou a pedir uma
# imagem nova — o mesmo custo que o Caddyfile já tinha.
COPY frontend/landing-page /srv/landing
