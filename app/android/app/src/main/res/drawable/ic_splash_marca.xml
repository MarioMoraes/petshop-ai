<?xml version="1.0" encoding="utf-8"?>
<!--
  A marca do produto na janela de abertura do Android 12+.

  Do Android 12 em diante o sistema desenha um ícone por cima do `windowSplashScreen-
  Background`, e **o padrão dele é o ícone do lançador** — que aqui ainda é o do modelo
  do Flutter. Sem este arquivo, a sequência de abrir o app é: logo do Flutter, depois a
  pata se desenhando. Com ele, é a mesma pata nas duas metades.

  A geometria é a de `lib/src/ui/abertura.dart`, que por sua vez é a do
  `frontend/landing-page/favicon.svg`: a pastilha de 32 e o ícone de 24 deslocado por
  `translate(5 5) scale(.92)`. Os dois `group` aninhados existem justamente para que os
  números continuem sendo os do SVG.

  A tela é de 288dp porque é a que o sistema pede, e a pastilha ocupa 132 dela: o ícone
  precisa caber num círculo de 192dp, e a diagonal de um quadrado de 132 é 187.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">
    <group
        android:translateX="78"
        android:translateY="78"
        android:scaleX="4.125"
        android:scaleY="4.125">
        <path android:pathData="M10,0 H22 A10,10 0 0 1 32,10 V22 A10,10 0 0 1 22,32 H10 A10,10 0 0 1 0,22 V10 A10,10 0 0 1 10,0 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="16"
                    android:startY="0"
                    android:endX="16"
                    android:endY="32"
                    android:type="linear">
                    <item android:offset="0" android:color="#FFEE6A55" />
                    <item android:offset="0.7" android:color="#FFE34A32" />
                </gradient>
            </aapt:attr>
        </path>
        <group
            android:translateX="5"
            android:translateY="5"
            android:scaleX="0.92"
            android:scaleY="0.92">
            <path
                android:pathData="M9,4 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0"
                android:strokeColor="#FFFFFFFF"
                android:strokeWidth="1.9"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <path
                android:pathData="M16,8 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0"
                android:strokeColor="#FFFFFFFF"
                android:strokeWidth="1.9"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <path
                android:pathData="M18,16 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0"
                android:strokeColor="#FFFFFFFF"
                android:strokeWidth="1.9"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <path
                android:pathData="M9,10 a5,5 0 0 1 5,5 v3.5 a3.5,3.5 0 0 1 -6.84,1.045 Q6.52,17.48 4.46,16.84 A3.5,3.5 0 0 1 5.5,10 Z"
                android:strokeColor="#FFFFFFFF"
                android:strokeWidth="1.9"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
        </group>
    </group>
</vector>
