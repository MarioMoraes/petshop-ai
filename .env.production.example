# Variáveis do deploy de produção.
#
# Serve aos dois caminhos: `infra/docker-compose.prod.yml` (compose numa VPS) e
# `infra/docker-compose.swarm.yml` (Docker Swarm — ver docs/deploy-swarm.md).
#
#   cp .env.production.example .env.production
#
# Este arquivo NÃO é o `.env` de desenvolvimento e não substitui ele. Aqui não há
# DATABASE_URL nem porta de serviço: a composição monta as URLs a partir das senhas
# abaixo e fala por nome de container. O que sobra é o que só você sabe.
#
# `.env.production` está no .gitignore e não entra em nenhuma camada de imagem
# (ver .dockerignore). No servidor, deixe-o com permissão 600.

# ─── Domínio e TLS ────────────────────────────────────────────────────────────
# Sem o ponto inicial e sem esquema. O certificado cobre este domínio e *.ele,
# porque o slug de cada tenant é um subdomínio.
# Pode ser um subdomínio de um domínio que você já usa — o corte é pela primeira
# label, não pela contagem de pontos. Nesse caso, o registro wildcard precisa ficar
# em DNS-only na Cloudflare (ver infra/README.md).
APP_DOMAIN="petshop.officestecnologia.com.br"
# Para onde a Let's Encrypt avisa que o certificado vai expirar.
ACME_EMAIL="voce@officestecnologia.com.br"
# Token da Cloudflare com permissão Zone:DNS:Edit na zona acima — é o que assina o
# desafio DNS-01 do certificado wildcard. Crie um token restrito a essa zona, não
# use a Global API Key.
CLOUDFLARE_API_TOKEN=""

# ─── Senhas de infraestrutura ─────────────────────────────────────────────────
# Gere cada uma com:  openssl rand -base64 32 | tr -d '/+=' | head -c 40
# `app_user` e `app_maintenance` aceitam apenas [A-Za-z0-9._~-], no mínimo 16
# caracteres: elas entram num ALTER ROLE, que não aceita parâmetro ligado
# (packages/db/prisma/set-role-passwords.ts).
POSTGRES_PASSWORD=""
APP_USER_PASSWORD=""
APP_MAINTENANCE_PASSWORD=""
REDIS_PASSWORD=""
RABBITMQ_PASSWORD=""

# ─── Criptografia de PII ──────────────────────────────────────────────────────
# LEIA ANTES DE GERAR: a KEK é a raiz de tudo que é cifrado no banco. Perdê-la é
# perder o PII de todos os tenants, sem recuperação possível — backup do banco não
# ajuda, porque o que está lá é o texto cifrado. Guarde-a fora deste servidor
# antes do primeiro cliente real entrar.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEK=""
# Pepper do HMAC das colunas `*_hash` de busca. Trocar depois de haver dados
# invalida as buscas por CPF/telefone/e-mail: os hashes antigos não batem mais.
EMAIL_HASH_PEPPER=""

# ─── Comunicação interna ──────────────────────────────────────────────────────
# HMAC com que o gateway assina o contexto que envia aos serviços. Só circula na
# rede do compose, mas é o que impede um container comprometido de forjar tenant.
INTERNAL_SERVICE_SECRET=""

# ─── Clerk (ver docs/setup-clerk.md) ──────────────────────────────────────────
# Chaves da instância de PRODUÇÃO, não as de teste. O template de JWT `petshop`
# com o claim `permVersion` precisa existir também na instância de produção — o
# gateway compara esse claim, e sem ele toda sessão cai no caminho degradado.
CLERK_SECRET_KEY="sk_live_..."
# Esta é assada no bundle do browser em tempo de build (é o SDK React que exige).
# Trocá-la obriga a reconstruir a imagem do frontend, não só a reiniciar.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."

# ─── Storage de mídia (Cloudflare R2) ─────────────────────────────────────────
# Bucket de produção, separado do de desenvolvimento.
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="petshop-media"
R2_REGION="auto"

# ─── Convite de equipe por e-mail (MOD-IDENT-06) ──────────────────────────────
# Resend. Sem a chave o convite ainda funciona — o link volta na tela de Equipe,
# para o admin mandar pelo WhatsApp —, mas ninguém recebe e-mail.
# O domínio de `MAIL_FROM` precisa estar verificado no Resend (SPF + DKIM), senão
# o envio é recusado.
RESEND_API_KEY="re_CHANGE_ME"
# O retorno do provedor (MOD-NOTIF-10): bounce e reclamação de spam. Sai do painel do
# Resend, no formato `whsec_…`. **Sem ele a rota do webhook recusa tudo com 401** — e é
# deliberado: um webhook aberto é uma porta para suprimir o endereço de qualquer
# concorrente. O endpoint é `POST /internal/v1/email/webhook` no domínio da aplicação.
RESEND_WEBHOOK_SECRET="whsec_CHANGE_ME"
MAIL_FROM="PetShop AI <convites@petshop.officestecnologia.com.br>"
INVITATION_TTL_DAYS=7

# ─── Canal WhatsApp (MOD-CRM-01) ──────────────────────────────────────────────
# A Evolution API sobe como container na rede interna, sem porta publicada e sem
# rota no Caddy: ela manda mensagem pelo número da empresa, e só o
# o backend fala com ela. Esta chave é a senha da API dela — gere uma
# aleatória, como as senhas de role:
#   openssl rand -base64 32 | tr -d '/+=' | head -c 40
#
# Sem ela o canal fica indisponível e a cascata `AUTO` cai para o e-mail; nada
# quebra, mas nenhum petshop consegue parear o WhatsApp.
EVOLUTION_API_KEY="CHANGE_ME"

# ─── Ajustes de produto ───────────────────────────────────────────────────────
INACTIVITY_THRESHOLD_DAYS=90
VIACEP_BASE_URL="https://viacep.com.br/ws"
CEP_LOOKUP_TIMEOUT_MS=3000

# ─── Registry (só o deploy em Swarm usa) ──────────────────────────────────────
# Em Swarm o `build:` do compose é ignorado: as imagens vêm prontas do ghcr.io,
# publicadas do seu Mac por `scripts/publicar-imagens.sh`. Estas duas variáveis
# montam o nome — `scripts/atualizar-vps.sh` acrescenta a versão.
#
# Na VPS, autentique uma vez com um PAT clássico de escopo `read:packages`:
#   echo <PAT> | docker login ghcr.io -u <usuario> --password-stdin
REGISTRY="ghcr.io"
GHCR_NAMESPACE="mariomoraes"
# Nome da stack no swarm. Prefixa TODO serviço: `petshop_api-gateway`, etc.
STACK_NAME="petshop"

# ─── Operação ─────────────────────────────────────────────────────────────────
LOG_LEVEL="info"
# Só o compose usa esta linha; em Swarm quem manda é o argumento de
# `atualizar-vps.sh <versao>`. Use o SHA do commit ou a tag da release.
IMAGE_TAG="latest"

# MOD-CRM — relacionamento (módulo do backend; decidir e entregar no mesmo processo)
CRM_AUTOMATION_SERVICE_PORT=3009
