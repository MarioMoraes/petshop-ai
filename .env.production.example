# Variáveis do deploy de produção.
#
# Serve aos dois caminhos: `infra/docker-compose.prod.yml` (compose numa VPS) e
# `infra/docker-compose.swarm.yml` (Docker Swarm — ver docs/deploy-swarm.md).
#
#   cp .env.production.example .env.production
#
# Este arquivo NÃO é o `.env` de desenvolvimento e não substitui ele. Aqui não há
# DATABASE_URL nem porta de serviço: a composição monta as URLs a partir das senhas
# abaixo e fala por nome de container. O que sobra é o que só você sabe.
#
# `.env.production` está no .gitignore e não entra em nenhuma camada de imagem
# (ver .dockerignore). No servidor, deixe-o com permissão 600.

# ─── Domínio e TLS ────────────────────────────────────────────────────────────
# Sem o ponto inicial e sem esquema. O certificado cobre este domínio e *.ele,
# porque o slug de cada tenant é um subdomínio.
# Pode ser um subdomínio de um domínio que você já usa — o corte é pela primeira
# label, não pela contagem de pontos. Nesse caso, o registro wildcard precisa ficar
# em DNS-only na Cloudflare (ver infra/README.md).
APP_DOMAIN="petshop.officestecnologia.com.br"
# Para onde a Let's Encrypt avisa que o certificado vai expirar.
ACME_EMAIL="voce@officestecnologia.com.br"
# Token da Cloudflare com permissão Zone:DNS:Edit na zona acima — é o que assina o
# desafio DNS-01 do certificado wildcard. Crie um token restrito a essa zona, não
# use a Global API Key.
CLOUDFLARE_API_TOKEN=""

# ─── Senhas de infraestrutura ─────────────────────────────────────────────────
# Gere cada uma com:  openssl rand -base64 32 | tr -d '/+=' | head -c 40
# `app_user` e `app_maintenance` aceitam apenas [A-Za-z0-9._~-], no mínimo 16
# caracteres: elas entram num ALTER ROLE, que não aceita parâmetro ligado
# (packages/db/prisma/set-role-passwords.ts).
POSTGRES_PASSWORD=""
APP_USER_PASSWORD=""
APP_MAINTENANCE_PASSWORD=""
REDIS_PASSWORD=""
RABBITMQ_PASSWORD=""

# ─── Criptografia de PII ──────────────────────────────────────────────────────
# LEIA ANTES DE GERAR: a KEK é a raiz de tudo que é cifrado no banco. Perdê-la é
# perder o PII de todos os tenants, sem recuperação possível — backup do banco não
# ajuda, porque o que está lá é o texto cifrado. Guarde-a fora deste servidor
# antes do primeiro cliente real entrar.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEK=""
# Pepper do HMAC das colunas `*_hash` de busca. Trocar depois de haver dados
# invalida as buscas por CPF/telefone/e-mail: os hashes antigos não batem mais.
EMAIL_HASH_PEPPER=""

# ─── Comunicação interna ──────────────────────────────────────────────────────
# Mínimo 16 caracteres. Hoje ele não tem leitor: a porta interna assinada em HMAC
# saiu junto com o `proxy.ts` quando os doze serviços viraram um processo só. Continua
# exigido na subida porque nome que atravessa processo é identidade em infraestrutura
# — ver a nota sobre filas e chaves de cache no CLAUDE.md. Gere e esqueça.
INTERNAL_SERVICE_SECRET=""

# Segredo compartilhado entre o backend e o Next para invalidar a página em cache de
# um tenant quando o horário ou o catálogo mudam (AC-03 de MOD-SITE-11).
#
# **Os dois containers recebem esta MESMA variável.** Não protege dado nenhum — a
# página é pública —; protege custo, impedindo que qualquer um na rede interna force
# re-render de todos os sites em laço. Se as pontas divergirem, nada falha alto: o
# site do petshop simplesmente serve horário velho por até dez minutos.
SITE_REVALIDATE_SECRET=""

# ─── Clerk (ver docs/setup-clerk.md) ──────────────────────────────────────────
# Chaves da instância de PRODUÇÃO, não as de teste. O template de JWT `petshop`
# com o claim `permVersion` precisa existir também na instância de produção — o
# gateway compara esse claim, e sem ele toda sessão cai no caminho degradado.
CLERK_SECRET_KEY="sk_live_..."
# Esta é assada no bundle do browser em tempo de build (é o SDK React que exige).
# Trocá-la obriga a reconstruir a imagem do frontend, não só a reiniciar.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."
# Assinatura do webhook de sincronização de usuário (MOD-IDENT-03). Sai do painel do
# Clerk ao criar o endpoint, no formato `whsec_…`, e é DIFERENTE da CLERK_SECRET_KEY:
# um assina a entrega deles, o outro autentica a nossa chamada à API deles.
#
# Pode ficar em branco: sem ele a rota recusa tudo com 401, que é o comportamento
# certo de um endpoint sem segredo. O endpoint a cadastrar lá é
#   https://petshop.officestecnologia.com.br/internal/v1/clerk/webhook
CLERK_WEBHOOK_SECRET=""

# ─── Storage de mídia (Cloudflare R2) ─────────────────────────────────────────
# Bucket de produção, separado do de desenvolvimento.
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="petshop-media"
R2_REGION="auto"

# ─── Convite de equipe por e-mail (MOD-IDENT-06) ──────────────────────────────
# Resend. Sem a chave o convite ainda funciona — o link volta na tela de Equipe,
# para o admin mandar pelo WhatsApp —, mas ninguém recebe e-mail.
# O domínio de `MAIL_FROM` precisa estar verificado no Resend (SPF + DKIM), senão
# o envio é recusado.
RESEND_API_KEY="re_CHANGE_ME"
# O retorno do provedor (MOD-NOTIF-10): bounce e reclamação de spam. Sai do painel do
# Resend, no formato `whsec_…`. **Sem ele a rota do webhook recusa tudo com 401** — e é
# deliberado: um webhook aberto é uma porta para suprimir o endereço de qualquer
# concorrente. O endpoint é `POST /internal/v1/email/webhook` no domínio da aplicação.
RESEND_WEBHOOK_SECRET="whsec_CHANGE_ME"
MAIL_FROM="PetShop AI <convites@petshop.officestecnologia.com.br>"
INVITATION_TTL_DAYS=7

# ── Assinatura (Asaas) ────────────────────────────────────────────────────────
# Camada comercial, fatia 4. Sem ASAAS_API_KEY a tela de assinatura abre, mas não cobra
# (o POST responde 503). ASAAS_API_URL começa no SANDBOX de propósito: produção é
# https://api.asaas.com/v3, trocada junto com a chave de produção.
# ASAAS_WEBHOOK_TOKEN é o token cadastrado no painel do Asaas para o webhook
# `POST /internal/v1/asaas/webhook`; sem ele a rota recusa tudo com 401.
#
# ATENÇÃO: a chave do Asaas começa com `$` (`$aact_...`). Escreva com barra antes do
# cifrão — ASAAS_API_KEY="\$aact_..." —, senão o `$aact_...` é lido como referência a
# uma variável que não existe e a chave chega VAZIA (a tela diz "cobrança não
# configurada"). A forma com barra vale para o dotenv do `pnpm dev`, para o
# `docker compose` e para o `conferir-ambiente.sh`.
ASAAS_API_KEY=""
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
ASAAS_WEBHOOK_TOKEN=""
BILLING_GRACE_DAYS=7

# ─── Canal WhatsApp (MOD-CRM-01) ──────────────────────────────────────────────
# A Evolution API sobe como container na rede interna, sem porta publicada e sem
# rota no Caddy: ela manda mensagem pelo número da empresa, e só o
# o backend fala com ela. Esta chave é a senha da API dela — gere uma
# aleatória, como as senhas de role:
#   openssl rand -base64 32 | tr -d '/+=' | head -c 40
#
# Sem ela o canal fica indisponível e a cascata `AUTO` cai para o e-mail; nada
# quebra, mas nenhum petshop consegue parear o WhatsApp.
EVOLUTION_API_KEY="CHANGE_ME"

# ─── Agente de atendimento por IA (MOD-AI) ────────────────────────────────────
# `anthropic` é o alvo de produção; `gemini` existe para desenvolvimento, onde o free
# tier do AI Studio deixa exercitar o agente ponta a ponta sem conta paga. A escolha é
# de quem opera a instalação, não do estabelecimento.
AI_PROVIDER="anthropic"
# https://console.anthropic.com/settings/keys
#
# Pode ficar em branco, e a ausência é um estado legítimo: o agente se comporta como
# desligado e toda conversa vai para a recepção (AC-02 de MOD-AI-07). Mas repare no
# efeito colateral — a tela de configuração deixa LIGAR o atendimento automático, o
# interruptor fica aceso, e nenhuma mensagem de cliente é respondida.
ANTHROPIC_API_KEY=""
# Só com AI_PROVIDER="gemini". https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# ─── Console da plataforma (MOD-ADMIN) ────────────────────────────────────────
# O primeiro administrador de plataforma, e só enquanto NÃO houver nenhum: depois do
# primeiro, a concessão passa a ser pela tela, com trilha de auditoria. Trocar o valor
# aqui não promove ninguém.
#
# Precisa ser o e-mail de uma conta que já existe no Clerk desta instância. Deixando em
# branco, `/plataforma` fica inalcançável até alguém semear a tabela por `psql` — o que
# também é um estado correto, e deixa rastro no acesso ao banco.
PLATFORM_ADMIN_BOOTSTRAP_EMAIL=""
# Para quem vai o alarme operacional (MOD-ADMIN-06), separados por vírgula. Em branco,
# vai para os administradores de plataforma ativos — a lista que anda junto com a
# equipe, sem exigir deploy.
PLATFORM_ALERT_EMAILS=""
# Teto (não valor) do prazo que um estabelecimento pode conceder ao suporte.
SUPPORT_GRANT_MAX_HOURS=72

# ─── Ajustes de produto ───────────────────────────────────────────────────────
INACTIVITY_THRESHOLD_DAYS=90
VIACEP_BASE_URL="https://viacep.com.br/ws"
CEP_LOOKUP_TIMEOUT_MS=3000

# ─── EasyPanel: quando o Traefik dele já ocupa 80/443 ─────────────────────────
# Só para infra/docker-compose.easypanel.yml. Ignoradas pelos outros composes.
#
# A rede do Traefik do EasyPanel, e o entrypoint/certresolver dele. Os padrões
# valem para uma instalação normal; confira com `docker network ls | grep -i easypanel`.
TRAEFIK_NETWORK="easypanel"
TRAEFIK_ENTRYPOINT="https"
# O entrypoint de texto claro, só para o desvio 80 → 443: passthrough é de
# TLS, e em HTTP puro não há SNI para o Traefik casar.
TRAEFIK_HTTP_ENTRYPOINT="http"
TRAEFIK_CERTRESOLVER="letsencrypt"
# ─── A regra de host da borda ─────────────────────────────────────────────────
# Um REGEXP, e não uma lista de hosts, e a diferença é a razão de ele existir: o
# slug do estabelecimento é subdomínio e nasce quando um cliente se cadastra
# sozinho pelo wizard. Uma lista obrigaria alguém a editar este arquivo e
# redeployar antes que o site e o Portal do Tutor desse cliente respondessem —
# e, até lá, nada avisaria: seria um 404 com certificado inválido.
#
# Ele alimenta duas regras do Traefik no serviço `caddy`: o router TCP com
# `tls.passthrough` no 443 e o redirecionamento para HTTPS no 80. Casa o ápice
# (Admin), `app.` (Admin) e todo `{slug}.` (site do petshop + Portal do Tutor).
#
# Trocou o APP_DOMAIN? Troque aqui também — os pontos vão ESCAPADOS (`\.`), senão
# `.` casa qualquer caractere e a regra passa a aceitar host que não é seu.
#
# ASPAS SIMPLES, pela mesma razão de sempre: entre aspas duplas o bash de
# `conferir-ambiente.sh` e `atualizar-vps.sh` trataria a crase como substituição
# de comando, e escapá-la com `\` quebra para o `docker compose --env-file`.
PETSHOP_HOST_REGEXP='^([a-z0-9][a-z0-9-]*\.)?petshop\.officestecnologia\.com\.br$'

# De onde o Caddy aceita o cabeçalho PROXY que o Traefik envia — precisa ser a
# sub-rede da rede do Traefik. Errar não quebra de forma visível: só faz todo
# cliente chegar ao backend com o mesmo IP, e o rate limit do Portal contar o
# mundo inteiro num balde só. Confira com:
#   docker network inspect easypanel -f '{{range .IPAM.Config}}{{.Subnet}} {{end}}'
PROXY_PROTOCOL_ALLOW="10.0.0.0/8"

# ─── Registry (só o deploy em Swarm usa) ──────────────────────────────────────
# Em Swarm o `build:` do compose é ignorado: as imagens vêm prontas do ghcr.io,
# publicadas do seu Mac por `scripts/publicar-imagens.sh`. Estas duas variáveis
# montam o nome — `scripts/atualizar-vps.sh` acrescenta a versão.
#
# Na VPS, autentique uma vez com um PAT clássico de escopo `read:packages`:
#   echo <PAT> | docker login ghcr.io -u <usuario> --password-stdin
REGISTRY="ghcr.io"
GHCR_NAMESPACE="mariomoraes"
# Nome da stack no swarm. Prefixa TODO serviço: `petshop_api-gateway`, etc.
STACK_NAME="petshop"

# ─── Operação ─────────────────────────────────────────────────────────────────
LOG_LEVEL="info"
# Só o compose usa esta linha; em Swarm quem manda é o argumento de
# `atualizar-vps.sh <versao>`. Use o SHA do commit ou a tag da release.
IMAGE_TAG="latest"
