{
  "name": "petshop-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "pnpm --filter @petshop/db generate",
    "db:migrate": "pnpm --filter @petshop/db migrate",
    "db:seed": "pnpm --filter @petshop/db seed",
    "db:reset": "pnpm --filter @petshop/db reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "turbo": "^2.5.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  },
  "type": "module"
}
