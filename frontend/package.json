{
  "name": "@petshop/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../.env -- next dev --port 3002",
    "build": "NEXT_DIST_DIR=.next-build dotenv -e ../.env -- next build",
    "start": "NEXT_DIST_DIR=.next-build next start --port 3002",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.33.0",
    "@petshop/api-client": "workspace:*",
    "@petshop/shared-types": "workspace:*",
    "next": "^15.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.17",
    "@clerk/localizations": "^3.30.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@petshop/config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "dotenv-cli": "^8.0.0",
    "tailwindcss": "^4.1.12",
    "eslint-config-next": "^15.5.0",
    "@eslint/eslintrc": "^3.3.1"
  }
}
